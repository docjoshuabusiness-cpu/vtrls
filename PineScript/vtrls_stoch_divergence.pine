//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  VTRLS • Stochastic / Price Divergence Scanner
//  - Divergenze regolari prezzo vs stocastico, multi-periodo + filtro HTF
//  - Classe A (alta prob.): confermata dalla STRUTTURA dei pivot dello stoch
//  - Classe B (bassa prob.): confermata solo dal VALORE stoch sui pivot prezzo
//  - Nessun repaint: il segnale esce N barre dopo il pivot (Pivot right)
//  - Tracker di esito integrato: MFE/MAE in ATR, hit-rate per configurazione
// ═══════════════════════════════════════════════════════════════════════════
indicator("VTRLS • Stoch Divergence Scanner", "VTRLS Div", overlay = true,
     max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────── 1 • STOCASTICO ───────────────────────────
gS = "1 • Stocastico (multi-periodo)"
usePivD = input.bool(true, "Rileva i pivot su %D (smussato)", group = gS,
     tooltip = "Su TF a secondi %K è rumorosissimo. %D riduce i pivot spuri.")

e1 = input.bool(true,  "Cfg1", inline = "c1", group = gS)
k1 = input.int(14, "%K", inline = "c1", minval = 1, group = gS)
m1 = input.int(3,  "sm", inline = "c1", minval = 1, group = gS)
d1 = input.int(3,  "%D", inline = "c1", minval = 1, group = gS)

e2 = input.bool(true,  "Cfg2", inline = "c2", group = gS)
k2 = input.int(21, "%K", inline = "c2", minval = 1, group = gS)
m2 = input.int(5,  "sm", inline = "c2", minval = 1, group = gS)
d2 = input.int(5,  "%D", inline = "c2", minval = 1, group = gS)

e3 = input.bool(false, "Cfg3", inline = "c3", group = gS)
k3 = input.int(40, "%K", inline = "c3", minval = 1, group = gS)
m3 = input.int(5,  "sm", inline = "c3", minval = 1, group = gS)
d3 = input.int(8,  "%D", inline = "c3", minval = 1, group = gS)

// ─────────────────────── 2 • PIVOT & CONFERMA ─────────────────────────
gP = "2 • Pivot & conferma (ritardo)"
pvL    = input.int(5, "Pivot left",  minval = 1, group = gP)
pvR    = input.int(3, "Pivot right = barre di ritardo/conferma", minval = 1, group = gP,
     tooltip = "Il segnale viene emesso pvR barre DOPO il pivot. Alzalo per meno falsi, piu ritardo.")
minGap = input.int(5,  "Min barre tra i due pivot", minval = 2, group = gP)
maxGap = input.int(60, "Max barre tra i due pivot", minval = 3, group = gP)

// ───────────────────────────── 3 • FILTRI ─────────────────────────────
gF = "3 • Filtri qualita"
useZone   = input.bool(true, "Richiedi zona OS/OB", group = gF)
osLvl     = input.float(25, "Oversold  <", group = gF)
obLvl     = input.float(75, "Overbought >", group = gF)
minSDelta = input.float(2.0, "Delta minimo stocastico (punti)", minval = 0, group = gF)
atrLen    = input.int(14, "ATR length", minval = 1, group = gF)
minPDelta = input.float(0.15, "Spostamento minimo prezzo tra i pivot (x ATR)", minval = 0, group = gF)
useSess   = input.bool(false, "Filtro sessione", inline = "ss", group = gF)
sess      = input.session("0930-1600", "", inline = "ss", group = gF)
alignTol  = input.int(10, "Tolleranza allineamento pivot stoch/prezzo (barre)", minval = 1, group = gF,
     tooltip = "Quanto lontano puo stare il pivot dello stocastico dal pivot di prezzo per contare come conferma STRUTTURALE (classe A).")
cooldown  = input.int(20, "Cooldown: min barre tra due segnali stessa direzione", minval = 0, group = gF,
     tooltip = "Impedisce cluster di segnali correlati che gonfiano N e falsano le statistiche.")

// ─────────────────────── 4 • HIGHER TIMEFRAME ─────────────────────────
gH = "4 • Conferma Higher Timeframe"
useHTF = input.bool(false, "Attiva conferma HTF", group = gH)
htfTF  = input.timeframe("1", "Timeframe superiore", group = gH)

// ─────────────────────── 5 • TRACKER DI ESITO ─────────────────────────
gT = "5 • Tracker di esito (edge measurement)"
trackOn  = input.bool(true, "Attiva tracker", group = gT)
horizon  = input.int(60, "Orizzonte massimo (barre)", minval = 5, group = gT)
targATR  = input.float(1.0, "Target (x ATR)", minval = 0.1, group = gT)
stopATR  = input.float(0.7, "Stop (x ATR)",   minval = 0.1, group = gT)
showTab  = input.bool(true, "Mostra tabella statistiche", group = gT)
baseOn   = input.bool(true, "Benchmark nullo (ingressi ciclici)", group = gT,
     tooltip = "Entra long e short ogni N barre senza logica. E' il livello di riferimento: se le divergenze non lo battono, non hanno edge.")
baseN    = input.int(50, "Benchmark: una coppia ogni N barre", minval = 5, group = gT)

// ───────────────────────────── 6 • GRAFICA ────────────────────────────
gG = "6 • Grafica"
colA_B = input.color(color.new(#00c853, 0),  "Buy  classe A", inline = "g1", group = gG)
colB_B = input.color(color.new(#ffd600, 0),  "Buy  classe B", inline = "g1", group = gG)
colA_S = input.color(color.new(#d50000, 0),  "Sell classe A", inline = "g2", group = gG)
colB_S = input.color(color.new(#ff9100, 0),  "Sell classe B", inline = "g2", group = gG)
drawLines = input.bool(true, "Disegna linee di divergenza", group = gG)
lblSize   = input.string("tiny", "Dimensione label", options = ["tiny","small","normal"], group = gG)

// ═══════════════════════════ CALCOLI BASE ═════════════════════════════
atr    = ta.atr(atrLen)
inSess = not useSess or not na(time(timeframe.period, sess))
szLbl  = lblSize == "tiny" ? size.tiny : lblSize == "small" ? size.small : size.normal

htfK   = request.security(syminfo.tickerid, htfTF,
             ta.sma(ta.stoch(close, high, low, k1), m1), lookahead = barmerge.lookahead_off)
htfUp  = htfK > htfK[1]
htfDn  = htfK < htfK[1]

// ═══════════════════════ STATO TRACKER (globale) ══════════════════════
var array<int>   pDir  = array.new<int>()
var array<int>   pBkt  = array.new<int>()
var array<int>   pBar  = array.new<int>()
var array<float> pEnt  = array.new<float>()
var array<float> pAtr  = array.new<float>()
var array<float> pMfe  = array.new<float>()
var array<float> pMae  = array.new<float>()

var array<float> stTot = array.new<float>(14, 0)
var array<float> stWin = array.new<float>(14, 0)
var array<float> stMfe = array.new<float>(14, 0)
var array<float> stMae = array.new<float>(14, 0)

// ── valore del pivot stocastico piu vicino a una barra target (na se nessuno)
f_near(array<float> vals, array<int> bars, int tgt, int tol) =>
    float best = na
    int   bd   = 1000000
    if array.size(bars) > 0 and not na(tgt)
        for i = 0 to array.size(bars) - 1
            d = math.abs(array.get(bars, i) - tgt)
            if d <= tol and d < bd
                bd   := d
                best := array.get(vals, i)
    best

// ── registra un segnale nel tracker
f_track(int dir, int bkt) =>
    if trackOn and atr > 0
        array.push(pDir, dir)
        array.push(pBkt, bkt)
        array.push(pBar, bar_index)
        array.push(pEnt, close)
        array.push(pAtr, atr)
        array.push(pMfe, 0.0)
        array.push(pMae, 0.0)

// ═══════════════════════════ SCANNER ══════════════════════════════════
// Ritorna [buyA, buyB, sellA, sellB] per la configurazione data.
f_scan(bool en, int lk, int sm, int ld, int cfg, string tag) =>
    kv = ta.sma(ta.stoch(close, high, low, lk), sm)
    dv = ta.sma(kv, ld)
    st = usePivD ? dv : kv

    // pivot di prezzo e pivot dello stocastico (stessa geometria)
    pl = ta.pivotlow(low,   pvL, pvR)
    ph = ta.pivothigh(high, pvL, pvR)
    sl = ta.pivotlow(st,    pvL, pvR)
    sh = ta.pivothigh(st,   pvL, pvR)

    // memoria pivot di prezzo (min)
    var float lP0 = na
    var float lP1 = na
    var float lS0 = na
    var float lS1 = na
    var int   lB0 = na
    var int   lB1 = na
    // memoria pivot di prezzo (max)
    var float hP0 = na
    var float hP1 = na
    var float hS0 = na
    var float hS1 = na
    var int   hB0 = na
    var int   hB1 = na
    // storico dei pivot propri dello stocastico (per allineamento tollerante)
    var array<float> zLv = array.new<float>()
    var array<int>   zLb = array.new<int>()
    var array<float> zHv = array.new<float>()
    var array<int>   zHb = array.new<int>()
    var int lastBuyBar  = na
    var int lastSellBar = na

    if not na(sl)
        array.push(zLv, sl)
        array.push(zLb, bar_index - pvR)
        if array.size(zLv) > 30
            array.shift(zLv)
            array.shift(zLb)
    if not na(sh)
        array.push(zHv, sh)
        array.push(zHb, bar_index - pvR)
        if array.size(zHv) > 30
            array.shift(zHv)
            array.shift(zHb)

    bool buyA  = false
    bool buyB  = false
    bool sellA = false
    bool sellB = false

    // ── BULLISH: prezzo LL, stocastico HL
    if not na(pl)
        lP1 := lP0
        lS1 := lS0
        lB1 := lB0
        lP0 := pl
        lS0 := st[pvR]
        lB0 := bar_index - pvR
        gap = nz(lB0 - lB1, 0)
        base = not na(lP1) and gap >= minGap and gap <= maxGap
             and lP0 < lP1 - minPDelta * atr
             and lS0 > lS1 + minSDelta
             and (not useZone or math.min(lS0, lS1) < osLvl)
             and inSess and (not useHTF or htfUp)
        // struttura: pivot dello stocastico allineati ai pivot di prezzo, in salita
        v0 = f_near(zLv, zLb, lB0, alignTol)
        v1 = f_near(zLv, zLb, lB1, alignTol)
        struc = not na(v0) and not na(v1) and v0 > v1 + minSDelta
        cool  = na(lastBuyBar) or bar_index - lastBuyBar >= cooldown
        if base and en and cool
            buyA := struc
            buyB := not struc
            lastBuyBar := bar_index

    // ── BEARISH: prezzo HH, stocastico LH
    if not na(ph)
        hP1 := hP0
        hS1 := hS0
        hB1 := hB0
        hP0 := ph
        hS0 := st[pvR]
        hB0 := bar_index - pvR
        gap = nz(hB0 - hB1, 0)
        base = not na(hP1) and gap >= minGap and gap <= maxGap
             and hP0 > hP1 + minPDelta * atr
             and hS0 < hS1 - minSDelta
             and (not useZone or math.max(hS0, hS1) > obLvl)
             and inSess and (not useHTF or htfDn)
        v0 = f_near(zHv, zHb, hB0, alignTol)
        v1 = f_near(zHv, zHb, hB1, alignTol)
        struc = not na(v0) and not na(v1) and v0 < v1 - minSDelta
        cool  = na(lastSellBar) or bar_index - lastSellBar >= cooldown
        if base and en and cool
            sellA := struc
            sellB := not struc
            lastSellBar := bar_index

    // ── disegno
    if buyA or buyB
        c = buyA ? colA_B : colB_B
        if drawLines
            line.new(lB1, lP1, lB0, lP0, xloc.bar_index, color = c, width = buyA ? 2 : 1,
                 style = buyA ? line.style_solid : line.style_dotted)
        label.new(bar_index, low, (buyA ? "▲A " : "▲B ") + tag, xloc.bar_index,
             yloc.belowbar, c, label.style_label_up, color.black, szLbl)
    if sellA or sellB
        c = sellA ? colA_S : colB_S
        if drawLines
            line.new(hB1, hP1, hB0, hP0, xloc.bar_index, color = c, width = sellA ? 2 : 1,
                 style = sellA ? line.style_solid : line.style_dotted)
        label.new(bar_index, high, (sellA ? "▼A " : "▼B ") + tag, xloc.bar_index,
             yloc.abovebar, c, label.style_label_down, color.white, szLbl)

    // ── registrazione nel tracker
    if buyA or buyB
        f_track(1, cfg * 4 + (buyA ? 0 : 1))
    if sellA or sellB
        f_track(-1, cfg * 4 + (sellA ? 2 : 3))

    [buyA, buyB, sellA, sellB]

[bA1, bB1, sA1, sB1] = f_scan(e1, k1, m1, d1, 0, "C1")
[bA2, bB2, sA2, sB2] = f_scan(e2, k2, m2, d2, 1, "C2")
[bA3, bB3, sA3, sB3] = f_scan(e3, k3, m3, d3, 2, "C3")

buyHi  = bA1 or bA2 or bA3
buyLo  = bB1 or bB2 or bB3
sellHi = sA1 or sA2 or sA3
sellLo = sB1 or sB2 or sB3

// ─────────────────── BENCHMARK NULLO (livello di riferimento) ─────────
if baseOn and bar_index % baseN == 0 and inSess
    f_track(1, 12)
    f_track(-1, 13)

// ═════════════════════ RISOLUZIONE ESITI (MFE/MAE) ════════════════════
if trackOn and array.size(pDir) > 0
    for i = array.size(pDir) - 1 to 0
        ent = array.get(pEnt, i)
        a   = array.get(pAtr, i)
        dir = array.get(pDir, i)
        mfe = math.max(array.get(pMfe, i), (dir == 1 ? high - ent : ent - low)  / a)
        mae = math.min(array.get(pMae, i), (dir == 1 ? low  - ent : ent - high) / a)
        array.set(pMfe, i, mfe)
        array.set(pMae, i, mae)
        age  = bar_index - array.get(pBar, i)
        done = false
        win  = false
        if mae <= -stopATR
            done := true
        else if mfe >= targATR
            done := true
            win  := true
        else if age >= horizon
            done := true
        if done
            b = array.get(pBkt, i)
            array.set(stTot, b, array.get(stTot, b) + 1)
            array.set(stWin, b, array.get(stWin, b) + (win ? 1 : 0))
            array.set(stMfe, b, array.get(stMfe, b) + mfe)
            array.set(stMae, b, array.get(stMae, b) + mae)
            array.remove(pDir, i)
            array.remove(pBkt, i)
            array.remove(pBar, i)
            array.remove(pEnt, i)
            array.remove(pAtr, i)
            array.remove(pMfe, i)
            array.remove(pMae, i)

// ═══════════════════════════ TABELLA ══════════════════════════════════
var table tb = table.new(position.top_right, 5, 16, border_width = 1)
if showTab and barstate.islast
    hb = color.new(color.gray, 20)
    table.cell(tb, 0, 0, "Setup",  text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 1, 0, "N",      text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 2, 0, "Win%",   text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 3, 0, "MFE",    text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 4, 0, "MAE",    text_color = color.white, bgcolor = hb, text_size = size.tiny)
    breakeven = stopATR / (targATR + stopATR) * 100
    for b = 0 to 13
        cfg  = int(b / 4)
        kind = b % 4
        nm   = b == 12 ? "NULL Buy" : b == 13 ? "NULL Sell" :
             "C" + str.tostring(cfg + 1) + (kind == 0 ? " Buy A" : kind == 1 ? " Buy B" : kind == 2 ? " Sell A" : " Sell B")
        n    = array.get(stTot, b)
        w    = n > 0 ? array.get(stWin, b) / n * 100 : na
        mf   = n > 0 ? array.get(stMfe, b) / n : na
        ma   = n > 0 ? array.get(stMae, b) / n : na
        cc   = b >= 12 ? color.gray : kind == 0 ? colA_B : kind == 1 ? colB_B : kind == 2 ? colA_S : colB_S
        wc   = na(w) ? color.white : w >= breakeven ? color.lime : color.red
        table.cell(tb, 0, b + 1, nm, text_color = cc, text_size = size.tiny)
        table.cell(tb, 1, b + 1, str.tostring(n, "#"), text_color = color.white, text_size = size.tiny)
        table.cell(tb, 2, b + 1, na(w)  ? "-" : str.tostring(w,  "#.0"), text_color = wc, text_size = size.tiny)
        table.cell(tb, 3, b + 1, na(mf) ? "-" : str.tostring(mf, "#.00"), text_color = color.white, text_size = size.tiny)
        table.cell(tb, 4, b + 1, na(ma) ? "-" : str.tostring(ma, "#.00"), text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 15, "BE " + str.tostring(breakeven, "#.0") + "% | aperti " + str.tostring(array.size(pDir)), text_color = color.gray, text_size = size.tiny)

// ═══════════════════════════ ALERT ════════════════════════════════════
alertcondition(buyHi,  "Divergenza BUY  classe A", "VTRLS: divergenza rialzista ALTA probabilita")
alertcondition(buyLo,  "Divergenza BUY  classe B", "VTRLS: divergenza rialzista BASSA probabilita")
alertcondition(sellHi, "Divergenza SELL classe A", "VTRLS: divergenza ribassista ALTA probabilita")
alertcondition(sellLo, "Divergenza SELL classe B", "VTRLS: divergenza ribassista BASSA probabilita")

if buyHi or buyLo or sellHi or sellLo
    dirTxt = (buyHi or buyLo) ? "BUY" : "SELL"
    clsTxt = (buyHi or sellHi) ? "A (alta prob.)" : "B (bassa prob.)"
    alert("VTRLS Div " + dirTxt + " " + clsTxt + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
