//@version=6
// =============================================================================
//  MTF Z-Score Confluence  v1.0
//  ---------------------------------------------------------------------------
//  5 sezioni (timeframe) attivabili singolarmente. Ognuna calcola uno z-score
//  nel proprio TF. Il segnale nasce quando TUTTI i TF attivi hanno superato una
//  soglia (armamento) entro una finestra di N barre del grafico, e il TF PIU'
//  VELOCE attivo rientra attraverso il livello di trigger.
//
//  4 soglie indipendenti (+2 / +1 / -1 / -2), ciascuna con proprio ON/OFF,
//  proprio valore e proprio livello di trigger -> 4 stream di segnali distinti,
//  confrontabili a video per capire quale ha edge.
//
//  TRE BASI DI CALCOLO DELLO Z-SCORE (input zBasis):
//    A - TF nativo ............ ogni sezione usa le candele del proprio TF.
//                               Periodo di storia diverso per ogni sezione.
//    B - Barre grafico (HTF) .. tutte le sezioni usano lo stesso numero di
//                               barre del grafico. I TF alti hanno pochi dati
//                               reali e non raggiungono z-score alti.
//    C - Orizzonte equivalente  stesso periodo di storia del modo A, ma
//                               calcolato sulle candele del grafico. Piu' dati,
//                               nessun ritardo, nessun repaint. Consigliato.
//
//  Lo script vive in un PANNELLO separato (curve z, soglie, trigger) ma spinge i
//  MARKER sul grafico dei prezzi con force_overlay. Un solo script, due viste.
//
//  NOTE OPERATIVE (leggere):
//  - Mettere il grafico sul TF PIU' PICCOLO che si vuole osservare. Tutti i TF
//    delle sezioni devono essere >= al TF del grafico, altrimenti request.security
//    restituisce l'ultimo valore intrabar => REPAINT. Il pannello avvisa.
//  - I TF a secondi (15S/30S) richiedono un piano TradingView con dati a secondi
//    e hanno storico molto limitato: il backtest visivo sara' corto.
//  - Gli z-score multi-TF sullo stesso prezzo sono FORTEMENTE collineari: la
//    "conferma di 5 TF" contiene molta meno informazione indipendente di quanto
//    sembri. Usare "Log Return" come sorgente riduce (non elimina) il problema.
// =============================================================================

indicator("MTF Z-Score Confluence", shorttitle="MTF-Z", overlay=false, max_bars_back=500)

// ----------------------------------------------------------------- MOTORE Z --
var string gZ = "1 · Motore Z-Score"
srcMode   = input.string("Close", "Sorgente", options=["Close","HLC3","Log Return"], group=gZ,
     tooltip="Log Return = z-score sui rendimenti: serie stazionaria, meno collineare tra TF. Close = z-score classico prezzo vs media.")
maMode    = input.string("SMA", "Base (media)", options=["SMA","EMA"], group=gZ)
robust    = input.bool(false, "Stimatore robusto (mediana / MAD)", group=gZ,
     tooltip="z = 0.6745*(x-mediana)/MAD. Immune agli outlier che gonfiano la stdev e sopprimono lo z proprio quando serve.")
confirmed = input.bool(true, "Solo barre HTF chiuse (no repaint)", group=gZ,
     tooltip="Applica shift di 1 barra SOLO ai TF superiori a quello del grafico. Il TF del grafico non viene ritardato.")
zBasis    = input.string("A · TF nativo", "Base di calcolo dello z-score",
     options=["A · TF nativo","B · Barre grafico (serie HTF)","C · Barre grafico (orizzonte equivalente)"], group=gZ,
     tooltip="Come viene calcolato lo z-score di ogni sezione.\n\nA · TF NATIVO\nOgni sezione usa le candele del PROPRIO timeframe. Con len=100: la sezione 15S guarda 25 minuti di storia, la sezione 5m ne guarda 500. Ogni sezione osserva un periodo diverso.\n\nB · BARRE GRAFICO (serie HTF)\nTutte le sezioni usano lo stesso numero di barre DEL GRAFICO, quindi lo stesso periodo di storia. Ma i timeframe alti ripetono lo stesso valore per k barre: hanno pochi dati reali e non riescono a raggiungere z-score alti. Verifica sempre la colonna n·cap della tabella.\n\nC · BARRE GRAFICO (orizzonte equivalente)\nStesso periodo di storia del modo A, ma calcolato sulle candele del grafico. Molti più dati, nessun ritardo, nessun repaint. E' la scelta consigliata.\n\nk = timeframe della sezione / timeframe del grafico.")

// ---------------------------------------------------------- SEZIONI / TF -----
var string gT = "2 · Sezioni (timeframe)"
use1 = input.bool(true,  "S1", inline="s1", group=gT)
tf1  = input.timeframe("15S", "", inline="s1", group=gT)
len1 = input.int(100, "len", minval=5, maxval=5000, inline="s1", group=gT)

use2 = input.bool(true,  "S2", inline="s2", group=gT)
tf2  = input.timeframe("30S", "", inline="s2", group=gT)
len2 = input.int(100, "len", minval=5, maxval=5000, inline="s2", group=gT)

use3 = input.bool(true,  "S3", inline="s3", group=gT)
tf3  = input.timeframe("1", "", inline="s3", group=gT)
len3 = input.int(100, "len", minval=5, maxval=5000, inline="s3", group=gT)

use4 = input.bool(true,  "S4", inline="s4", group=gT)
tf4  = input.timeframe("2", "", inline="s4", group=gT)
len4 = input.int(100, "len", minval=5, maxval=5000, inline="s4", group=gT)

use5 = input.bool(true,  "S5", inline="s5", group=gT)
tf5  = input.timeframe("5", "", inline="s5", group=gT)
len5 = input.int(100, "len", minval=5, maxval=5000, inline="s5", group=gT)

// ------------------------------------------------------------- LOGICA SEGNALE
var string gS = "3 · Logica segnale"
lookback = input.int(10, "Finestra di confluenza (barre del grafico)", minval=1, maxval=500, group=gS,
     tooltip="Tutti i TF attivi devono aver superato la soglia almeno una volta entro queste N barre del grafico.\n\nREGOLA DI TARATURA: la finestra deve contenere almeno 2 barre della sezione piu LENTA, altrimenti quella sezione e praticamente ferma e dovrebbe trovarsi gia in soglia nell istante esatto in cui ci arriva la piu veloce.\n  minimo consigliato = 2 * (TF piu lento / TF del grafico)\n  esempio: grafico 5s, sezione piu lenta 5m -> 2 * (300/5) = 120 barre.\nCon valori troppo bassi la confluenza non si arma MAI: controlla il contatore armate in fondo alla dashboard.")
autoLb   = input.bool(true, "Finestra automatica (2 barre della sezione piu' lenta)", group=gS,
     tooltip="Calcola la finestra minima da solo: 2 * (TF piu' lento attivo / TF del grafico), e usa il valore maggiore fra questo e quello impostato sopra. Evita l'errore piu' comune, cioe' una finestra in cui le sezioni lente sono di fatto immobili e non possono mai allinearsi alle veloci.")
fastNow  = input.bool(true, "Trigger immediato sul TF veloce (niente attesa di chiusura)", group=gS,
     tooltip="La sezione PIU' VELOCE non subisce lo shift anti-repaint, quindi il rientro sotto il livello di trigger viene rilevato sulla barra del grafico in cui avviene davvero, non alla chiusura della sua candela.\n\nCosto: sulla barra in corso il segnale puo' comparire e sparire finche' la barra del grafico non chiude. Le barre storiche non sono toccate.\n\nSpento, su grafico 5s con sezione veloce 15S, il segnale arriva fino a 3 barre in ritardo.")
trigMode = input.string("Rientro (reversione)", "Modalita' trigger",
     options=["Rientro (reversione)","Primo tocco della soglia"], group=gS,
     tooltip="Rientro: il TF piu' veloce riattraversa il livello di trigger tornando verso lo zero (setup di esaurimento). Primo tocco: il TF piu' veloce buca la soglia (setup di continuazione/momentum).")
cooldown = input.int(5, "Cooldown fra segnali (barre)", minval=0, maxval=500, group=gS)

var string gL = "4 · Soglie (stream indipendenti)"
enP2  = input.bool(true,  "Soglia A", inline="a", group=gL)
thrP2 = input.float(2.0,  "liv", step=0.1, inline="a", group=gL)
trgP2 = input.float(1.0,  "trigger", step=0.1, inline="a", group=gL)

enP1  = input.bool(false, "Soglia B", inline="b", group=gL)
thrP1 = input.float(1.0,  "liv", step=0.1, inline="b", group=gL)
trgP1 = input.float(0.0,  "trigger", step=0.1, inline="b", group=gL)

enM1  = input.bool(false, "Soglia C", inline="c", group=gL)
thrM1 = input.float(-1.0, "liv", step=0.1, inline="c", group=gL)
trgM1 = input.float(0.0,  "trigger", step=0.1, inline="c", group=gL)

enM2  = input.bool(true,  "Soglia D", inline="d", group=gL)
thrM2 = input.float(-2.0, "liv", step=0.1, inline="d", group=gL)
trgM2 = input.float(-1.0, "trigger", step=0.1, inline="d", group=gL)

// ------------------------------------------------------------------- GRAFICA -
var string gV = "5 · Grafica"
marker   = input.string("Freccia", "Marker segnale", options=["Freccia","Pallino"], group=gV)
showZ    = input.bool(true,  "Curve z-score nel pannello", group=gV)
showLv   = input.bool(true,  "Linee di soglia e di trigger nel pannello", group=gV)
showArmBg= input.bool(true,  "Sfondo colorato quando un setup e' armato", group=gV)
showTab  = input.bool(true,  "Mostra cruscotto", group=gV)
dashSz   = input.string("Piccolo", "Dimensione testo cruscotto", options=["Minimo","Piccolo","Normale","Grande"], group=gV)
tagSz    = input.string("Piccolo", "Dimensione etichette periodo", options=["Minimo","Piccolo","Normale","Grande"], group=gV)
cz1      = input.color(color.new(#42a5f5, 0), "S1", inline="zc1", group=gV)
cz2      = input.color(color.new(#7e57c2, 0), "S2", inline="zc1", group=gV)
cz3      = input.color(color.new(#ffa726, 0), "S3", inline="zc1", group=gV)
cz4      = input.color(color.new(#ec407a, 0), "S4", inline="zc2", group=gV)
cz5      = input.color(color.new(#bdbdbd, 0), "S5", inline="zc2", group=gV)
czF      = input.color(color.new(#ffffff, 25), "TF veloce", inline="zc2", group=gV)
cLvlS    = input.color(color.new(#000000,  0), "Colore linee soglia",  inline="lv", group=gV)
cLvlT    = input.color(color.new(#000000, 45), "trigger",              inline="lv", group=gV)
cLvl0    = input.color(color.new(#000000, 55), "zero",                 inline="lv", group=gV)
markWhere= input.string("Pannello", "Posizione marker", options=["Pannello","Grafico prezzi","Entrambi"], group=gV,
     tooltip="Pannello: i marker stanno nel pannello dello z-score, come negli indicatori di riferimento. Restano comunque ancorati alla barra del grafico in cui il TF piu\' veloce ha attraversato il livello di trigger.")
markLvl  = input.float(2.8, "   livello marker nel pannello (z)", step=0.1, minval=0.5, group=gV)
showTags = input.bool(true, "Etichette del periodo a destra delle curve", group=gV,
     tooltip="Scrive il timeframe di ogni sezione in fondo alla sua curva, nel pannello. Serve a non dover ricordare a memoria quale colore corrisponde a quale periodo.")
tagOff   = input.int(4, "   distanza (barre)", minval=1, maxval=50, group=gV)
cUp      = input.color(color.new(#ef5350, 0), "Colore SELL", inline="col", group=gV)
cDn      = input.color(color.new(#26a69a, 0), "Colore BUY",  inline="col", group=gV)

// =============================================================== CALCOLO Z ====
// Tre basi di calcolo, selezionabili con zBasis. Cambiano la STATISTICA, non
// solo l'implementazione: leggere il tooltip di zBasis prima di scegliere.
// -----------------------------------------------------------------------------

// Sorgente nel contesto corrente (grafico oppure HTF dentro request.security).
f_src() =>
    srcMode == "Close" ? close : srcMode == "HLC3" ? hlc3 : math.log(close / nz(close[1], close))

// Z-score di una serie qualsiasi nel contesto corrente.
// La branch robusta e' condizionata a 'robust', che e' costante per tutto il
// grafico: l'esecuzione resta deterministica e si evita di pagare due ta.median
// per sezione quando lo stimatore robusto e' spento.
f_zser(float s, simple int len) =>
    bSma = ta.sma(s, len)
    bEma = ta.ema(s, len)
    b    = maMode == "EMA" ? bEma : bSma
    d    = ta.stdev(s, len)
    float z = d > 0 ? (s - b) / d : 0.0
    if robust
        med = ta.median(s, len)
        mad = ta.median(math.abs(s - med), len)
        z := mad > 0 ? 0.6745 * (s - med) / mad : 0.0
    z

// Eseguita DENTRO il contesto del TF richiesto: restituisce lo z nativo (modo A)
// e la sorgente HTF grezza, che serve al modo B una volta mappata sul grafico.
f_htf(simple int len, simple bool shift) =>
    s = f_src()
    z = f_zser(s, len)
    [shift ? z[1] : z, shift ? s[1] : s]

chartSec = timeframe.in_seconds()
sec1 = timeframe.in_seconds(tf1)
sec2 = timeframe.in_seconds(tf2)
sec3 = timeframe.in_seconds(tf3)
sec4 = timeframe.in_seconds(tf4)
sec5 = timeframe.in_seconds(tf5)

// k = quante barre del grafico entrano in una barra della sezione.
k1 = int(math.max(1, math.round(sec1 / float(chartSec))))
k2 = int(math.max(1, math.round(sec2 / float(chartSec))))
k3 = int(math.max(1, math.round(sec3 / float(chartSec))))
k4 = int(math.max(1, math.round(sec4 / float(chartSec))))
k5 = int(math.max(1, math.round(sec5 / float(chartSec))))

// TF piu' veloce fra gli attivi: serve gia' qui, perche' decide quale sezione
// viene esentata dallo shift anti-repaint quando fastNow e' attivo.
BIG = 1e12
m1 = use1 ? sec1 : BIG
m2 = use2 ? sec2 : BIG
m3 = use3 ? sec3 : BIG
m4 = use4 ? sec4 : BIG
m5 = use5 ? sec5 : BIG
minSec    = math.min(math.min(math.min(math.min(m1, m2), m3), m4), m5)
anyActive = use1 or use2 or use3 or use4 or use5

// Lo shift anti-repaint si applica solo ai TF STRETTAMENTE superiori al grafico.
[zN1, sH1] = request.security(syminfo.tickerid, tf1, f_htf(len1, confirmed and sec1 > chartSec and not (fastNow and m1 == minSec)), lookahead = barmerge.lookahead_off)
[zN2, sH2] = request.security(syminfo.tickerid, tf2, f_htf(len2, confirmed and sec2 > chartSec and not (fastNow and m2 == minSec)), lookahead = barmerge.lookahead_off)
[zN3, sH3] = request.security(syminfo.tickerid, tf3, f_htf(len3, confirmed and sec3 > chartSec and not (fastNow and m3 == minSec)), lookahead = barmerge.lookahead_off)
[zN4, sH4] = request.security(syminfo.tickerid, tf4, f_htf(len4, confirmed and sec4 > chartSec and not (fastNow and m4 == minSec)), lookahead = barmerge.lookahead_off)
[zN5, sH5] = request.security(syminfo.tickerid, tf5, f_htf(len5, confirmed and sec5 > chartSec and not (fastNow and m5 == minSec)), lookahead = barmerge.lookahead_off)

modeA = zBasis == "A · TF nativo"
modeB = zBasis == "B · Barre grafico (serie HTF)"

// Modo C: finestra equivalente in barre del grafico. Cap a 4000 per non far
// esplodere il tempo di calcolo (5 sezioni x ta.stdev su finestre enormi).
lenC1 = int(math.min(4000, len1 * k1))
lenC2 = int(math.min(4000, len2 * k2))
lenC3 = int(math.min(4000, len3 * k3))
lenC4 = int(math.min(4000, len4 * k4))
lenC5 = int(math.min(4000, len5 * k5))

srcC = f_src()   // sorgente nel contesto del grafico, a piena risoluzione

z1 = modeA ? zN1 : modeB ? f_zser(sH1, len1) : f_zser(srcC, lenC1)
z2 = modeA ? zN2 : modeB ? f_zser(sH2, len2) : f_zser(srcC, lenC2)
z3 = modeA ? zN3 : modeB ? f_zser(sH3, len3) : f_zser(srcC, lenC3)
z4 = modeA ? zN4 : modeB ? f_zser(sH4, len4) : f_zser(srcC, lenC4)
z5 = modeA ? zN5 : modeB ? f_zser(sH5, len5) : f_zser(srcC, lenC5)

// -- CAMPIONE EFFETTIVO e TETTO ALGEBRICO DELLO Z-SCORE ----------------------
//  Con deviazione standard di popolazione (quella usata da ta.stdev di default)
//  il massimo |z| ottenibile da n osservazioni e' sqrt(n-1). E' un vincolo
//  algebrico, non statistico: nessuna configurazione lo aggira.
//  Nel modo B la serie HTF e' a gradini, quindi n_eff = len/k e non len.
//  Esempio: grafico 15S, sezione 5m, len 100 -> n_eff 5 -> max|z| = 2.00.
//  Quella sezione non superera' MAI la soglia +2 e il segnale non scattera'
//  mai. La dashboard colora di rosso la sezione in cui questo accade.
ne1 = modeA ? float(len1) : modeB ? math.max(1.0, len1 / float(k1)) : float(lenC1)
ne2 = modeA ? float(len2) : modeB ? math.max(1.0, len2 / float(k2)) : float(lenC2)
ne3 = modeA ? float(len3) : modeB ? math.max(1.0, len3 / float(k3)) : float(lenC3)
ne4 = modeA ? float(len4) : modeB ? math.max(1.0, len4 / float(k4)) : float(lenC4)
ne5 = modeA ? float(len5) : modeB ? math.max(1.0, len5 / float(k5)) : float(lenC5)

f_zcap(float ne) => math.sqrt(math.max(ne - 1.0, 0.0))

// soglia attiva piu' ambiziosa: serve a capire se il tetto la rende irraggiungibile
thrMaxAct = math.max(math.max(enP2 ? math.abs(thrP2) : 0.0, enP1 ? math.abs(thrP1) : 0.0), math.max(enM1 ? math.abs(thrM1) : 0.0, enM2 ? math.abs(thrM2) : 0.0))

// Finestra effettiva: mai piu' stretta di 2 barre della sezione piu' lenta attiva.
kAct1 = use1 ? k1 : 1
kAct2 = use2 ? k2 : 1
kAct3 = use3 ? k3 : 1
kAct4 = use4 ? k4 : 1
kAct5 = use5 ? k5 : 1
kMax  = math.max(math.max(math.max(math.max(kAct1, kAct2), kAct3), kAct4), kAct5)
lbEff = autoLb ? int(math.max(lookback, 2 * kMax)) : lookback

// Estremi raggiunti nella finestra di confluenza (barre del grafico = unita' di tempo uniforme).
hi1 = ta.highest(z1, lbEff)
lo1 = ta.lowest(z1, lbEff)
hi2 = ta.highest(z2, lbEff)
lo2 = ta.lowest(z2, lbEff)
hi3 = ta.highest(z3, lbEff)
lo3 = ta.lowest(z3, lbEff)
hi4 = ta.highest(z4, lbEff)
lo4 = ta.lowest(z4, lbEff)
hi5 = ta.highest(z5, lbEff)
lo5 = ta.lowest(z5, lbEff)

// ------------------------------------------------ TF piu' veloce fra gli attivi
zFast     = m1 == minSec ? z1 : m2 == minSec ? z2 : m3 == minSec ? z3 : m4 == minSec ? z4 : m5 == minSec ? z5 : na
zPrev     = nz(zFast[1], zFast)
tfFast    = m1 == minSec ? tf1 : m2 == minSec ? tf2 : m3 == minSec ? tf3 : m4 == minSec ? tf4 : m5 == minSec ? tf5 : "-"

// Cross puri (nessuno stato interno => sicuri dentro rami condizionali).
f_cu(float now, float prev, float lvl) => now < lvl and prev >= lvl
f_co(float now, float prev, float lvl) => now > lvl and prev <= lvl

// Armamento: TUTTI i TF attivi hanno superato la soglia entro la finestra.
f_arm(float thr, bool isUp) =>
    a = anyActive
    if use1
        a := a and (isUp ? hi1 >= thr : lo1 <= thr)
    if use2
        a := a and (isUp ? hi2 >= thr : lo2 <= thr)
    if use3
        a := a and (isUp ? hi3 >= thr : lo3 <= thr)
    if use4
        a := a and (isUp ? hi4 >= thr : lo4 <= thr)
    if use5
        a := a and (isUp ? hi5 >= thr : lo5 <= thr)
    a

// Uno stream = una soglia. Latch: un solo segnale per episodio di armamento.
f_stream(bool en, float thr, float trg, bool isUp) =>
    var bool fired   = false
    var int  lastSig = -100000
    armed = en and f_arm(thr, isUp)
    if not armed
        fired := false
    trig = false
    if trigMode == "Primo tocco della soglia"
        trig := isUp ? f_co(zFast, zPrev, thr) : f_cu(zFast, zPrev, thr)
    else
        trig := isUp ? f_cu(zFast, zPrev, trg) : f_co(zFast, zPrev, trg)
    fire = armed and not fired and trig and not na(zFast) and (bar_index - lastSig >= cooldown)
    if fire
        fired   := true
        lastSig := bar_index
    [fire, armed]

[sigA, armA] = f_stream(enP2, thrP2, trgP2, true)
[sigB, armB] = f_stream(enP1, thrP1, trgP1, true)
[sigC, armC] = f_stream(enM1, thrM1, trgM1, false)
[sigD, armD] = f_stream(enM2, thrM2, trgM2, false)

// ============================================================ DIAGNOSTICA =====
//  Quando non compaiono segnali serve sapere DOVE si rompe la catena, non
//  tirare a indovinare sui parametri. Tre livelli di conteggio:
//    hit     = quante volte la singola sezione ha TOCCATO la soglia piu' alta
//              attiva. Se una sezione mostra 0, e' lei a bloccare tutto.
//    armate  = su quante barre lo stream ha avuto TUTTE le sezioni in soglia.
//              0 con hit alti = le sezioni non sono mai estreme INSIEME:
//              allarga la finestra di confluenza.
//    segnali = quante volte e' poi scattato il trigger. Armate alte e segnali 0
//              = il livello di trigger e' irraggiungibile, non le soglie.
f_cnt(bool c) =>
    var int n = 0
    if c
        n += 1
    n

// tocco = attraversamento della soglia, non permanenza sopra di essa
f_hit(bool use, float z) =>
    f_cnt(use and thrMaxAct > 0 and math.abs(z) >= thrMaxAct and math.abs(nz(z[1], z)) < thrMaxAct)

cHit1 = f_hit(use1, z1)
cHit2 = f_hit(use2, z2)
cHit3 = f_hit(use3, z3)
cHit4 = f_hit(use4, z4)
cHit5 = f_hit(use5, z5)

cArmA = f_cnt(armA)
cArmB = f_cnt(armB)
cArmC = f_cnt(armC)
cArmD = f_cnt(armD)
cSigA = f_cnt(sigA)
cSigB = f_cnt(sigB)
cSigC = f_cnt(sigC)
cSigD = f_cnt(sigD)

// ================================================================== PLOT ======
// Il pannello mostra le curve z e i livelli. I MARKER invece vengono spinti sul
// grafico dei prezzi con force_overlay: cosi' si ha il quadro statistico sotto e
// i segnali sulle candele, senza dover caricare due script.
plot(showZ and use1 ? z1 : na, "z S1", color = cz1, linewidth = 1)
plot(showZ and use2 ? z2 : na, "z S2", color = cz2, linewidth = 1)
plot(showZ and use3 ? z3 : na, "z S3", color = cz3, linewidth = 1)
plot(showZ and use4 ? z4 : na, "z S4", color = cz4, linewidth = 1)
plot(showZ and use5 ? z5 : na, "z S5", color = cz5, linewidth = 2)
plot(showZ ? zFast : na,       "z TF veloce", color = czF, linewidth = 2)

// Dimensioni testo: table.cell e label.set_size accettano series string, quindi
// la scelta puo' restare un input invece di essere fissata a compile time.
f_size(string opt) =>
    opt == "Minimo" ? size.tiny : opt == "Piccolo" ? size.small : opt == "Normale" ? size.normal : size.large
szDash = f_size(dashSz)
szTag  = f_size(tagSz)

// Etichetta con il periodo, scritta in fondo alla curva della sezione. Cosi' la
// corrispondenza colore -> timeframe si legge dal pannello e non va ricordata.
f_tag(bool use, string tf, float z, color c) =>
    var label lb = label.new(bar_index, 0.0, "", style = label.style_none, size = size.tiny, textalign = text.align_left)
    if barstate.islast
        label.set_xy(lb, bar_index + tagOff, z)
        label.set_text(lb, showZ and showTags and use ? tf : "")
        label.set_textcolor(lb, c)
        label.set_size(lb, szTag)
    lb

f_tag(use1, tf1, z1, cz1)
f_tag(use2, tf2, z2, cz2)
f_tag(use3, tf3, z3, cz3)
f_tag(use4, tf4, z4, cz4)
f_tag(use5, tf5, z5, cz5)

// Soglie e trigger: solo quelli degli stream ATTIVI, cosi' il pannello mostra
// esattamente la configurazione in uso e non quattro righe decorative.
hline(0, "zero", color = cLvl0, linestyle = hline.style_dotted)
plot(showLv and enP2 ? thrP2 : na, "soglia A", color = cLvlS, style = plot.style_linebr)
plot(showLv and enP1 ? thrP1 : na, "soglia B", color = cLvlS, style = plot.style_linebr)
plot(showLv and enM1 ? thrM1 : na, "soglia C", color = cLvlS, style = plot.style_linebr)
plot(showLv and enM2 ? thrM2 : na, "soglia D", color = cLvlS, style = plot.style_linebr)
plot(showLv and enP2 ? trgP2 : na, "trigger A", color = cLvlT, style = plot.style_cross, linewidth = 1)
plot(showLv and enP1 ? trgP1 : na, "trigger B", color = cLvlT, style = plot.style_cross, linewidth = 1)
plot(showLv and enM1 ? trgM1 : na, "trigger C", color = cLvlT, style = plot.style_cross, linewidth = 1)
plot(showLv and enM2 ? trgM2 : na, "trigger D", color = cLvlT, style = plot.style_cross, linewidth = 1)

// I marker: force_overlay e' un parametro COSTANTE, non puo' essere commutato da
// un input. Quindi esistono due serie di plotshape, una nel pannello e una sul
// grafico prezzi, e l'input sceglie quale riceve il segnale. In entrambi i casi
// il marker resta ancorato alla barra del grafico in cui il TF piu' veloce ha
// attraversato il livello di trigger: cambia solo dove viene disegnato.
isArrow = marker == "Freccia"
inPane  = markWhere != "Grafico prezzi"
onChart = markWhere != "Pannello"

// y assoluto nel pannello; gli stream della stessa direzione sono sfalsati di
// 0.35 z per non finire sullo stesso pixel quando scattano insieme.
yA = inPane and sigA ?  markLvl        : na
yB = inPane and sigB ?  markLvl - 0.35 : na
yC = inPane and sigC ? -markLvl + 0.35 : na
yD = inPane and sigD ? -markLvl        : na

// -- pannello ----------------------------------------------------------------
plotshape(isArrow ? yA : na,     "SELL A", shape.arrowdown, location.absolute, cUp, size = size.small, text = "A")
plotshape(not isArrow ? yA : na, "SELL A ·", shape.circle,  location.absolute, cUp, size = size.tiny)
plotshape(isArrow ? yB : na,     "SELL B", shape.arrowdown, location.absolute, color.new(cUp, 45), size = size.small, text = "B")
plotshape(not isArrow ? yB : na, "SELL B ·", shape.circle,  location.absolute, color.new(cUp, 45), size = size.tiny)
plotshape(isArrow ? yC : na,     "BUY C",  shape.arrowup,   location.absolute, color.new(cDn, 45), size = size.small, text = "C")
plotshape(not isArrow ? yC : na, "BUY C ·", shape.circle,   location.absolute, color.new(cDn, 45), size = size.tiny)
plotshape(isArrow ? yD : na,     "BUY D",  shape.arrowup,   location.absolute, cDn, size = size.small, text = "D")
plotshape(not isArrow ? yD : na, "BUY D ·", shape.circle,   location.absolute, cDn, size = size.tiny)

// -- grafico prezzi ----------------------------------------------------------
plotshape(onChart and isArrow and sigA,     "SELL A (prezzo)", shape.arrowdown, location.abovebar, cUp, size = size.small, force_overlay = true, text = "A")
plotshape(onChart and not isArrow and sigA, "SELL A (prezzo) ·", shape.circle,  location.abovebar, cUp, size = size.tiny, force_overlay = true)
plotshape(onChart and isArrow and sigB,     "SELL B (prezzo)", shape.arrowdown, location.abovebar, color.new(cUp, 45), size = size.small, force_overlay = true, text = "B")
plotshape(onChart and not isArrow and sigB, "SELL B (prezzo) ·", shape.circle,  location.abovebar, color.new(cUp, 45), size = size.tiny, force_overlay = true)
plotshape(onChart and isArrow and sigC,     "BUY C (prezzo)",  shape.arrowup,   location.belowbar, color.new(cDn, 45), size = size.small, force_overlay = true, text = "C")
plotshape(onChart and not isArrow and sigC, "BUY C (prezzo) ·", shape.circle,   location.belowbar, color.new(cDn, 45), size = size.tiny, force_overlay = true)
plotshape(onChart and isArrow and sigD,     "BUY D (prezzo)",  shape.arrowup,   location.belowbar, cDn, size = size.small, force_overlay = true, text = "D")
plotshape(onChart and not isArrow and sigD, "BUY D (prezzo) ·", shape.circle,   location.belowbar, cDn, size = size.tiny, force_overlay = true)

// Sfondo di armamento: resta NEL PANNELLO, cosi' non sporca le candele.
bgcolor(not showArmBg ? na : (armA or armB) ? color.new(cUp, 92) : (armC or armD) ? color.new(cDn, 92) : na, title="Sfondo armamento")

// ============================================================== CRUSCOTTO =====
//  La colonna "n · cap" e' la piu' importante quando si usa il modo B: mostra
//  il campione effettivo della sezione e il massimo |z| algebricamente
//  raggiungibile. Se il cap e' sotto la soglia attiva, la riga diventa ROSSA:
//  quella sezione non potra' mai armare e la confluenza restera' bloccata.
f_stat(bool use, string tf, int sec, float z, float h, float l, float ne) =>
    bad  = use and sec < chartSec
    cap  = f_zcap(ne)
    dead = use and cap < thrMaxAct
    [use ? (bad ? "⚠ < grafico" : tf) : "off",
     use ? str.tostring(z, "#.00") : "–",
     use ? str.tostring(l, "#.0") + " / " + str.tostring(h, "#.0") : "–",
     use ? str.tostring(int(math.round(ne))) + " · " + str.tostring(cap, "#.0") : "–",
     bad, dead]

var table dash = table.new(position.top_right, 6, 10, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
if showTab and barstate.islast
    hdrBg = color.new(color.gray, 70)
    modeTag = modeA ? "A nativo" : modeB ? "B grafico/HTF" : "C orizz.equiv."
    table.cell(dash, 0, 0, "TF", bgcolor=hdrBg, text_color=color.white, text_size=szDash)
    table.cell(dash, 1, 0, "z", bgcolor=hdrBg, text_color=color.white, text_size=szDash)
    table.cell(dash, 2, 0, "min/max " + str.tostring(lbEff), bgcolor=hdrBg, text_color=color.white, text_size=szDash)
    table.cell(dash, 3, 0, "n · cap", bgcolor=hdrBg, text_color=color.white, text_size=szDash)
    table.cell(dash, 4, 0, "hit", bgcolor=hdrBg, text_color=color.white, text_size=szDash)
    table.cell(dash, 5, 0, "stato", bgcolor=hdrBg, text_color=color.white, text_size=szDash)

    [t1, v1, r1, q1, b1, d1] = f_stat(use1, tf1, sec1, z1, hi1, lo1, ne1)
    [t2, v2, r2, q2, b2, d2] = f_stat(use2, tf2, sec2, z2, hi2, lo2, ne2)
    [t3, v3, r3, q3, b3, d3] = f_stat(use3, tf3, sec3, z3, hi3, lo3, ne3)
    [t4, v4, r4, q4, b4, d4] = f_stat(use4, tf4, sec4, z4, hi4, lo4, ne4)
    [t5, v5, r5, q5, b5, d5] = f_stat(use5, tf5, sec5, z5, hi5, lo5, ne5)

    ts = array.from(t1, t2, t3, t4, t5)
    vs = array.from(v1, v2, v3, v4, v5)
    rs = array.from(r1, r2, r3, r4, r5)
    qs = array.from(q1, q2, q3, q4, q5)
    bs = array.from(b1, b2, b3, b4, b5)
    ds = array.from(d1, d2, d3, d4, d5)
    zs = array.from(z1, z2, z3, z4, z5)
    us = array.from(use1, use2, use3, use4, use5)
    hs = array.from(cHit1, cHit2, cHit3, cHit4, cHit5)
    cs = array.from(cz1, cz2, cz3, cz4, cz5)

    for i = 0 to 4
        zv   = array.get(zs, i)
        act  = array.get(us, i)
        dead = array.get(ds, i)
        col  = not act ? color.new(color.gray, 60) : dead ? color.new(color.red, 25) : array.get(bs, i) ? color.new(color.orange, 30) : zv >= 2 ? color.new(cUp, 40) : zv <= -2 ? color.new(cDn, 40) : color.new(color.gray, 80)
        st   = not act ? "off" : dead ? "cap < soglia" : (zv >= 2 or zv <= -2 ? "estremo" : "–")
        table.cell(dash, 0, i + 1, "S" + str.tostring(i + 1) + " " + array.get(ts, i), text_size=szDash, text_color=act ? array.get(cs, i) : color.gray, bgcolor=col)
        table.cell(dash, 1, i + 1, array.get(vs, i), text_size=szDash, text_color=color.white, bgcolor=col)
        table.cell(dash, 2, i + 1, array.get(rs, i), text_size=szDash, text_color=color.white, bgcolor=col)
        table.cell(dash, 3, i + 1, array.get(qs, i), text_size=szDash, text_color=color.white, bgcolor=col)
        hitN = array.get(hs, i)
        table.cell(dash, 4, i + 1, act ? str.tostring(hitN) : "–", text_size=szDash, text_color=act and hitN == 0 ? color.red : color.white, bgcolor=col)
        table.cell(dash, 5, i + 1, st, text_size=szDash, text_color=color.white, bgcolor=col)

    armTxt = (armA ? "A " : "") + (armB ? "B " : "") + (armC ? "C " : "") + (armD ? "D " : "")
    table.cell(dash, 0, 6, "modo", text_size=szDash, text_color=color.white, bgcolor=hdrBg)
    table.cell(dash, 1, 6, modeTag, text_size=szDash, text_color=color.white, bgcolor=hdrBg)
    table.cell(dash, 2, 6, "fast", text_size=szDash, text_color=color.white, bgcolor=hdrBg)
    table.cell(dash, 3, 6, tfFast, text_size=szDash, text_color=color.white, bgcolor=hdrBg)
    table.cell(dash, 4, 6, "ora", text_size=szDash, text_color=color.white, bgcolor=hdrBg)
    table.cell(dash, 5, 6, armTxt == "" ? "–" : armTxt, text_size=szDash, text_color=color.white, bgcolor=armTxt == "" ? hdrBg : color.new(color.orange, 40))

    // -- diagnostica: dove si rompe la catena --------------------------------
    table.cell(dash, 0, 7, "stream",  text_size=szDash, text_color=color.white, bgcolor=hdrBg)
    table.cell(dash, 1, 7, "A " + str.tostring(thrP2, "#.#"), text_size=szDash, text_color=enP2 ? cUp : color.gray, bgcolor=hdrBg)
    table.cell(dash, 2, 7, "B " + str.tostring(thrP1, "#.#"), text_size=szDash, text_color=enP1 ? cUp : color.gray, bgcolor=hdrBg)
    table.cell(dash, 3, 7, "C " + str.tostring(thrM1, "#.#"), text_size=szDash, text_color=enM1 ? cDn : color.gray, bgcolor=hdrBg)
    table.cell(dash, 4, 7, "D " + str.tostring(thrM2, "#.#"), text_size=szDash, text_color=enM2 ? cDn : color.gray, bgcolor=hdrBg)
    table.cell(dash, 5, 7, "", bgcolor=hdrBg)

    ac = array.from(cArmA, cArmB, cArmC, cArmD)
    sc = array.from(cSigA, cSigB, cSigC, cSigD)
    ae = array.from(enP2, enP1, enM1, enM2)
    table.cell(dash, 0, 8, "armate",  text_size=szDash, text_color=color.silver, bgcolor=color.new(color.gray, 85))
    table.cell(dash, 0, 9, "segnali", text_size=szDash, text_color=color.silver, bgcolor=color.new(color.gray, 85))
    for j = 0 to 3
        av = array.get(ac, j)
        sv = array.get(sc, j)
        on = array.get(ae, j)
        // rosso = mai armato (soglie o finestra troppo strette)
        // arancio = armato ma mai scattato (livello di trigger irraggiungibile)
        acol = not on ? color.gray : av == 0 ? color.red : color.silver
        scol = not on ? color.gray : sv == 0 and av > 0 ? color.orange : sv == 0 ? color.red : color.lime
        table.cell(dash, j + 1, 8, on ? str.tostring(av) : "–", text_size=szDash, text_color=acol, bgcolor=color.new(color.gray, 85))
        table.cell(dash, j + 1, 9, on ? str.tostring(sv) : "–", text_size=szDash, text_color=scol, bgcolor=color.new(color.gray, 85))
    table.cell(dash, 5, 8, "barre", text_size=szDash, text_color=color.gray, bgcolor=color.new(color.gray, 85))
    table.cell(dash, 5, 9, "tot",   text_size=szDash, text_color=color.gray, bgcolor=color.new(color.gray, 85))

// ================================================================= ALERT ======
alertcondition(sigA, "MTF-Z · SELL soglia A", "MTF-Z SELL A · confluenza su tutti i TF attivi")
alertcondition(sigB, "MTF-Z · SELL soglia B", "MTF-Z SELL B · confluenza su tutti i TF attivi")
alertcondition(sigC, "MTF-Z · BUY soglia C",  "MTF-Z BUY C · confluenza su tutti i TF attivi")
alertcondition(sigD, "MTF-Z · BUY soglia D",  "MTF-Z BUY D · confluenza su tutti i TF attivi")
alertcondition(sigA or sigB, "MTF-Z · SELL (qualsiasi)", "MTF-Z SELL · confluenza")
alertcondition(sigC or sigD, "MTF-Z · BUY (qualsiasi)",  "MTF-Z BUY · confluenza")

if sigA or sigB or sigC or sigD
    dir = (sigA or sigB) ? "SELL" : "BUY"
    tag = sigA ? "A" : sigB ? "B" : sigC ? "C" : "D"
    alert("MTF-Z " + dir + " [" + tag + "] " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | zFast=" + str.tostring(zFast, "#.00"), alert.freq_once_per_bar_close)
