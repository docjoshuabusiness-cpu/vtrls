//@version=6
// =============================================================================
//  WICK DOMINANCE / PIN BAR - LIVE  v1.0
//  Rileva in tempo reale (intrabar) quando la candela in formazione ha un wick
//  nettamente dominante sull'altro, o si qualifica come pin bar.
//
//  Progettato per timeframe a secondi (5s / 15s) su futures (NQ, ES) dove il
//  range di una barra vale pochi tick: i rapporti percentuali da soli sono
//  rumore di quantizzazione, quindi ogni segnale deve passare ANCHE un filtro
//  di ampiezza assoluta (tick) e uno relativo alla volatilita' corrente (ATR).
//
//  NOTA REPAINT: in modalita' Live il segnale e' provvisorio per costruzione.
//  Compare quando la condizione e' vera sul tick corrente e puo' sparire se la
//  barra si riempie. E' voluto: serve per vedere, non per backtestare.
//  Per statistiche affidabili usare la modalita' Confermata.
// =============================================================================

indicator("Wick Dominance / Pin Bar - Live", "WICK", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------- 1. Segnale
gS = "1 - Segnale"
mode  = input.string("Live (intrabar)", "Modalita",
     options = ["Live (intrabar)", "Confermata (a chiusura)"], group = gS)
logic = input.string("Pin bar (stretta)", "Logica",
     options = ["Pin bar (stretta)", "Dominanza wick (larga)"], group = gS,
     tooltip = "Stretta: impone anche body piccolo. Larga: guarda solo quale wick e' piu' grande.")
minDom    = input.float(0.40, "Imbalance minimo |LW-UW|/range", 0.0, 1.0, 0.05, group = gS)
minWick   = input.float(0.50, "Wick dominante / range",         0.0, 1.0, 0.05, group = gS)
maxBody   = input.float(0.40, "Body massimo / range",           0.0, 1.0, 0.05, group = gS)
needClose = input.bool(true,  "Close nella meta' opposta al wick", group = gS)

// ------------------------------------------------------- 2. Filtri di rumore
gF = "2 - Filtri rumore"
minTicks = input.int(4,    "Range minimo (tick)", 0, group = gF,
     tooltip = "Sotto questa ampiezza la candela e' quantizzazione, non struttura. NQ: 4 tick = 1.00 pt.")
useAtr   = input.bool(true,  "Filtro ATR", group = gF)
atrLen   = input.int(50,     "ATR lunghezza", 2, group = gF)
atrMult  = input.float(1.00, "Range >= ATR x", 0.0, step = 0.1, group = gF)
useVol   = input.bool(false, "Filtro volume", group = gF)
volLen   = input.int(50,     "Volume SMA lunghezza", 2, group = gF)
volMult  = input.float(1.20, "Volume >= SMA x", 0.0, step = 0.1, group = gF)

// -------------------------------------------------------------- 3. Grafica
gV = "3 - Visuale"
showLine  = input.bool(true,  "Evidenzia il wick dominante", group = gV)
showTri   = input.bool(true,  "Triangoli di segnale",        group = gV)
showTable = input.bool(true,  "Pannello letture live",       group = gV)
colBull   = input.color(color.new(#00bcd4, 0), "Colore rialzista", group = gV)
colBear   = input.color(color.new(#ff5252, 0), "Colore ribassista", group = gV)

// ============================================================== METRICHE ====
rng  = high - low
body = math.abs(close - open)
uw   = high - math.max(open, close)          // upper wick
lw   = math.min(open, close) - low           // lower wick

rBody = rng > 0 ? body / rng : 0.0
rUw   = rng > 0 ? uw   / rng : 0.0
rLw   = rng > 0 ? lw   / rng : 0.0
// dom > 0  -> wick inferiore dominante (pressione rialzista / rifiuto del basso)
// dom < 0  -> wick superiore dominante
dom   = rng > 0 ? (lw - uw) / rng : 0.0

// Riferimenti presi sulla barra PRECEDENTE: su intrabar l'ATR/volume della
// barra corrente crescono tick dopo tick e renderebbero la soglia mobile.
atrRef = nz(ta.atr(atrLen)[1])
volRef = nz(ta.sma(volume, volLen)[1])

okSize = rng >= minTicks * syminfo.mintick
okAtr  = not useAtr or (atrRef > 0 and rng >= atrRef * atrMult)
okVol  = not useVol or (volRef > 0 and volume >= volRef * volMult)
okFilt = okSize and okAtr and okVol

strict = logic == "Pin bar (stretta)"

bullCore = rLw >= minWick and dom >= minDom
     and (not strict    or rBody <= maxBody)
     and (not needClose or close >= low + rng * 0.5)

bearCore = rUw >= minWick and -dom >= minDom
     and (not strict    or rBody <= maxBody)
     and (not needClose or close <= high - rng * 0.5)

live = mode == "Live (intrabar)"
// In Confermata valutiamo solo a barra chiusa; su storico barstate.isconfirmed
// e' sempre vero, quindi il comportamento e' identico live e in backtest.
active = live or barstate.isconfirmed

bull = bullCore and okFilt and active
bear = bearCore and okFilt and active

tk(x) => str.tostring(x / syminfo.mintick, "#.#")   // prezzo -> tick, leggibile a colpo d'occhio

// ============================================================== GRAFICA =====
plotshape(showTri and bull, "Bull wick", shape.triangleup,   location.belowbar, colBull, size = size.tiny)
plotshape(showTri and bear, "Bear wick", shape.triangledown, location.abovebar, colBear, size = size.tiny)

// Evidenzia il segmento di wick dominante. In Live la linea viene aggiornata
// tick per tick e cancellata se la condizione decade prima della chiusura.
var line wickLn = na
var int  wickBar = na

if showLine
    sig = bull or bear
    if sig
        y1 = bull ? low  : high
        y2 = bull ? math.min(open, close) : math.max(open, close)
        c  = bull ? colBull : colBear
        if na(wickLn) or wickBar != bar_index
            wickLn  := line.new(bar_index, y1, bar_index, y2, width = 3, color = c)
            wickBar := bar_index
        else
            line.set_xy1(wickLn, bar_index, y1)
            line.set_xy2(wickLn, bar_index, y2)
            line.set_color(wickLn, c)
    else if not na(wickLn) and wickBar == bar_index
        line.delete(wickLn)
        wickLn := na

// Pannello: a 5 secondi non si legge la forma della candela, si legge il numero.
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 6,
         bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.new(color.gray, 60))
    st = bull ? "BULL WICK" : bear ? "BEAR WICK" : okFilt ? "-" : "filtrata"
    sc = bull ? colBull : bear ? colBear : color.gray
    table.cell(t, 0, 0, "range",     text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 0, tk(rng)     + " tk", text_color = color.white,  text_size = size.small)
    table.cell(t, 0, 1, "wick sup",  text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 1, tk(uw)      + " tk", text_color = color.white,  text_size = size.small)
    table.cell(t, 0, 2, "wick inf",  text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 2, tk(lw)      + " tk", text_color = color.white,  text_size = size.small)
    table.cell(t, 0, 3, "body",      text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 3, tk(body)    + " tk", text_color = color.white,  text_size = size.small)
    table.cell(t, 0, 4, "imbalance", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 4, str.tostring(dom * 100, "#") + " %",
         text_color = dom > 0 ? colBull : dom < 0 ? colBear : color.white, text_size = size.small)
    table.cell(t, 0, 5, "stato",     text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 5, st, text_color = sc, text_size = size.small)

// =============================================================== ALERT ======
// Latch per barra: in Live la condizione e' vera su molti tick consecutivi,
// senza latch l'alert spara decine di volte sulla stessa candela.
var bool firedBull = false
var bool firedBear = false
if barstate.isnew
    firedBull := false
    firedBear := false

msgBase = syminfo.ticker + " " + timeframe.period + "  imb " + str.tostring(dom * 100, "#") +
     "%  rng " + str.tostring(rng / syminfo.mintick, "#.#") + "tk"

if bull and not firedBull
    firedBull := true
    alert("WICK INFERIORE dominante | " + msgBase, alert.freq_all)
if bear and not firedBear
    firedBear := true
    alert("WICK SUPERIORE dominante | " + msgBase, alert.freq_all)

// alertcondition per chi preferisce l'alert classico (solo a barra chiusa).
alertcondition(bull, "Wick inferiore dominante", "Pin/wick bull rilevato")
alertcondition(bear, "Wick superiore dominante", "Pin/wick bear rilevato")
