//@version=6
// ============================================================================
//  UNIFIED FLOW ENGINE v1  ·  "UFE1"
//  Fusione di tre script in un solo indicatore overlay:
//    A) Order Flow Engine v2 (OFE2)      - Absorption / Exhaustion / Initiative / Divergence
//    B) ASM Signals + Trend (Clean)      - Long/Short in RANGE (reversal z-score) e in TREND
//    C) Volatility State Indicator[Ferro]- espansione/compressione di candela + regime vol
//
//  DECISIONE SULLA SUB-FINESTRA DI FERRO
//  ------------------------------------
//  Pine non consente a un unico script di essere overlay E non-overlay.
//  Il pannello a colonne di Ferro e' stato RIMOSSO, non perche' fosse un
//  vincolo tecnico insormontabile, ma perche' quel pannello serve a guardare,
//  non a operare. Di Ferro sopravvive tutto cio' che ha valore decisionale:
//    · marker di ESPANSIONE (e opzionalmente compressione) sulla candela
//    · riga in dashboard: regime, percentile, TR/ATR, z-score
//    · GATE opzionale: nessun segnale quando la volatilita' e' sotto soglia
//    · colonne di export per il meta-labeling
//  Chi vuole l'istogramma tiene Ferro come script separato: costa uno slot.
//
//  COSA E' STATO CAMBIATO NEI COMPONENTI IMPORTATI
//  ----------------------------------------------
//  ASM  : i segnali di TREND originali erano VERI su OGNI barra del trend
//         (stato, non evento). Come marker e' rumore; come trade e' un
//         ingresso ripetuto ogni barra. Default = "Solo cambio stato".
//         I quattro segnali ASM passano ora dallo STESSO motore a barriere
//         degli eventi OFE, quindi si leggono in R e si confrontano con la
//         baseline. Se ASM non batte la baseline, si vede a numeri.
//  FERRO: nessuna modifica alla matematica (ATR% + Parkinson + percentrank).
//         Solo re-namespacing per evitare collisioni di simboli.
// ============================================================================

indicator("Unified Flow Engine v1", "UFE1", overlay = true, max_labels_count = 500)

// ============================================================================
//  INPUT
// ============================================================================
grpE = "1 - Motore Delta"
useLTF    = input.bool(true, "Delta da timeframe inferiore (consigliato)", group = grpE, tooltip = "Classifica ogni barra intrabar per close vs open. Piu' informativo della geometria della candela. Serve TF grafico >= 5m per risultati stabili.")
ltfOvr    = input.string("auto", "TF inferiore", options = ["auto", "1S", "5S", "15S", "1", "5", "15"], group = grpE)
wickW     = input.float(1.0, "Peso wick imbalance", minval = 0.0, maxval = 2.0, step = 0.1, group = grpE, tooltip = "Solo modalita' geometrica. Con 1.0 si ottiene esattamente il Close Location Value.")
anchorCVD = input.bool(true, "Ancora il CVD alla sessione giornaliera", group = grpE)

grpS = "2 - Statistica"
statLen = input.int(60, "Finestra stimatori robusti", minval = 20, maxval = 500, group = grpS)
atrLen  = input.int(14, "ATR length", minval = 5, group = grpS)
erLen   = input.int(20, "Efficiency Ratio length", minval = 5, group = grpS)
extLen  = input.int(50, "Lookback estensione / estremi", minval = 10, group = grpS)

grpT = "3 - Soglie eventi OFE"
vzMin    = input.float(1.5,  "Partecipazione minima (z volume)",     minval = 0.0, step = 0.1,  group = grpT)
vzClimax = input.float(2.0,  "Partecipazione climax (z volume)",     minval = 0.0, step = 0.1,  group = grpT)
orthoMin = input.float(0.25, "Sbilanciamento ortogonale minimo",     minval = 0.0, maxval = 1.0, step = 0.05, group = grpT)
imbMin   = input.float(0.35, "Sbilanciamento direzionale minimo",    minval = 0.0, maxval = 1.0, step = 0.05, group = grpT)
resMin   = input.float(0.35, "Risultato minimo (|close-open| / ATR)", minval = 0.0, step = 0.05, group = grpT)
erRange  = input.float(0.28, "ER sotto cui il mercato e' RANGE",     minval = 0.0, maxval = 1.0, step = 0.02, group = grpT, tooltip = "Random walk su 20 barre: E[|dnet|]=sigma*sqrt(20)=4.47sigma, E[sum|d|]=20*sigma*sqrt(2/pi)=15.96sigma -> ER mediana del rumore puro = 0.28. Sopra questo valore c'e' direzionalita' reale.")
erTrend  = input.float(0.42, "ER sopra cui il mercato e' TREND",     minval = 0.0, maxval = 1.0, step = 0.02, group = grpT)
extHi    = input.float(80.0, "Percentile estensione alta", minval = 50.0, maxval = 100.0, group = grpT)
extLo    = input.float(20.0, "Percentile estensione bassa", minval = 0.0, maxval = 50.0,  group = grpT)
coolDown = input.int(3, "Barre minime tra segnali omologhi", minval = 1, group = grpT)
clvRej    = input.float(0.45, "Soglia chiusura respinta (climax)", minval = 0.1, maxval = 0.5, step = 0.05, group = grpT)
iniRegime = input.string("Sempre", "Initiative: regime richiesto", options = ["Sempre", "Solo trend", "Solo range"], group = grpT)
iniClv    = input.float(0.60, "Initiative: chiusura minima nel range", minval = 0.50, maxval = 1.0, step = 0.05, group = grpT)

grpD = "4 - Divergenze CVD"
useDiv = input.bool(true, "Attiva divergenze", group = grpD)
pivL   = input.int(5, "Pivot left",  minval = 1, group = grpD)
divRange = input.bool(true, "Divergenze solo fuori dal trend", group = grpD, tooltip = "Una divergenza dentro un trend forte e' la trappola classica: il CVD diverge per meta' movimento mentre il prezzo continua.")
pivR   = input.int(3, "Pivot right", minval = 1, group = grpD, tooltip = "La divergenza si conferma pivR barre DOPO l'estremo. E' lag dichiarato, non repaint.")

grpF = "5 - Filtro sessione"
useSess  = input.bool(true, "Limita alla sessione", group = grpF)
sessStr  = input.session("0700-2000", "Sessione attiva", group = grpF)
skipRoll = input.bool(true, "Escludi rollover broker", group = grpF)
rollStr  = input.session("2255-0105", "Finestra rollover da escludere", group = grpF)

grpQ = "5b - Qualita' (filtri ORTOGONALI al flusso)"
qualMode = input.string("Peso continuo", "Uso degli assi di qualita'", options = ["Off", "Gate binario", "Peso continuo"], group = grpQ, tooltip = "Gate binario: scarta i segnali che non passano. Riduce la frequenza.\nPeso continuo: NON scarta NULLA. Ogni segnale riceve un peso in [0,1] e viene dimensionato in proporzione.\n\nSe gli assi contengono segnale, il peso continuo lo estrae SENZA perdere campione - e la colonna muR-w te lo dimostra.")
mtfPen   = input.float(0.40, "   penalita' disaccordo MTF", minval = 0.0, maxval = 1.0, step = 0.05, group = grpQ)
useCusum = input.bool(true,  "1. Campionamento CUSUM", group = grpQ, tooltip = "Accumula la deviazione di flusso e genera un evento solo quando la somma cumulata supera h, poi azzera. Cattura il flusso PERSISTENTE invece del singolo spike.")
cusumH   = input.float(4.0, "   soglia h", minval = 0.5, step = 0.5, group = grpQ)
cusumWin = input.int(5,     "   validita' evento (barre)", minval = 1, group = grpQ)
useConf  = input.bool(true,  "2. Barra di conferma", group = grpQ, tooltip = "Il segnale vale solo se la barra SUCCESSIVA estende nella direzione del trade. Costo: 1 barra di ritardo.")
useLoc   = input.bool(true,  "3. Contesto di prezzo (VWAP)", group = grpQ)
locMin   = input.float(1.2, "   distanza minima dal VWAP (sigma)", minval = 0.0, step = 0.1, group = grpQ)
useMtf   = input.bool(true,  "4. Accordo multi-timeframe", group = grpQ)
mtfRes   = input.timeframe("5", "   timeframe superiore", group = grpQ)
mtfLen   = input.int(20, "   EMA sul TF superiore", minval = 3, group = grpQ)

// ---------------------------------------------------------------------------
grpAS = "5c - ASM (momentum adattivo)"
asmOn        = input.bool(true, "Attiva segnali ASM", group = grpAS)
asmBaseLen   = input.int(14, "Base Length", minval = 3, group = grpAS)
asmAtrLen    = input.int(14, "ATR Length", minval = 2, group = grpAS)
asmZTh       = input.float(0.8, "Z-Score Base Threshold", step = 0.1, group = grpAS, tooltip = "La soglia effettiva usata per i reversal e' zTh * 1.5 (zExtreme), come nell'originale.")
asmRegLen    = input.int(30, "Regime Window Length", minval = 5, group = grpAS)
asmSlopeMult = input.float(0.1, "Slope Threshold Multiplier", step = 0.05, group = grpAS, tooltip = "Soglia di pendenza espressa in deviazioni standard di prezzo: slopeTh = stdev(close, regLen) * mult. E' gia' auto-scalante, non toccarla per simbolo.")
asmSmooth    = input.int(5, "Z-Score Smoothing (doppia EMA)", minval = 1, group = grpAS)
asmMinBars   = input.int(20, "Min Bars Between Signals", minval = 1, group = grpAS)
asmTrendMode = input.string("Solo cambio stato", "Segnali di TREND", options = ["Solo cambio stato", "Ogni barra"], group = grpAS, tooltip = "ORIGINALE = 'Ogni barra': longTrendSignal era VERO su ogni barra del trend. E' uno STATO, non un evento: come marker e' rumore, come trade e' un ingresso ripetuto. 'Solo cambio stato' spara sulla prima barra del regime.")
asmUseQual   = input.bool(false, "Applica il layer di qualita' anche ad ASM", group = grpAS, tooltip = "Se attivo, i segnali ASM passano dagli stessi filtri (conferma, CUSUM, VWAP, MTF) degli eventi OFE. Default off per misurare ASM nella sua forma originale.")

// ---------------------------------------------------------------------------
grpVo = "5d - Volatilita' (Ferro)"
fvAtrLen    = input.int(14, "ATR Length", minval = 1, group = grpVo)
fvLookback  = input.int(100, "Percentile Lookback (barre)", minval = 20, group = grpVo)
fvSmooth    = input.int(3, "Smoothing EMA", minval = 1, group = grpVo)
fvExpTh     = input.float(1.8, "Soglia Espansione Candela (TR/ATR)", minval = 1.0, step = 0.1, group = grpVo)
fvLowTh     = input.int(30, "Soglia LOW percentile", group = grpVo)
fvHighTh    = input.int(70, "Soglia HIGH percentile", group = grpVo)
fvExtTh     = input.int(90, "Soglia EXTREME percentile", group = grpVo)
fvShowExp   = input.bool(true,  "Marker candela in ESPANSIONE", group = grpVo)
fvExpShape  = input.string("Cerchio", "Forma marker espansione", options = ["Cerchio", "Freccia"], group = grpVo)
fvShowCmp   = input.bool(false, "Marker candela COMPRESSA", group = grpVo, tooltip = "TR/ATR < 0.5 accade su circa un quarto delle barre: acceso, sporca il grafico. Default off.")
fvGate      = input.bool(false, "GATE: blocca i segnali sotto un percentile di volatilita'", group = grpVo, tooltip = "Filtro di contesto ortogonale al flusso: in mercato morto lo spread pesa quanto il movimento atteso e ogni edge viene mangiato dai costi. Attivandolo cambia anche la baseline, quindi il confronto resta onesto.")
fvGateMin   = input.int(25, "   percentile minimo di volatilita'", minval = 0, maxval = 100, group = grpVo)
fvTint      = input.bool(false, "Tinta di sfondo per regime EXTREME", group = grpVo)

grpV = "6 - Validazione (edge measurement)"
showStats = input.bool(true, "Mostra tabella statistiche", group = grpV)
fwdBars   = input.int(20, "Orizzonte forward (barre)", minval = 1, maxval = 200, group = grpV)
costPts   = input.float(2.0, "Costo round-trip (in mintick)", minval = 0.0, step = 0.5, group = grpV, tooltip = "IN TICK, NON IN PIP. Preset:\n  NQ / ES futures : 2\n  EURUSD Raw 5dec : 7\n  XAUUSD          : 25\n  US30 CFD        : 15\nErrore tipico: lasciare 7 su NQ significa 1.75 punti invece di 0.5, cioe' circa 0.5R di costo fittizio su OGNI segnale.")

grpM = "6b - Modello di entrata"
entryMode = input.string("Pullback", "Entrata", options = ["Market", "Pullback", "Breakout"], group = grpM, tooltip = "Market: al close della barra di segnale, cioe' il prezzo peggiore disponibile (baseline).\nPullback: limite CONTRO la direzione. Il mancato fill e' un filtro gratuito.\nBreakout: stop oltre l'estremo della barra di segnale.")
pbATR   = input.float(0.50, "   Pullback: profondita' (x ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = grpM)
fillWin = input.int(5, "   Barre di validita' dell'ordine", minval = 1, maxval = 50, group = grpM)
stopMode = input.string("Strutturale", "Stop", options = ["ATR", "Strutturale"], group = grpM, tooltip = "Strutturale: oltre l'estremo della barra di segnale piu' un buffer. E' l'invalidazione VERA del setup.")
stopBuf = input.float(0.15, "   Buffer oltre l'estremo (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = grpM)
rrTP    = input.float(1.50, "   TP (x rischio)", minval = 0.2, step = 0.1, group = grpM, tooltip = "In MULTIPLI DI RISCHIO. Confrontalo con la colonna MFE: se il MFE mediano e' sotto questo valore, il target non viene mai raggiunto.")

grpU = "7 - Display"
showRegimeBg = input.bool(false, "Sfondo colorato per il regime (ER)", group = grpU)
showDash  = input.bool(true, "Dashboard", group = grpU)
showMarks = input.bool(true, "Marker eventi OFE", group = grpU)
showAsmMk = input.bool(true, "Marker segnali ASM", group = grpU)
wImb = input.float(0.45, "Peso sbilanciamento", minval = 0.0, maxval = 1.0, step = 0.05, group = grpU)
wDz  = input.float(0.35, "Peso delta z",        minval = 0.0, maxval = 1.0, step = 0.05, group = grpU)
wRes = input.float(0.20, "Peso risultato",      minval = 0.0, maxval = 1.0, step = 0.05, group = grpU)

grpA = "8 - Alert"
slATR = input.float(1.5, "SL (x ATR) - solo in modalita' stop ATR", minval = 0.1, step = 0.1, group = grpA)

grpX = "11 - Export per meta-labeling"
useExport = input.bool(false, "Modalita' export (feature vector)", group = grpX, tooltip = "Aggiunge le colonne del feature vector al Data Window. Poi: click destro sul grafico > Esporta dati del grafico > CSV. Le etichette NON si esportano: le calcola Python dalle OHLC, cosi' la definizione delle barriere resta in un posto solo.")

// ============================================================================
//  UTILITY
// ============================================================================
EPS  = 1e-10
tick = syminfo.mintick
rng  = math.max(high - low, tick)

f_sq(float x) => x / math.sqrt(1.0 + x * x)          // soft-clip continuo a (-1,1)

f_rz(float src, simple int len) =>                    // z robusto su finestra LAGGATA
    s1  = src[1]
    med = ta.median(s1, len)
    mad = ta.median(math.abs(s1 - med), len)
    0.6745 * (src - med) / math.max(mad, EPS)

f_n2(float v) => na(v) ? "n/a" : str.tostring(math.round(v, 2))
f_n0(float v) => na(v) ? "n/a" : str.tostring(math.round(v, 0))
f_rr(float v) => na(v) ? "n/a" : (v >= 0 ? "+" : "") + str.tostring(math.round(v, 2)) + "R"

// ============================================================================
//  1) MOTORE DELTA
// ============================================================================
bodyR   = (close - open) / rng
upperWk = high - math.max(close, open)
lowerWk = math.min(close, open) - low
wickImb = (lowerWk - upperWk) / rng
imbGeo  = math.max(-1.0, math.min(1.0, bodyR + wickW * wickImb))

tfSec  = timeframe.in_seconds()
ltfRes = ltfOvr != "auto" ? ltfOvr : tfSec >= 86400 ? "60" : tfSec >= 14400 ? "15" : tfSec >= 3600 ? "5" : tfSec >= 600 ? "1" : "5S"

[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfRes, [open, close, volume])

f_ltfImb() =>
    float up = 0.0
    float dn = 0.0
    int   n  = array.size(ltfC)
    if n > 0
        for i = 0 to n - 1
            ci = array.get(ltfC, i)
            oi = array.get(ltfO, i)
            vi = nz(array.get(ltfV, i))
            if ci > oi
                up += vi
            else if ci < oi
                dn += vi
            else
                up += vi * 0.5
                dn += vi * 0.5
    tot = up + dn
    [tot > 0 ? (up - dn) / tot : 0.0, n]

[imbLtf, ltfN] = f_ltfImb()
ltfOk = useLTF and ltfN > 2

imb      = ltfOk ? imbLtf : imbGeo
imbOrtho = ltfOk ? imb : wickW * wickImb
delta    = imb * volume

newDay = nz(ta.change(time("D")), 0) != 0
var float cvd = 0.0
cvd := (anchorCVD and newDay ? 0.0 : nz(cvd[1])) + delta

// ============================================================================
//  2) TRE ASSI ORTOGONALI
// ============================================================================
atrS   = math.max(ta.atr(atrLen), tick)
vz     = f_rz(volume, statLen)          // A. PARTECIPAZIONE
dz     = f_rz(delta,  statLen)          //    (diagnostico)
res    = (close - open) / atrS          // C. RISULTATO
clvPos = (close - low) / rng

// ============================================================================
//  3) REGIME + CONTESTO (Efficiency Ratio)
// ============================================================================
er   = math.abs(close - close[erLen]) / math.max(math.sum(math.abs(ta.change(close)), erLen), tick)
ext  = ta.percentrank(close, extLen)
hiN  = ta.highest(high, extLen)[1]
loN  = ta.lowest(low,  extLen)[1]
newHi = high >= hiN
newLo = low  <= loN

isRange = er < erRange
isTrend = er > erTrend

// ============================================================================
//  3b) BLOCCO ASM  ·  momentum a lunghezza adattiva
// ============================================================================
//  La lunghezza si contrae quando l'ATR corrente supera la sua media (mercato
//  veloce -> finestra corta) e si dilata quando il mercato rallenta. E' un
//  adattamento onesto: la clamp [5, 30] evita che una compressione estrema
//  produca finestre assurde.
asmAtr    = math.max(ta.atr(asmAtrLen), tick)
asmLenRaw = asmBaseLen * ta.sma(asmAtr, asmAtrLen) / asmAtr
asmLenC   = math.round(asmLenRaw)
asmLenC  := na(asmLenC) or asmLenC < 5 ? 5 : asmLenC
asmLenC  := asmLenC > 30 ? 30 : asmLenC
asmLen    = bar_index > 50 ? asmLenC : 14

asmMom  = (close - close[asmLen]) / asmAtr
asmMean = ta.sma(asmMom, asmLen)
asmStd  = ta.stdev(asmMom, asmLen)
asmZraw = asmStd > 0 ? (asmMom - asmMean) / asmStd : 0.0
asmZ    = ta.ema(ta.ema(asmZraw, asmSmooth), asmSmooth)      // doppia EMA

asmAcc  = close - 2 * close[1] + close[2]                    // accelerazione

asmMa       = ta.sma(close, asmRegLen)
asmSlope    = asmMa - asmMa[1]
asmVol      = ta.stdev(close, asmRegLen)
asmSlopeTh  = asmVol * asmSlopeMult
asmTrend    = math.abs(asmSlope) > asmSlopeTh
asmRange    = not asmTrend

// -- stato di trend (originale: vero su OGNI barra del regime) ---------------
asmLongTrSt  = asmTrend and asmSlope >  asmSlopeTh
asmShortTrSt = asmTrend and asmSlope < -asmSlopeTh
// -- evento di trend (default: solo la transizione) --------------------------
asmLongTrRaw  = asmOn and (asmTrendMode == "Ogni barra" ? asmLongTrSt  : (asmLongTrSt  and not asmLongTrSt[1]))
asmShortTrRaw = asmOn and (asmTrendMode == "Ogni barra" ? asmShortTrSt : (asmShortTrSt and not asmShortTrSt[1]))

// -- reversal nel range: z estremo che RIENTRA, con accelerazione concorde ---
asmZExt   = asmZTh * 1.5
asmRevUp  = asmZ < -asmZExt and asmZ > asmZ[1] and asmAcc > 0 and asmRange   // -> LONG
asmRevDn  = asmZ >  asmZExt and asmZ < asmZ[1] and asmAcc < 0 and asmRange   // -> SHORT
asmLongRgRaw  = asmOn and asmRevUp
asmShortRgRaw = asmOn and asmRevDn

// ============================================================================
//  3c) BLOCCO FERRO  ·  stato di volatilita'
// ============================================================================
fvAtr    = ta.atr(fvAtrLen)
fvAtrPct = (fvAtr / close) * 100

// Parkinson: usa l'escursione high/low, quindi cattura la volatilita' reale
// intra-candela invece della sola chiusura. Piu' efficiente del close-to-close.
fvParkF  = 1 / (4 * math.log(2))
fvParkV  = fvParkF * math.pow(math.log(high / low), 2)
fvPark   = math.sqrt(ta.sma(fvParkV, fvAtrLen)) * 100

fvComp   = (fvAtrPct + fvPark) / 2
fvSm     = ta.ema(fvComp, fvSmooth)

fvPct    = ta.percentrank(fvSm, fvLookback)     // scala-invariante: nessuna taratura per simbolo
fvMean   = ta.sma(fvSm, fvLookback)
fvSd     = ta.stdev(fvSm, fvLookback)
fvZ      = fvSd != 0 ? (fvSm - fvMean) / fvSd : 0.0

fvTr     = ta.tr(true)
fvTrAtr  = fvAtr != 0 ? fvTr / fvAtr : 0.0
fvExp    = fvTrAtr > fvExpTh
fvCmp    = fvTrAtr < 0.5

fvRegime = fvPct >= fvExtTh ? "EXTREME" : fvPct >= fvHighTh ? "HIGH" : fvPct >= fvLowTh ? "NORMAL" : "LOW"
fvRegCol = fvPct >= fvExtTh ? color.red : fvPct >= fvHighTh ? color.orange : fvPct >= fvLowTh ? color.gray : color.blue

fvOk = not fvGate or fvPct >= fvGateMin

// ============================================================================
//  4) FILTRO SESSIONE + GATE GLOBALE
// ============================================================================
inSess  = not useSess  or not na(time(timeframe.period, sessStr))
notRoll = not skipRoll or     na(time(timeframe.period, rollStr))
ok      = inSess and notRoll and fvOk and bar_index > statLen + extLen

// ============================================================================
//  4-bis) ASSI DI QUALITA'  ·  tutti ORTOGONALI al flusso
// ============================================================================
//  Stringere vzMin o imbMin NON migliora la qualita': ti muovi lungo la stessa
//  distribuzione, prendi la coda dello stesso segnale, perdi N e perdi la
//  capacita' di misurare. La qualita' si guadagna condizionando su assi
//  INDIPENDENTI. Questi quattro non guardano il delta.
// ============================================================================
xFlow = imb * math.min(math.max(vz, 0.0), 4.0)
var float sPos = 0.0
var float sNeg = 0.0
sPos := math.max(0.0, nz(sPos[1]) + xFlow)
sNeg := math.min(0.0, nz(sNeg[1]) + xFlow)
cusumEvt = sPos > cusumH or sNeg < -cusumH
if cusumEvt
    sPos := 0.0
    sNeg := 0.0
sinceCusum = ta.barssince(cusumEvt)

var float pvSum  = 0.0
var float vSum   = 0.0
var float pv2Sum = 0.0
if newDay
    pvSum  := 0.0
    vSum   := 0.0
    pv2Sum := 0.0
tp3 = hlc3
pvSum  += tp3 * volume
vSum   += volume
pv2Sum += tp3 * tp3 * volume
vwap = vSum > 0 ? pvSum / vSum : close
vwSd = vSum > 0 ? math.sqrt(math.max(pv2Sum / vSum - vwap * vwap, 0.0)) : 0.0
vwZ  = vwSd > 0 ? (close - vwap) / vwSd : 0.0

htfEma = request.security(syminfo.tickerid, mtfRes, ta.ema(close, mtfLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfUp  = close > htfEma

// -- peso continuo in [0,1]: nessun segnale scartato, rischio proporzionato --
//    Media geometrica: basta un asse a zero per azzerare il peso, mentre la
//    media aritmetica lascerebbe che due assi buoni coprano un veto.
f_qw(int dir, bool isFade) =>
    qc  = useCusum ? math.exp(-nz(sinceCusum, 99999) / math.max(cusumWin, 1)) : 1.0
    pos = isFade ? -dir * vwZ : dir * vwZ
    ql  = useLoc ? 1.0 / (1.0 + math.exp(-2.0 * (pos - (isFade ? locMin : 0.0)))) : 1.0
    qm  = useMtf ? ((dir > 0 ? htfUp : not htfUp) ? 1.0 : mtfPen) : 1.0
    math.pow(math.max(qc * ql * qm, 0.0), 1.0 / 3.0)

// -- gate binario / conferma -------------------------------------------------
f_qual(bool raw, int dir, bool isFade) =>
    r   = useConf ? (raw[1] and (dir > 0 ? high > high[1] : low < low[1])) : raw
    cOk = not useCusum or nz(sinceCusum, 99999) <= cusumWin
    lOk = not useLoc or (isFade ? (math.abs(vwZ) >= locMin and dir * vwZ < 0) : dir * vwZ > 0)
    mOk = not useMtf or (dir > 0 ? htfUp : not htfUp)
    qualMode == "Gate binario" ? (r and cOk and lOk and mOk) : r

// ============================================================================
//  5) EVENTI
// ============================================================================
// ---- ABSORPTION : sforzo CONTRO-direzionale senza risultato, in RANGE -------
rawBuyAbs  = ok and isRange and vz > vzMin and imbOrtho >  orthoMin and res < -resMin
rawSellAbs = ok and isRange and vz > vzMin and imbOrtho < -orthoMin and res >  resMin

// ---- EXHAUSTION : climax PRO-trend in estensione, chiusura respinta ---------
rawBullExh = ok and isTrend and vz > vzClimax and newHi and ext > extHi and clvPos < clvRej and imbOrtho < -orthoMin
rawBearExh = ok and isTrend and vz > vzClimax and newLo and ext < extLo and clvPos > 1.0 - clvRej and imbOrtho >  orthoMin

// ---- INITIATIVE : flusso e prezzo allineati, chiusura forte -----------------
iniOk = iniRegime == "Sempre" ? true : iniRegime == "Solo trend" ? isTrend : isRange
rawBullIni = ok and iniOk and vz > vzMin and imb >  imbMin and res >  resMin and clvPos > iniClv
rawBearIni = ok and iniOk and vz > vzMin and imb < -imbMin and res < -resMin and clvPos < 1.0 - iniClv

// ---- DIVERGENCE : CVD vs prezzo su pivot confermati, stessa sessione --------
cvdN = f_rz(cvd, statLen)

var int dayN = 0
if newDay
    dayN += 1
divOk = not divRange or not isTrend
ph = ta.pivothigh(high, pivL, pivR)
pl = ta.pivotlow(low,  pivL, pivR)

var float lastPH  = na
var float prevPH  = na
var float lastPHc = na
var float prevPHc = na
var float lastPL  = na
var float prevPL  = na
var float lastPLc = na
var float prevPLc = na
var int   lastPHd = 0
var int   prevPHd = 0
var int   lastPLd = 0
var int   prevPLd = 0

if not na(ph)
    prevPH  := lastPH
    prevPHc := lastPHc
    prevPHd := lastPHd
    lastPH  := ph
    lastPHc := cvd[pivR]
    lastPHd := dayN
if not na(pl)
    prevPL  := lastPL
    prevPLc := lastPLc
    prevPLd := lastPLd
    lastPL  := pl
    lastPLc := cvd[pivR]
    lastPLd := dayN

rawBearDiv = useDiv and ok and divOk and not na(ph) and not na(prevPH) and lastPHd == prevPHd and lastPH > prevPH and lastPHc < prevPHc
rawBullDiv = useDiv and ok and divOk and not na(pl) and not na(prevPL) and lastPLd == prevPLd and lastPL < prevPL and lastPLc > prevPLc

// ---- de-duplica temporale (ogni call-site ha il proprio stato) --------------
f_gate(bool raw, simple int cd) =>
    var int last = -1000000
    fire = raw and (bar_index - last >= cd)
    if fire
        last := bar_index
    fire

buyAbs  = f_gate(f_qual(rawBuyAbs,   1, true),  coolDown)
sellAbs = f_gate(f_qual(rawSellAbs, -1, true),  coolDown)
bullExh = f_gate(f_qual(rawBullExh, -1, true),  coolDown)   // trade SHORT
bearExh = f_gate(f_qual(rawBearExh,  1, true),  coolDown)   // trade LONG
bullIni = f_gate(f_qual(rawBullIni,  1, false), coolDown)
bearIni = f_gate(f_qual(rawBearIni, -1, false), coolDown)
bullDiv = f_gate(f_qual(rawBullDiv,  1, true),  coolDown)
bearDiv = f_gate(f_qual(rawBearDiv, -1, true),  coolDown)

// ---- ASM: gate temporale proprio (asmMinBars) + layer qualita' opzionale ----
qAsmLR = f_qual(asmLongRgRaw,   1, true)
qAsmSR = f_qual(asmShortRgRaw, -1, true)
qAsmLT = f_qual(asmLongTrRaw,   1, false)
qAsmST = f_qual(asmShortTrRaw, -1, false)

asmLongRg  = f_gate(asmUseQual ? qAsmLR : asmLongRgRaw,   asmMinBars)
asmShortRg = f_gate(asmUseQual ? qAsmSR : asmShortRgRaw,  asmMinBars)
asmLongTr  = f_gate(asmUseQual ? qAsmLT : asmLongTrRaw,   asmMinBars)
asmShortTr = f_gate(asmUseQual ? qAsmST : asmShortTrRaw,  asmMinBars)

// ============================================================================
//  6) SCORE COMPOSITO CONTINUO  [-1, 1]
// ============================================================================
wSum  = math.max(wImb + wDz + wRes, EPS)
score = (wImb * imb + wDz * f_sq(dz / 2.0) + wRes * f_sq(res)) / wSum

// ============================================================================
//  7) VALIDAZIONE  ·  triple barrier, R = rischio reale, netto costi
// ============================================================================
//  Macchina a stati IDLE -> PENDING -> OPEN. Stesso motore per OFE, ASM,
//  benchmark v1 e baseline: i numeri sono confrontabili per costruzione.
// ---------------------------------------------------------------------------
f_trade(bool evt, int dir, float qwIn) =>
    var int   n     = 0
    var int   nSig  = 0
    var int   wins  = 0
    var float sumR  = 0.0
    var float sumFe = 0.0
    var float sumAe = 0.0
    var float sumWR = 0.0
    var float sumW  = 0.0
    var float qw    = 1.0
    var int   st    = 0            // 0 idle · 1 pending · 2 open
    var float px    = 0.0
    var float sHi   = 0.0
    var float sLo   = 0.0
    var float sAtr  = 0.0
    var float ent   = 0.0
    var float slp   = 0.0
    var float tpp   = 0.0
    var float rsk   = 0.0
    var float mfe   = 0.0
    var float mae   = 0.0
    var int   wait  = 0
    var int   held  = 0

    if st == 1
        wait += 1
        fill = entryMode == "Pullback" ? (dir > 0 ? low <= px : high >= px)
                                       : (dir > 0 ? high >= px : low <= px)
        if fill
            ent := px
            slp := stopMode == "Strutturale" ? (dir > 0 ? math.min(sLo, ent) - stopBuf * sAtr : math.max(sHi, ent) + stopBuf * sAtr) : ent - dir * slATR * sAtr
            rsk := math.max(math.abs(ent - slp), tick)
            tpp := ent + dir * rrTP * rsk
            st   := 2
            held := 0
            mfe  := 0.0
            mae  := 0.0
        else if wait >= fillWin
            st := 0

    if st == 2
        held += 1
        mfe := math.max(mfe, dir > 0 ? (high - ent) / rsk : (ent - low)  / rsk)
        mae := math.min(mae, dir > 0 ? (low  - ent) / rsk : (ent - high) / rsk)
        hitSL = dir > 0 ? low  <= slp : high >= slp
        hitTP = dir > 0 ? high >= tpp : low  <= tpp
        float r = na
        if hitSL                       // pessimistico: stessa barra -> vince lo stop
            r := -1.0
        else if hitTP
            r := rrTP
        else if held >= fwdBars
            r := dir * (close - ent) / rsk
        if not na(r)
            r     -= costPts * tick / rsk
            n     += 1
            sumR  += r
            wins  += r > 0 ? 1 : 0
            sumFe += mfe
            sumAe += mae
            sumWR += qw * r
            sumW  += qw
            st    := 0

    if evt and st == 0
        nSig += 1
        qw   := qualMode == "Peso continuo" ? math.max(qwIn, 0.01) : 1.0
        sHi  := high
        sLo  := low
        sAtr := atrS
        wait := 0
        if entryMode == "Market"
            ent := close
            slp := stopMode == "Strutturale" ? (dir > 0 ? math.min(sLo, ent) - stopBuf * sAtr : math.max(sHi, ent) + stopBuf * sAtr) : ent - dir * slATR * sAtr
            rsk := math.max(math.abs(ent - slp), tick)
            tpp := ent + dir * rrTP * rsk
            st   := 2
            held := 0
            mfe  := 0.0
            mae  := 0.0
        else
            px := entryMode == "Pullback" ? close - dir * pbATR * sAtr : (dir > 0 ? sHi + stopBuf * sAtr : sLo - stopBuf * sAtr)
            st := 1

    [n, nSig, n > 0 ? sumR / n : float(na), n > 0 ? 100.0 * wins / n : float(na), n > 0 ? sumFe / n : float(na), n > 0 ? sumAe / n : float(na), sumW > 0 ? sumWR / sumW : float(na)]

// -- BASELINE: ingresso su OGNI barra, stesso modello. Separa l'edge del
//    segnale dalla DERIVA del campione.
warm = bar_index > statLen + extLen and fvOk
[nBL, gBL, rBL, hBL, fBL, aBL, wBL] = f_trade(warm,  1, f_qw( 1, true))
[nBS, gBS, rBS, hBS, fBS, aBS, wBS] = f_trade(warm, -1, f_qw(-1, true))

[nBA, gBA, rBA, hBA, fBA, aBA, wBA] = f_trade(buyAbs,   1, f_qw( 1, true))
[nSA, gSA, rSA, hSA, fSA, aSA, wSA] = f_trade(sellAbs, -1, f_qw(-1, true))
[nBE, gBE, rBE, hBE, fBE, aBE, wBE] = f_trade(bullExh, -1, f_qw(-1, true))   // bull exhaustion -> SHORT
[nRE, gRE, rRE, hRE, fRE, aRE, wRE] = f_trade(bearExh,  1, f_qw( 1, true))   // bear exhaustion -> LONG
[nBI, gBI, rBI, hBI, fBI, aBI, wBI] = f_trade(bullIni,  1, f_qw( 1, false))
[nSI, gSI, rSI, hSI, fSI, aSI, wSI] = f_trade(bearIni, -1, f_qw(-1, false))
[nBD, gBD, rBD, hBD, fBD, aBD, wBD] = f_trade(bullDiv,  1, f_qw( 1, true))
[nSD, gSD, rSD, hSD, fSD, aSD, wSD] = f_trade(bearDiv, -1, f_qw(-1, true))

[nAL, gAL, rAL, hAL, fAL, aAL, wAL] = f_trade(asmLongRg,   1, f_qw( 1, true))
[nAS, gAS, rAS, hAS, fAS, aAS, wAS] = f_trade(asmShortRg, -1, f_qw(-1, true))
[nAT, gAT, rAT, hAT, fAT, aAT, wAT] = f_trade(asmLongTr,   1, f_qw( 1, false))
[nAU, gAU, rAU, hAU, fAU, aAU, wAU] = f_trade(asmShortTr, -1, f_qw(-1, false))

// ============================================================================
//  7-bis) BENCHMARK v1  ·  reimplementazione FEDELE del DVB-EX originale
// ============================================================================
grpB     = "9 - Benchmark v1 (originale)"
showV1   = input.bool(true, "Misura anche i segnali v1", group = grpB)
v1Len    = input.int(20,    "v1 Delta MA Length", minval = 5, group = grpB)
v1SensB  = input.float(2.0, "v1 Bubble Sensitivity",     step = 0.1, group = grpB)
v1SensA  = input.float(1.5, "v1 Absorption Sensitivity", step = 0.1, group = grpB)
v1SensE  = input.float(1.2, "v1 Exhaustion Sensitivity", step = 0.1, group = grpB)
v1UseVol = input.bool(true, "v1 Volume Spike Filter", group = grpB)
v1VolTh  = input.float(1.3, "v1 Volume Threshold", step = 0.1, group = grpB)
v1Align  = input.int(3,     "v1 Flow Confirmation Bars", minval = 1, group = grpB)
v1Cool   = input.int(2,     "v1 Min Bars Between", minval = 1, group = grpB)
showV1Mk = input.bool(false, "Disegna anche i marker v1 (confronto visivo)", group = grpB)

v1BodyRange = high - low
v1UpperWick = high - math.max(close, open)
v1LowerWick = math.min(close, open) - low
v1BuyP  = close > open ? (close - open) + (v1LowerWick * 0.5) : (v1LowerWick * 0.7)
v1SellP = close < open ? (open - close) + (v1UpperWick * 0.5) : (v1UpperWick * 0.7)
v1Raw   = (v1BuyP - v1SellP) * volume
v1Vel   = (close - open) / math.max(v1BodyRange, 0.0001)
v1Delta = v1Raw * (1 + math.abs(v1Vel))

v1MA    = ta.sma(v1Delta, v1Len)
v1SD    = ta.stdev(v1Delta, v1Len)
v1ND    = v1SD > 0 ? (v1Delta - v1MA) / v1SD : 0.0     // z contaminato dalla barra corrente
v1VolMA = ta.sma(volume, v1Len)
v1Spike = not v1UseVol or volume > v1VolMA * v1VolTh
v1ATR   = ta.atr(14)
v1Sig   = math.abs(close - close[1]) > v1ATR * 0.3
v1Up    = close > close[1]
v1Dn    = close < close[1]
v1DPos  = v1Delta > v1MA                                // NB: confronto con la MA, non con zero
v1DNeg  = v1Delta < v1MA
v1Strong = math.abs(v1ND) > v1SensA
v1Mod    = math.abs(v1ND) > v1SensE

v1BuyAbs  = v1Dn and v1DPos and v1Strong and v1Spike and v1Sig
v1SellAbs = v1Up and v1DNeg and v1Strong and v1Spike and v1Sig
v1BullExh = v1Up and v1DNeg and v1Mod and v1Spike and v1Sig and not v1SellAbs
v1BearExh = v1Dn and v1DPos and v1Mod and v1Spike and v1Sig and not v1BuyAbs

v1BullFlowC = v1Up and v1DPos and v1ND >  0.5
v1BearFlowC = v1Dn and v1DNeg and v1ND < -0.5
var int v1BullCnt = 0
var int v1BearCnt = 0
if v1BullFlowC
    v1BullCnt += 1
    v1BearCnt := 0
else if v1BearFlowC
    v1BearCnt += 1
    v1BullCnt := 0
else
    v1BullCnt := 0
    v1BearCnt := 0
v1BullFlow = v1BullCnt == v1Align
v1BearFlow = v1BearCnt == v1Align

v1BullBub = v1ND >  v1SensB and v1Spike and v1Delta > 0 and not v1BuyAbs  and not v1BearExh
v1BearBub = v1ND < -v1SensB and v1Spike and v1Delta < 0 and not v1SellAbs and not v1BullExh

g1BuyAbs  = f_gate(v1BuyAbs,   v1Cool)
g1SellAbs = f_gate(v1SellAbs,  v1Cool)
g1BullExh = f_gate(v1BullExh,  v1Cool)
g1BearExh = f_gate(v1BearExh,  v1Cool)
g1BullFlw = f_gate(v1BullFlow, v1Cool)
g1BearFlw = f_gate(v1BearFlow, v1Cool)
g1BullBub = f_gate(v1BullBub,  v1Cool)
g1BearBub = f_gate(v1BearBub,  v1Cool)

[n1a, g1a, r1a, h1a, f1a, a1a, w1a] = f_trade(g1BuyAbs,   1, f_qw( 1, true))
[n1b, g1b, r1b, h1b, f1b, a1b, w1b] = f_trade(g1SellAbs, -1, f_qw(-1, true))
[n1c, g1c, r1c, h1c, f1c, a1c, w1c] = f_trade(g1BullExh, -1, f_qw(-1, true))
[n1d, g1d, r1d, h1d, f1d, a1d, w1d] = f_trade(g1BearExh,  1, f_qw( 1, true))
[n1e, g1e, r1e, h1e, f1e, a1e, w1e] = f_trade(g1BullFlw,  1, f_qw( 1, true))
[n1f, g1f, r1f, h1f, f1f, a1f, w1f] = f_trade(g1BearFlw, -1, f_qw(-1, true))
[n1g, g1g, r1g, h1g, f1g, a1g, w1g] = f_trade(g1BullBub,  1, f_qw( 1, true))
[n1h, g1h, r1h, h1h, f1h, a1h, w1h] = f_trade(g1BearBub, -1, f_qw(-1, true))

// ============================================================================
//  8) COLORI
// ============================================================================
// CONVENZIONE CROMATICA (semantica, non estetica):
//   VERDE  = il segnale va interpretato LONG
//   ROSSO  = il segnale va interpretato SHORT
//   GIALLO = contesto di volatilita' (candela in espansione), NON e' un trade
// Attenzione: Bull Exhaustion e' un segnale ROSSO (climax rialzista -> short) e
// Bear Exhaustion e' VERDE. Il nome descrive cio' che si esaurisce, il colore
// descrive cio' che si fa. All'operatore serve il secondo.
// La famiglia si distingue per FORMA, la direzione per COLORE.
// -- famiglia LONG (verdi) ---------------------------------------------------
cAbsB = color.new(#00E676, 0)     // Buy Absorption          freccia su
cExhR = color.new(#1DE9B6, 0)     // Bear Exhaustion -> LONG rombo
cIniB = color.new(#66BB6A, 0)     // Bull Initiative         triangolo su
cDivB = color.new(#7CB342, 0)     // Bull Divergence         cerchio
cAsmL = color.new(#00C853, 0)     // ASM Long  (range)       triangolo su
cAsmT = color.new(#A5D6A7, 0)     // ASM Long  (trend)       cerchio

// -- famiglia SHORT (rossi) --------------------------------------------------
cAbsS = color.new(#FF1744, 0)     // Sell Absorption         freccia giu
cExhB = color.new(#D50000, 0)     // Bull Exhaustion -> SHORT rombo
cIniS = color.new(#EF5350, 0)     // Bear Initiative         triangolo giu
cDivS = color.new(#B71C1C, 0)     // Bear Divergence         cerchio
cAsmS = color.new(#C62828, 0)     // ASM Short (range)       triangolo giu
cAsmU = color.new(#EF9A9A, 0)     // ASM Short (trend)       cerchio

// -- contesto (non direzionale) ----------------------------------------------
cVolE = color.new(#FFD600, 0)     // candela in ESPANSIONE   giallo
cVolC = color.new(#40C4FF, 0)     // candela compressa       azzurro

// ============================================================================
//  9) SFONDO
// ============================================================================
bgER  = showRegimeBg ? (isTrend ? color.new(color.blue, 92) : isRange ? color.new(color.orange, 92) : na) : na
bgVol = fvTint and fvPct >= fvExtTh ? color.new(color.red, 90) : na
bgcolor(na(bgVol) ? bgER : bgVol, title = "Regime")

// ============================================================================
// 10) MARKER SUL GRAFICO PREZZO
// ============================================================================
// -- OFE ---------------------------------------------------------------------
plotshape(showMarks and buyAbs,  "Buy Absorption",  shape.arrowup,      location.belowbar, cAbsB, size = size.normal)
plotshape(showMarks and sellAbs, "Sell Absorption", shape.arrowdown,    location.abovebar, cAbsS, size = size.normal)
plotshape(showMarks and bullExh, "Bull Exhaustion", shape.diamond,      location.abovebar, cExhB, size = size.small)
plotshape(showMarks and bearExh, "Bear Exhaustion", shape.diamond,      location.belowbar, cExhR, size = size.small)
plotshape(showMarks and bullIni, "Bull Initiative", shape.triangleup,   location.belowbar, cIniB, size = size.tiny)
plotshape(showMarks and bearIni, "Bear Initiative", shape.triangledown, location.abovebar, cIniS, size = size.tiny)
plotshape(showMarks and bullDiv, "Bull Divergence", shape.circle,       location.belowbar, cDivB, size = size.tiny)
plotshape(showMarks and bearDiv, "Bear Divergence", shape.circle,       location.abovebar, cDivS, size = size.tiny)

// -- ASM ---------------------------------------------------------------------
plotshape(showAsmMk and asmLongRg,  "ASM Long (Range)",   shape.triangleup,   location.belowbar, cAsmL, size = size.small)
plotshape(showAsmMk and asmShortRg, "ASM Short (Range)",  shape.triangledown, location.abovebar, cAsmS, size = size.small)
plotshape(showAsmMk and asmLongTr,  "ASM Long (Trend)",   shape.circle,       location.belowbar, cAsmT, size = size.tiny)
plotshape(showAsmMk and asmShortTr, "ASM Short (Trend)",  shape.circle,       location.abovebar, cAsmU, size = size.tiny)

// -- FERRO: espansione / compressione di candela -----------------------------
plotshape(fvShowExp and fvExp and fvExpShape == "Cerchio", "Candela in Espansione (cerchio)", shape.circle,     location.abovebar, cVolE, size = size.tiny)
plotshape(fvShowExp and fvExp and fvExpShape == "Freccia", "Candela in Espansione (freccia)", shape.arrowup,    location.abovebar, cVolE, size = size.tiny)
plotshape(fvShowCmp and fvCmp, "Candela Compressa", shape.xcross, location.belowbar, cVolC, size = size.tiny)

// -- marker v1 (grigi, confronto visivo) -------------------------------------
cV1L = color.new(#B0BEC5, 20)
cV1S = color.new(#78909C, 20)
plotshape(showV1Mk and g1BuyAbs,  "v1 Buy Abs",   shape.xcross, location.belowbar, cV1L, size = size.tiny)
plotshape(showV1Mk and g1SellAbs, "v1 Sell Abs",  shape.xcross, location.abovebar, cV1S, size = size.tiny)
plotshape(showV1Mk and g1BearExh, "v1 Bear Exh",  shape.cross,  location.belowbar, cV1L, size = size.tiny)
plotshape(showV1Mk and g1BullExh, "v1 Bull Exh",  shape.cross,  location.abovebar, cV1S, size = size.tiny)
plotshape(showV1Mk and g1BullFlw, "v1 Bull Flow", shape.square, location.belowbar, cV1L, size = size.tiny)
plotshape(showV1Mk and g1BearFlw, "v1 Bear Flow", shape.square, location.abovebar, cV1S, size = size.tiny)
plotshape(showV1Mk and g1BullBub, "v1 Bull Bub",  shape.circle, location.belowbar, cV1L, size = size.tiny)
plotshape(showV1Mk and g1BearBub, "v1 Bear Bub",  shape.circle, location.abovebar, cV1S, size = size.tiny)

// ============================================================================
// 11) DASHBOARD + TABELLA EDGE
// ============================================================================
var table tDash = table.new(position.top_right, 3, 11, border_width = 1, bgcolor = color.new(#0B0E11, 12), frame_color = color.new(color.gray, 40), frame_width = 1)
var table tEdge = table.new(position.bottom_right, 8, 27, border_width = 1, bgcolor = color.new(#0B0E11, 12), frame_color = color.new(color.gray, 40), frame_width = 1)

f_edgeRow(table tb, int row, string name, int n, int nsig, float r, float h, float fe, float ae, float rw, float base, color c) =>
    exc = r - base                                     // edge al netto della deriva
    rc  = na(r)   ? color.gray : r   > 0 ? color.lime : color.red
    ec  = na(exc) ? color.gray : exc > 0 ? color.lime : color.red
    nc  = n < 30 ? color.orange : n < 100 ? color.yellow : color.silver
    ns  = nsig > n ? str.tostring(n) + "/" + str.tostring(nsig) : str.tostring(n)
    fc  = na(fe) ? color.gray : fe < rrTP ? color.orange : color.silver
    wc  = na(rw) or na(r) ? color.gray : rw > r ? color.lime : color.red
    table.cell(tb, 0, row, name,      text_color = c,             text_size = size.tiny)
    table.cell(tb, 1, row, ns,        text_color = nc,            text_size = size.tiny)
    table.cell(tb, 2, row, f_n0(h),   text_color = color.silver,  text_size = size.tiny)
    table.cell(tb, 3, row, f_rr(r),   text_color = rc,            text_size = size.tiny)
    table.cell(tb, 4, row, f_rr(exc), text_color = ec,            text_size = size.tiny)
    table.cell(tb, 5, row, f_n2(fe),  text_color = fc,            text_size = size.tiny)
    table.cell(tb, 6, row, f_n2(ae),  text_color = color.silver,  text_size = size.tiny)
    table.cell(tb, 7, row, f_rr(rw),  text_color = wc,            text_size = size.tiny)

f_sep(table tb, int row, string txt) =>
    table.cell(tb, 0, row, txt, text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 1, row, "", text_size = size.tiny)
    table.cell(tb, 2, row, "", text_size = size.tiny)
    table.cell(tb, 3, row, "", text_size = size.tiny)
    table.cell(tb, 4, row, "", text_size = size.tiny)
    table.cell(tb, 5, row, "", text_size = size.tiny)
    table.cell(tb, 6, row, "", text_size = size.tiny)
    table.cell(tb, 7, row, "", text_size = size.tiny)

if barstate.islast and showDash
    hdr = color.new(color.gray, 55)
    table.cell(tDash, 0, 0, "UFE1", bgcolor = hdr, text_color = color.white, text_size = size.small)
    table.cell(tDash, 1, 0, ltfOk ? "LTF " + ltfRes : "GEO", bgcolor = hdr, text_color = ltfOk ? color.lime : color.orange, text_size = size.small)
    table.cell(tDash, 2, 0, ok ? "ON" : "OFF", bgcolor = hdr, text_color = ok ? color.lime : color.red, text_size = size.small)

    table.cell(tDash, 0, 1, "Partecipazione z", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 1, f_n2(vz), text_color = vz > vzClimax ? color.fuchsia : vz > vzMin ? color.yellow : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 1, vz > vzClimax ? "CLIMAX" : vz > vzMin ? "alta" : "normale", text_color = color.gray, text_size = size.tiny)

    table.cell(tDash, 0, 2, "Sbilanciamento", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 2, f_n2(imb), text_color = imb > 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(tDash, 2, 2, "ortho " + f_n2(imbOrtho), text_color = color.gray, text_size = size.tiny)

    table.cell(tDash, 0, 3, "Risultato (ATR)", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 3, f_n2(res), text_color = res > 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(tDash, 2, 3, "clv " + f_n2(clvPos), text_color = color.gray, text_size = size.tiny)

    table.cell(tDash, 0, 4, "Regime (ER)", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 4, f_n2(er), text_color = isTrend ? color.aqua : isRange ? color.orange : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 4, isTrend ? "TREND" : isRange ? "RANGE" : "misto", text_color = isTrend ? color.aqua : color.orange, text_size = size.tiny)

    table.cell(tDash, 0, 5, "Estensione", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 5, f_n0(ext) + "%", text_color = ext > extHi or ext < extLo ? color.fuchsia : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 5, "CVD z " + f_n2(cvdN), text_color = color.aqua, text_size = size.tiny)

    table.cell(tDash, 0, 6, "Score", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 6, f_n2(score), text_color = score > 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(tDash, 2, 6, "VWAP z " + f_n2(vwZ), text_color = math.abs(vwZ) >= locMin ? color.fuchsia : color.gray, text_size = size.tiny)

    // -- riga volatilita' (cio' che resta di Ferro, in forma decisionale) -----
    table.cell(tDash, 0, 7, "Volatilita'", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 7, f_n0(fvPct) + "%", text_color = fvRegCol, text_size = size.tiny)
    table.cell(tDash, 2, 7, fvRegime + "  TR/ATR " + f_n2(fvTrAtr), text_color = fvExp ? cVolE : color.gray, text_size = size.tiny)

    // -- riga ASM ------------------------------------------------------------
    table.cell(tDash, 0, 8, "ASM z (len " + str.tostring(asmLen) + ")", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 8, f_n2(asmZ), text_color = math.abs(asmZ) > asmZTh * 1.5 ? color.fuchsia : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 8, asmTrend ? (asmSlope > 0 ? "TREND up" : "TREND dn") : "RANGE", text_color = asmTrend ? (asmSlope > 0 ? cAsmT : cAsmU) : color.orange, text_size = size.tiny)

    table.cell(tDash, 0, 9, "Vol gate", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 9, fvGate ? (fvOk ? "PASS" : "BLOCK") : "off", text_color = fvGate ? (fvOk ? color.lime : color.red) : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 9, "z vol " + f_n2(fvZ), text_color = color.gray, text_size = size.tiny)

    ev  = buyAbs ? "BUY ABS" : sellAbs ? "SELL ABS" : bullExh ? "BULL EXH" : bearExh ? "BEAR EXH" : bullIni ? "BULL INI" : bearIni ? "BEAR INI" : bullDiv ? "BULL DIV" : bearDiv ? "BEAR DIV" : asmLongRg ? "ASM L-RG" : asmShortRg ? "ASM S-RG" : asmLongTr ? "ASM L-TR" : asmShortTr ? "ASM S-TR" : "-"
    evc = buyAbs ? cAbsB : sellAbs ? cAbsS : bullExh ? cExhB : bearExh ? cExhR : bullIni ? cIniB : bearIni ? cIniS : bullDiv ? cDivB : bearDiv ? cDivS : asmLongRg ? cAsmL : asmShortRg ? cAsmS : asmLongTr ? cAsmT : asmShortTr ? cAsmU : color.gray
    table.cell(tDash, 0, 10, "EVENTO", text_color = color.white, text_size = size.tiny)
    table.cell(tDash, 1, 10, ev, text_color = evc, text_size = size.tiny)
    table.cell(tDash, 2, 10, fvExp ? "EXPANSION" : "", text_color = cVolE, text_size = size.tiny)

if barstate.islast and showStats
    hdr2 = color.new(color.gray, 55)
    table.cell(tEdge, 0, 0, entryMode + " " + str.tostring(dayN) + "gg", bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 1, 0, "N",       bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 2, 0, "Hit%",    bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 3, 0, "muR",     bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 4, 0, "vs base", bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 5, 0, "MFE",     bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 6, 0, "MAE",     bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 7, 0, "muR-w",   bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    f_edgeRow(tEdge, 1, "Buy Abs",  nBA, gBA, rBA, hBA, fBA, aBA, wBA, rBL, cAbsB)
    f_edgeRow(tEdge, 2, "Sell Abs", nSA, gSA, rSA, hSA, fSA, aSA, wSA, rBS, cAbsS)
    f_edgeRow(tEdge, 3, "Bull Exh", nBE, gBE, rBE, hBE, fBE, aBE, wBE, rBS, cExhB)
    f_edgeRow(tEdge, 4, "Bear Exh", nRE, gRE, rRE, hRE, fRE, aRE, wRE, rBL, cExhR)
    f_edgeRow(tEdge, 5, "Bull Ini", nBI, gBI, rBI, hBI, fBI, aBI, wBI, rBL, cIniB)
    f_edgeRow(tEdge, 6, "Bear Ini", nSI, gSI, rSI, hSI, fSI, aSI, wSI, rBS, cIniS)
    f_edgeRow(tEdge, 7, "Bull Div", nBD, gBD, rBD, hBD, fBD, aBD, wBD, rBL, cDivB)
    f_edgeRow(tEdge, 8, "Bear Div", nSD, gSD, rSD, hSD, fSD, aSD, wSD, rBS, cDivS)
    f_sep(tEdge, 9, "-- ASM --")
    f_edgeRow(tEdge, 10, "ASM L rg", nAL, gAL, rAL, hAL, fAL, aAL, wAL, rBL, cAsmL)
    f_edgeRow(tEdge, 11, "ASM S rg", nAS, gAS, rAS, hAS, fAS, aAS, wAS, rBS, cAsmS)
    f_edgeRow(tEdge, 12, "ASM L tr", nAT, gAT, rAT, hAT, fAT, aAT, wAT, rBL, cAsmT)
    f_edgeRow(tEdge, 13, "ASM S tr", nAU, gAU, rAU, hAU, fAU, aAU, wAU, rBS, cAsmU)
    f_sep(tEdge, 14, "-- base --")
    f_edgeRow(tEdge, 15, "BASE long",  nBL, gBL, rBL, hBL, fBL, aBL, wBL, rBL, color.gray)
    f_edgeRow(tEdge, 16, "BASE short", nBS, gBS, rBS, hBS, fBS, aBS, wBS, rBS, color.gray)
    if showV1
        f_sep(tEdge, 17, "-- v1 --")
        f_edgeRow(tEdge, 18, "v1 BuyAbs",  n1a, g1a, r1a, h1a, f1a, a1a, w1a, rBL, color.silver)
        f_edgeRow(tEdge, 19, "v1 SellAbs", n1b, g1b, r1b, h1b, f1b, a1b, w1b, rBS, color.silver)
        f_edgeRow(tEdge, 20, "v1 BullExh", n1c, g1c, r1c, h1c, f1c, a1c, w1c, rBS, color.silver)
        f_edgeRow(tEdge, 21, "v1 BearExh", n1d, g1d, r1d, h1d, f1d, a1d, w1d, rBL, color.silver)
        f_edgeRow(tEdge, 22, "v1 BullFlw", n1e, g1e, r1e, h1e, f1e, a1e, w1e, rBL, color.silver)
        f_edgeRow(tEdge, 23, "v1 BearFlw", n1f, g1f, r1f, h1f, f1f, a1f, w1f, rBS, color.silver)
        f_edgeRow(tEdge, 24, "v1 BullBub", n1g, g1g, r1g, h1g, f1g, a1g, w1g, rBL, color.silver)
        f_edgeRow(tEdge, 25, "v1 BearBub", n1h, g1h, r1h, h1h, f1h, a1h, w1h, rBS, color.silver)

// ============================================================================
// 12) ALERT  ·  payload JSON per bridge MT5 / FP Markets
// ============================================================================
f_json(string kind, int dir, bool isFade) =>
    px  = entryMode == "Market"   ? close : entryMode == "Pullback" ? close - dir * pbATR * atrS : (dir > 0 ? high + stopBuf * atrS : low - stopBuf * atrS)
    sl  = stopMode == "Strutturale" ? (dir > 0 ? math.min(low, px) - stopBuf * atrS : math.max(high, px) + stopBuf * atrS) : px - dir * slATR * atrS
    rk  = math.max(math.abs(px - sl), tick)
    tp  = px + dir * rrTP * rk
    ord = entryMode == "Market" ? "market" : entryMode == "Pullback" ? "limit" : "stop"
    '{"sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","evt":"' + kind + '","dir":' + str.tostring(dir) + ',"ord":"' + ord + '","px":' + str.tostring(px, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp":' + str.tostring(tp, format.mintick) + ',"riskpts":' + str.tostring(rk, format.mintick) + ',"validbars":' + str.tostring(fillWin) + ',"atr":' + str.tostring(atrS, format.mintick) + ',"vz":' + str.tostring(vz, "#.##") + ',"imb":' + str.tostring(imb, "#.##") + ',"er":' + str.tostring(er, "#.##") + ',"volpct":' + str.tostring(fvPct, "#.#") + ',"trAtr":' + str.tostring(fvTrAtr, "#.##") + ',"asmz":' + str.tostring(asmZ, "#.##") + ',"score":' + str.tostring(score, "#.##") + ',"qw":' + str.tostring(f_qw(dir, isFade), "#.##") + ',"t":' + str.tostring(time_close, "#") + '}'

if buyAbs
    alert(f_json("BUY_ABSORPTION",   1, true),  alert.freq_once_per_bar_close)
if sellAbs
    alert(f_json("SELL_ABSORPTION", -1, true),  alert.freq_once_per_bar_close)
if bullExh
    alert(f_json("BULL_EXHAUSTION", -1, true),  alert.freq_once_per_bar_close)
if bearExh
    alert(f_json("BEAR_EXHAUSTION",  1, true),  alert.freq_once_per_bar_close)
if bullIni
    alert(f_json("BULL_INITIATIVE",  1, false), alert.freq_once_per_bar_close)
if bearIni
    alert(f_json("BEAR_INITIATIVE", -1, false), alert.freq_once_per_bar_close)
if bullDiv
    alert(f_json("BULL_DIVERGENCE",  1, true),  alert.freq_once_per_bar_close)
if bearDiv
    alert(f_json("BEAR_DIVERGENCE", -1, true),  alert.freq_once_per_bar_close)
if asmLongRg
    alert(f_json("ASM_LONG_RANGE",   1, true),  alert.freq_once_per_bar_close)
if asmShortRg
    alert(f_json("ASM_SHORT_RANGE", -1, true),  alert.freq_once_per_bar_close)
if asmLongTr
    alert(f_json("ASM_LONG_TREND",   1, false), alert.freq_once_per_bar_close)
if asmShortTr
    alert(f_json("ASM_SHORT_TREND", -1, false), alert.freq_once_per_bar_close)

// alert di contesto (non generano ordini: servono a svegliare l'operatore)
alertcondition(fvPct >= fvExtTh,                 "Volatilita' Estrema",     "Regime EXTREME su {{ticker}} {{interval}}")
alertcondition(ta.crossover(fvPct, fvHighTh),    "Ingresso in zona HIGH",   "Volatilita' oltre soglia HIGH su {{ticker}} {{interval}}")
alertcondition(fvTrAtr > fvExpTh,                "Candela in Espansione",   "TR/ATR sopra soglia su {{ticker}} {{interval}}")

// ============================================================================
// 13) EXPORT  ·  feature vector per meta-labeling
// ============================================================================
//  Le feature sono lo STATO AL MOMENTO DEL SEGNALE. Nessuna etichetta qui:
//  l'esito a barriere lo ricostruisce Python dalle OHLC dello stesso CSV.
//
//  sig: famiglia x direzione. Positivo = LONG, negativo = SHORT.
//    1 BuyAbs   -1 SellAbs
//    2 BearExh  -2 BullExh
//    3 BullIni  -3 BearIni
//    4 BullDiv  -4 BearDiv
//    5 ASM long range   -5 ASM short range
//    6 ASM long trend   -6 ASM short trend
// ============================================================================
sigCode = buyAbs ? 1 : sellAbs ? -1 : bearExh ? 2 : bullExh ? -2 : bullIni ? 3 : bearIni ? -3 : bullDiv ? 4 : bearDiv ? -4 : asmLongRg ? 5 : asmShortRg ? -5 : asmLongTr ? 6 : asmShortTr ? -6 : 0
rawCode = rawBuyAbs ? 1 : rawSellAbs ? -1 : rawBearExh ? 2 : rawBullExh ? -2 : rawBullIni ? 3 : rawBearIni ? -3 : rawBullDiv ? 4 : rawBearDiv ? -4 : asmLongRgRaw ? 5 : asmShortRgRaw ? -5 : asmLongTrRaw ? 6 : asmShortTrRaw ? -6 : 0

dd = display.data_window
plot(useExport ? sigCode         : na, "x_sig",     display = dd)
plot(useExport ? rawCode         : na, "x_sigraw",  display = dd)
plot(useExport ? vz              : na, "x_vz",      display = dd)
plot(useExport ? dz              : na, "x_dz",      display = dd)
plot(useExport ? imb             : na, "x_imb",     display = dd)
plot(useExport ? imbOrtho        : na, "x_ortho",   display = dd)
plot(useExport ? res             : na, "x_res",     display = dd)
plot(useExport ? clvPos          : na, "x_clv",     display = dd)
plot(useExport ? er              : na, "x_er",      display = dd)
plot(useExport ? ext             : na, "x_ext",     display = dd)
plot(useExport ? vwZ             : na, "x_vwz",     display = dd)
plot(useExport ? cvdN            : na, "x_cvdz",    display = dd)
plot(useExport ? atrS            : na, "x_atr",     display = dd)
plot(useExport ? (htfUp ? 1 : 0) : na, "x_htf",     display = dd)
plot(useExport ? nz(sinceCusum, 9999) : na, "x_cusumage", display = dd)
plot(useExport ? (hour + minute / 60.0) : na, "x_hour", display = dd)
plot(useExport ? dayofweek       : na, "x_dow",     display = dd)
plot(useExport ? score           : na, "x_score",   display = dd)
plot(useExport ? f_qw(1, true)   : na, "x_qwl",     display = dd)
plot(useExport ? f_qw(-1, true)  : na, "x_qws",     display = dd)
plot(useExport ? (ltfOk ? 1 : 0) : na, "x_ltf",     display = dd)
plot(useExport ? fvPct           : na, "x_volpct",  display = dd)
plot(useExport ? fvTrAtr         : na, "x_trAtr",   display = dd)
plot(useExport ? fvZ             : na, "x_volz",    display = dd)
plot(useExport ? asmZ            : na, "x_asmz",    display = dd)
plot(useExport ? (asmTrend ? math.sign(asmSlope) : 0) : na, "x_asmreg", display = dd)
