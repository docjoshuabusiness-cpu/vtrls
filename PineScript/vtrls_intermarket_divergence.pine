//@version=6
// =============================================================================
//  VTRLS · Intermarket Divergence   v2   (NQ vs ES, tre sezioni)
//  ---------------------------------------------------------------------------
//  PERCHE' NON E' UNA DIVERGENZA PREZZO/OSCILLATORE
//  La divergenza classica confronta il prezzo con una sua TRASFORMAZIONE
//  DETERMINISTICA: %K = (C - min)/(max - min). Quando il prezzo fa un minimo
//  piu' basso ma la finestra si allarga, %K legge meccanicamente piu' in alto.
//  Parte di cio' che viene chiamato divergenza e' aritmetica della finestra di
//  normalizzazione. Due serie di prezzo distinte non possono produrre
//  quell'artefatto: non condividono nessuna normalizzazione.
//
//  COME SI OTTENGONO TRE TIMEFRAME (il punto architetturale)
//  Leggere il riferimento SULLA BARRA DEL PIVOT dello strumento operato
//  richiederebbe un request.security annidato, che Pine vieta. La via d'uscita
//  non e' un'approssimazione, e' una riformulazione:
//    - chiamata A: pivot di PREZZO nel contesto nativo del TF della sezione
//    - chiamata B: pivot del RIFERIMENTO nel suo contesto nativo, stesso TF
//    - il confronto avviene sulla DISTANZA IN BARRE dalla barra corrente
//  Due chiamate separate, stesso timeframe, quindi quel conteggio ha la stessa
//  origine ed e' confrontabile. Nessun annidamento, nessun gradino, nessuna
//  serie ricostruita.
//
//  EFFETTO COLLATERALE: leggendo il riferimento sulle SUE barre invece di
//  campionarlo sull'orologio dello strumento operato, il problema della
//  freschezza del dato sparisce per costruzione. Su barre da 15 secondi ES puo'
//  non stampare per molte barre: campionato sull'orologio di NQ resterebbe
//  fermo e produrrebbe divergenze generate dall'ASSENZA di dati. Nel suo
//  contesto nativo ogni barra e' una barra di ES, e il problema non esiste.
//
//  LE DUE CLASSI, RIDEFINITE SU CIO' CHE ORA E' MISURABILE
//    A  i pivot delle due serie sono allineati entro alignA barre: le due
//       strutture sono contemporanee, e la divergenza e' fra estremi che il
//       mercato ha formato nello stesso momento.
//    B  la disuguaglianza vale ma i pivot sono sfasati fino ad alignMax barre.
//       Divergenza reale ma temporalmente slegata: piu' debole.
//
//  BENCHMARK NULLO: ingressi ciclici senza logica, stesso target e stesso stop.
//  Un setup che non lo batte non ha edge, per quanto convincente sia il grafico.
// =============================================================================
indicator("VTRLS · Intermarket Divergence", "VTRLS XDiv", overlay = true,
     max_labels_count = 500, max_lines_count = 500)

// ─────────────────────── 1 · RIFERIMENTO E CONFRONTO ─────────────────────────
gR = "1 · Riferimento"
refSym = input.symbol("CME_MINI:ES1!", "Simbolo di confronto", group = gR,
     tooltip = "Il grafico e' lo strumento che OPERI (NQ1!), questo e' quello con cui lo confronti (ES1!). Entrambi CME: stessa sessione, stesso abbonamento dati.\n\nAltre coppie sensate: NQ vs RTY, NQ vs YM, ES vs SPY.")
cmpMode = input.string("Prezzo riferimento", "Serie di confronto",
     options = ["Prezzo riferimento", "Z del riferimento", "Stoch riferimento", "Ratio (spread)"], group = gR,
     tooltip = "PREZZO RIFERIMENTO (default): i pivot del prezzo di ES. La domanda e' 'ES ha confermato il minimo?'. Nessun parametro, nessun simbolo esotico, massima robustezza.\n\nZ DEL RIFERIMENTO: gli stessi pivot su ES normalizzato. Detrendizza, utile se ES ha deriva sull'orizzonte osservato.\n\nSTOCH RIFERIMENTO: per confrontare questo indicatore con la versione mono-strumento nello stesso impianto di misura.\n\nRATIO (SPREAD): usa un simbolo spread NQ/ES. Misura direttamente la forza relativa, che e' la lettura piu' pura, ma dipende dal supporto ai simboli spread: storico piu' corto e risoluzioni a secondi spesso non disponibili. Se la tabella mostra N a zero su tutte le sezioni, e' questo il motivo.")
spreadSym = input.string("", "   simbolo spread (vuoto = auto)", group = gR,
     tooltip = "Usato solo dal modo Ratio. Vuoto costruisce automaticamente 'grafico/riferimento'. Compilalo a mano se la costruzione automatica non viene risolta.")
statLen = input.int(200, "Finestra statistica (z-score e soglia)", minval = 20, group = gR)
stoLen  = input.int(14, "Stoch riferimento: %K", inline = "st", minval = 1, group = gR)
stoSm   = input.int(3,  "sm", inline = "st", minval = 1, group = gR)
stoD    = input.int(3,  "%D", inline = "st", minval = 1, group = gR)

// ────────────────────────── 2 · SEZIONI (timeframe) ──────────────────────────
gS = "2 · Sezioni · timeframe da osservare"
e1  = input.bool(true, "S1", inline = "s1", group = gS)
tf1 = input.timeframe("15S", "", inline = "s1", group = gS)
e2  = input.bool(true, "S2", inline = "s2", group = gS)
tf2 = input.timeframe("1", "", inline = "s2", group = gS)
e3  = input.bool(true, "S3", inline = "s3", group = gS)
tf3 = input.timeframe("5", "", inline = "s3", group = gS)
htfConf = input.bool(true, "Solo candele della sezione CHIUSE (no repaint intrabar)", group = gS,
     tooltip = "ACCESO: il segnale viene letto dall'ultima candela CHIUSA della sezione. Costa fino a 1 candela della sezione in piu', ma il marker non appare e scompare durante la formazione, perche' l'ultima delle pvR barre di conferma non e' ancora chiusa.\n\nIrrilevante per una sezione con lo stesso timeframe del grafico.")

// ─────────────────────────── 3 · ANCORAGGIO ──────────────────────────────────
//  LE DUE META' DELLA STESSA FAMIGLIA DI SEGNALI
//  Ancorare i pivot al solo strumento operato scarta meta' dei casi, e con ogni
//  probabilita' la meta' migliore.
//    P  lo strumento operato ESTENDE l'estremo, il riferimento no.
//       "NQ fa un nuovo minimo, ES non lo segue." La forza e' IPOTIZZATA: si
//       deduce dal fatto che il riferimento non conferma.
//    R  il riferimento ESTENDE l'estremo, lo strumento operato no.
//       "ES fa un nuovo minimo, NQ tiene." La forza e' gia' MANIFESTA: NQ ha
//       rifiutato di seguire, e lo si vede nel prezzo, non per deduzione.
//  Significato economico identico, ancoraggio opposto. Sono tenuti separati
//  nelle statistiche proprio per scoprire quale dei due paga davvero.
gA = "3 · Metodo e ancoraggio"
method  = input.string("Entrambi", "Metodo di rilevamento",
     options = ["Pivot", "Pendenza", "Entrambi"], group = gA,
     tooltip = "PIVOT: confronta due estremi DISCRETI. Preciso quando la struttura e' pulita, ma dipende da left/right, distanza minima e allineamento: in un massimo affollato due cime vicine spesso non si qualificano entrambe come pivot, e il setup che a occhio e' ovvio non viene visto.\n\nPENDENZA: regressione lineare sugli estremi in una finestra, e confronto delle due PENDENZE. E' cio' che disegna una riga tracciata a mano sopra un gruppo di massimi. Non ha pivot, quindi non ha distanza minima ne' allineamento: nessuno dei filtri che scartano il caso ovvio. In compenso non individua l'estremo esatto, quindi il livello di ingresso e' meno definito.\n\nENTRAMBI: i due metodi coesistono e la tabella puo' misurarli separatamente. E' cosi' che si scopre quale dei due descrive davvero quello che vedi.")
useAncP = input.bool(true, "P · lo strumento operato estende l'estremo", group = gA)
useAncR = input.bool(true, "R · il riferimento estende l'estremo", group = gA)
slopeL1 = input.int(10, "Pendenza: finestre", inline = "sl", minval = 3, group = gA)
slopeL2 = input.int(20, "", inline = "sl", minval = 3, group = gA)
slopeL3 = input.int(40, "", inline = "sl", minval = 3, group = gA,
     tooltip = "TRE orizzonti, non uno. La divergenza scatta se il disaccordo di pendenza vale su ALMENO UNO dei tre, e il tooltip dice quale.\n\nUna sola finestra e' una scelta arbitraria su quanto indietro guardare: una deriva che dura 12 candele e' invisibile a una finestra da 40, e una che dura 50 viene diluita da una da 10. Scandire piu' orizzonti toglie quell'arbitrio.\n\nE' la stessa idea del confronto contro piu' pivot precedenti, applicata a uno stimatore che usa TUTTE le barre della finestra invece di due soli punti: la differenza fra due estremi e' il modo piu' rumoroso di misurare una pendenza.")
slopeEps = input.float(0.02, "Pendenza: soglia minima (ATR per candela)", minval = 0.001, step = 0.005, group = gA,
     tooltip = "Pendenza minima perche' un lato conti come inclinato, in ATR per candela. Con 0.02 su una finestra di 20 candele la retta percorre 0.4 ATR: una deriva modesta ma inequivocabile.\n\nLe due pendenze devono avere segno OPPOSTO e superare entrambe questa soglia.")
usePiv = method != "Pendenza"
useSlo = method != "Pivot"

// ───────────────────────── 4 · PIVOT E CONFERMA ──────────────────────────────
gP = "4 · Pivot e conferma (per sezione)"
qL1 = input.int(7, "S1 left", inline = "p1", minval = 1, group = gP)
qR1 = input.int(4, "right",   inline = "p1", minval = 1, group = gP)
qL2 = input.int(5, "S2 left", inline = "p2", minval = 1, group = gP)
qR2 = input.int(3, "right",   inline = "p2", minval = 1, group = gP)
qL3 = input.int(4, "S3 left", inline = "p3", minval = 1, group = gP)
qR3 = input.int(2, "right",   inline = "p3", minval = 1, group = gP,
     tooltip = "Geometria del pivot PER SEZIONE. I timeframe bassi hanno microstruttura piu' rumorosa e chiedono piu' barre di conferma; sui timeframe alti ogni barra di conferma costa molto tempo reale, quindi conviene ridurle.\n\nEsempio su grafico 15s: S3 a 5 minuti con right=2 costa 10 minuti di ritardo invece di 15.")
minGap = input.int(5,  "Min candele tra i due pivot", minval = 2, group = gP,
     tooltip = "In candele DELLA SEZIONE, quindi gia' proporzionato alla scala di ciascuna: 5 candele significano 75 secondi su S1 a 15s e 25 minuti su S3 a 5m. Non serve differenziarlo per sezione.")
maxGap = input.int(60, "Max candele tra i due pivot", minval = 3, group = gP)
alignA = input.int(6,  "Classe A: allineamento max fra i pivot (candele)", minval = 0, group = gP,
     tooltip = "Quanto possono essere sfasati nel tempo il pivot del prezzo e quello del riferimento perche' le due strutture siano considerate CONTEMPORANEE.")
alignM = input.int(20, "Classe B: sfasamento massimo tollerato", minval = 1, group = gP)

// ────────────────────────────── 4 · FILTRI ───────────────────────────────────
gF = "4 · Filtri"
minCDelta = input.float(0.10, "Delta minimo del riferimento (x ATR o stdev del riferimento)", minval = 0, group = gF,
     tooltip = "Quanto deve essere marcato l'estremo del riferimento perche' conti.\n\nNei modi a PREZZO la scala e' l'ATR DEL RIFERIMENTO: stessa dimensione fisica della differenza fra due estremi vicini. Nei modi a OSCILLATORE e' la deviazione standard della serie, che per un oscillatore e' la scala naturale.\n\nTIENILO BASSO. La non-conferma interessante e' per definizione un movimento PICCOLO del riferimento: alzare questa soglia non filtra il rumore, seleziona i casi in cui il riferimento si e' mosso molto, che sono l'opposto di cio' che stai cercando.")
atrLen    = input.int(14, "ATR della sezione", minval = 1, group = gF)
minPDelta = input.float(0.15, "Spostamento minimo del prezzo tra i pivot (x ATR sezione)", minval = 0, group = gF)
useBB   = input.bool(true, "Richiedi estremita' di banda di Bollinger", group = gF,
     tooltip = "La posizione del prezzo dentro le sue bande di Bollinger e' uno z-score schiacciato in [0,1], quindi adattivo alla volatilita'. Richiedere che la divergenza avvenga a una estremita' significa richiedere che accada dove il prezzo e' statisticamente TESO, che e' dove il ritorno alla media ha le probabilita' migliori.\n\nE' un filtro di regime, non un filtro di rumore: non rende i segnali piu' puliti, li limita al contesto in cui hanno senso.\n\nMisurato sul piu' recente pivot di PREZZO della sezione, nel suo contesto nativo.")
bbLen   = input.int(20, "   Bollinger lunghezza", inline = "bb", minval = 2, group = gF)
bbMult  = input.float(2.0, "dev", inline = "bb", minval = 0.1, step = 0.1, group = gF)
bbLo    = input.float(0.30, "   BUY se posizione <", minval = 0, maxval = 1, step = 0.05, group = gF)
bbHi    = input.float(0.70, "   SELL se posizione >", minval = 0, maxval = 1, step = 0.05, group = gF)
corrLen   = input.int(100, "Finestra di correlazione", minval = 20, group = gF)
minCorr   = input.float(0.5, "Correlazione minima fra i due strumenti", minval = -1, maxval = 1, step = 0.05, group = gF,
     tooltip = "Sotto questa soglia il legame fra i due strumenti non c'e': una divergenza fra serie scollegate non e' forza relativa, e' rumore. Su NQ/ES in sessione sta tipicamente sopra 0.7; valori bassi segnalano halt, gap o un riferimento sbagliato.")
cooldown  = input.int(20, "Cooldown fra segnali stessa direzione (barre del grafico)", minval = 0, group = gF)
useSess   = input.bool(false, "Filtro sessione", inline = "ss", group = gF)
sess      = input.session("0930-1600", "", inline = "ss", group = gF)

// ─────────────────────── 5 · TRACKER DI ESITO ────────────────────────────────
gT = "5 · Tracker di esito"
trackOn = input.bool(true, "Attiva", group = gT)
horizon = input.int(30, "Orizzonte (candele DELLA SEZIONE)", minval = 3, group = gT,
     tooltip = "Nelle candele della sezione, non del grafico: e' l'unico modo per confrontare timeframe diversi nella stessa tabella.")
targATR = input.float(1.0, "Target (x ATR della sezione)", minval = 0.1, group = gT)
stopATR = input.float(0.7, "Stop (x ATR della sezione)",   minval = 0.1, group = gT)
baseOn  = input.bool(true, "Benchmark nullo (ingressi ciclici)", group = gT)
baseN   = input.int(50, "   una coppia ogni N barre", minval = 5, group = gT)
showTab = input.bool(true, "Mostra tabella", group = gT)
tabDim  = input.string("Metodo Pivot/Pendenza", "Seconda dimensione della tabella",
     options = ["Metodo Pivot/Pendenza", "Ancoraggio P/R", "Classe A/B"], group = gT,
     tooltip = "Sezione x direzione fanno gia' 6 righe; incrociare ANCHE classe e ancoraggio ne farebbe 24, illeggibili e con campioni troppo piccoli. Si misura una dimensione alla volta.\n\nANCORAGGIO P/R per primo: e' la domanda aperta piu' grande. P deduce la forza dal fatto che il riferimento non conferma, R la osserva direttamente nel prezzo. Se R batte P, la meta' dei segnali che prima non rilevavo era quella buona.\n\nCLASSE A/B dopo, per capire quanto conta la contemporaneita' delle due strutture.")

// ────────────────────────────── 6 · GRAFICA ──────────────────────────────────
gV = "6 · Grafica"
cAB = input.color(color.new(#00c853, 0), "Buy A",  inline = "g1", group = gV)
cBB = input.color(color.new(#ffd600, 0), "Buy B",  inline = "g1", group = gV)
cAS = input.color(color.new(#d50000, 0), "Sell A", inline = "g2", group = gV)
cBS = input.color(color.new(#ff9100, 0), "Sell B", inline = "g2", group = gV)
showMiss = input.bool(true, "Marker dei SETUP SCARTATI (diagnostica)", group = gV,
     tooltip = "Disegna una × grigia dove la GEOMETRIA della divergenza c'era ma un filtro l'ha scartata, e nel tooltip nomina il filtro che ha bloccato.\n\nE' lo strumento con cui si tara: senza, un setup che a occhio e' evidente e che l'indicatore non segnala non si distingue da un setup che l'indicatore non ha proprio visto. Da spegnere quando i parametri sono fermi, perche' i setup scartati sono molti piu' dei segnali e consumano il budget delle label.")
drawLines = input.bool(true, "Linea fra i due pivot di prezzo", group = gV,
     tooltip = "Ancorata al TIMESTAMP della barra del pivot nel timeframe della sezione, non a un conteggio di barre convertito: resta esatta anche attraverso gap, aperture di sessione e barre mancanti.")
lblSize   = input.string("tiny", "Dimensione label", options = ["tiny","small","normal"], group = gV)

// ═════════════════════════════ FUNZIONI BASE ═════════════════════════════════
f_z(float s, simple int len) =>
    m = ta.sma(s, len)
    d = ta.stdev(s, len)
    d > 0 ? (s - m) / d : 0.0

// ── PIVOT · si conservano gli ULTIMI K estremi, non solo gli ultimi due ──────
//  Confrontare solo gli ultimi due pivot e' il difetto che rende cieco questo
//  tipo di rilevatore. Fra i due estremi che l'occhio collega ci sono quasi
//  sempre uno o due pivot minori: la coppia che genera la divergenza non e'
//  (1,2) ma (1,3) o (1,4), e guardando solo (1,2) non la si vede mai. Nessuna
//  taratura di soglia puo' rimediare, perche' la coppia giusta non viene
//  proprio esaminata.
//  Qui si conservano quattro estremi per lato e si prova ogni coppia
//  (piu' recente, j-esimo precedente) con j = 1, 2, 3.
//
//  La chiamata sul RIFERIMENTO non restituisce i timestamp: la linea disegnata
//  collega sempre i due estremi di PREZZO, anche quando e' il riferimento ad
//  ancorare il segnale.
f_pivA(simple int pl, simple int pr, simple bool isHigh, simple bool shift) =>
    a  = math.max(ta.atr(atrLen), syminfo.mintick)
    // posizione del prezzo dentro le sue bande: z-score schiacciato in [0,1]
    bbB = ta.sma(close, bbLen)
    bbD = bbMult * ta.stdev(close, bbLen)
    bbP = math.min(math.max((close - (bbB - bbD)) / (2 * bbD + 1e-10), 0), 1)
    pp = isHigh ? ta.pivothigh(high, pl, pr) : ta.pivotlow(low, pl, pr)
    var float v0 = na
    var float v1 = na
    var float v2 = na
    var float v3 = na
    var int   b0 = na
    var int   b1 = na
    var int   b2 = na
    var int   b3 = na
    var float t0 = na
    var float t1 = na
    var float t2 = na
    var float t3 = na
    var float z0 = na
    bool nw = false
    if not na(pp)
        z0 := bbP[pr]
        v3 := v2
        v2 := v1
        v1 := v0
        v0 := pp
        b3 := b2
        b2 := b1
        b1 := b0
        b0 := bar_index - pr
        t3 := t2
        t2 := t1
        t1 := t0
        t0 := time[pr]
        nw := true
    g0 = na(b0) ? na : bar_index - b0
    g1 = na(b1) ? na : bar_index - b1
    g2 = na(b2) ? na : bar_index - b2
    g3 = na(b3) ? na : bar_index - b3
    [shift ? v0[1] : v0, shift ? v1[1] : v1, shift ? v2[1] : v2, shift ? v3[1] : v3,
     shift ? g0[1] : g0, shift ? g1[1] : g1, shift ? g2[1] : g2, shift ? g3[1] : g3,
     shift ? t0[1] : t0, shift ? t1[1] : t1, shift ? t2[1] : t2, shift ? t3[1] : t3,
     shift ? a[1]  : a,  shift ? nw[1] : nw, shift ? z0[1] : z0]

f_pivB(simple int pl, simple int pr, simple bool isHigh, simple bool shift) =>
    usePx = cmpMode == "Prezzo riferimento" or cmpMode == "Ratio (spread)"
    cs = cmpMode == "Z del riferimento" ? f_z(close, statLen) : cmpMode == "Stoch riferimento" ? ta.sma(ta.sma(ta.stoch(close, high, low, stoLen), stoSm), stoD) : close
    // normalizzatore: ATR per un prezzo, deviazione standard per un oscillatore
    sd  = usePx ? math.max(ta.atr(atrLen), syminfo.mintick) : math.max(ta.stdev(cs, statLen), 1e-12)
    src = usePx ? (isHigh ? high : low) : cs
    pp  = isHigh ? ta.pivothigh(src, pl, pr) : ta.pivotlow(src, pl, pr)
    var float v0 = na
    var float v1 = na
    var float v2 = na
    var float v3 = na
    var int   b0 = na
    var int   b1 = na
    var int   b2 = na
    var int   b3 = na
    bool nw = false
    if not na(pp)
        v3 := v2
        v2 := v1
        v1 := v0
        v0 := pp
        b3 := b2
        b2 := b1
        b1 := b0
        b0 := bar_index - pr
        nw := true
    g0 = na(b0) ? na : bar_index - b0
    g1 = na(b1) ? na : bar_index - b1
    g2 = na(b2) ? na : bar_index - b2
    g3 = na(b3) ? na : bar_index - b3
    [shift ? v0[1] : v0, shift ? v1[1] : v1, shift ? v2[1] : v2, shift ? v3[1] : v3,
     shift ? g0[1] : g0, shift ? g1[1] : g1, shift ? g2[1] : g2, shift ? g3[1] : g3,
     shift ? sd[1] : sd, shift ? nw[1] : nw]

// ── PENDENZA · regressione sugli estremi nel contesto nativo della sezione ───
//  E' la formalizzazione della riga tracciata a mano sopra un gruppo di massimi:
//  non cerca due punti, misura l'inclinazione dell'inviluppo. Normalizzata in
//  ATR per candela, quindi confrontabile fra strumenti e fra timeframe.
f_slope1(simple int len) => (ta.linreg(high, len, 0) - ta.linreg(high, len, 1))
f_slope0(simple int len) => (ta.linreg(low,  len, 0) - ta.linreg(low,  len, 1))
f_slope(simple int l1, simple int l2, simple int l3, simple bool shift) =>
    a   = math.max(ta.atr(atrLen), syminfo.mintick)
    h1  = f_slope1(l1) / a
    h2  = f_slope1(l2) / a
    h3  = f_slope1(l3) / a
    o1  = f_slope0(l1) / a
    o2  = f_slope0(l2) / a
    o3  = f_slope0(l3) / a
    [shift ? h1[1] : h1, shift ? h2[1] : h2, shift ? h3[1] : h3,
     shift ? o1[1] : o1, shift ? o2[1] : o2, shift ? o3[1] : o3]

// ═══════════════════════ CONTESTO E CHIAMATE HTF ═════════════════════════════
chartSec = timeframe.in_seconds()
sec1 = timeframe.in_seconds(tf1)
sec2 = timeframe.in_seconds(tf2)
sec3 = timeframe.in_seconds(tf3)
kk1 = int(math.max(1, math.round(sec1 / float(chartSec))))
kk2 = int(math.max(1, math.round(sec2 / float(chartSec))))
kk3 = int(math.max(1, math.round(sec3 / float(chartSec))))

sh1 = htfConf and sec1 > chartSec
sh2 = htfConf and sec2 > chartSec
sh3 = htfConf and sec3 > chartSec

// il modo Ratio usa un simbolo spread; gli altri leggono il riferimento diretto
symB = cmpMode == "Ratio (spread)" ? (spreadSym == "" ? syminfo.tickerid + "/" + refSym : spreadSym) : refSym

[aLv0_1, aLv1_1, aLv2_1, aLv3_1, aLg0_1, aLg1_1, aLg2_1, aLg3_1, aLt0_1, aLt1_1, aLt2_1, aLt3_1, aAtr_1, aLn_1, aBB_1] = request.security(syminfo.tickerid, tf1, f_pivA(qL1, qR1, false, sh1), lookahead = barmerge.lookahead_off)
[aHv0_1, aHv1_1, aHv2_1, aHv3_1, aHg0_1, aHg1_1, aHg2_1, aHg3_1, aHt0_1, aHt1_1, aHt2_1, aHt3_1, aAtrH_1, aHn_1, aBBH_1] = request.security(syminfo.tickerid, tf1, f_pivA(qL1, qR1, true, sh1), lookahead = barmerge.lookahead_off)
[aLv0_2, aLv1_2, aLv2_2, aLv3_2, aLg0_2, aLg1_2, aLg2_2, aLg3_2, aLt0_2, aLt1_2, aLt2_2, aLt3_2, aAtr_2, aLn_2, aBB_2] = request.security(syminfo.tickerid, tf2, f_pivA(qL2, qR2, false, sh2), lookahead = barmerge.lookahead_off)
[aHv0_2, aHv1_2, aHv2_2, aHv3_2, aHg0_2, aHg1_2, aHg2_2, aHg3_2, aHt0_2, aHt1_2, aHt2_2, aHt3_2, aAtrH_2, aHn_2, aBBH_2] = request.security(syminfo.tickerid, tf2, f_pivA(qL2, qR2, true, sh2), lookahead = barmerge.lookahead_off)
[aLv0_3, aLv1_3, aLv2_3, aLv3_3, aLg0_3, aLg1_3, aLg2_3, aLg3_3, aLt0_3, aLt1_3, aLt2_3, aLt3_3, aAtr_3, aLn_3, aBB_3] = request.security(syminfo.tickerid, tf3, f_pivA(qL3, qR3, false, sh3), lookahead = barmerge.lookahead_off)
[aHv0_3, aHv1_3, aHv2_3, aHv3_3, aHg0_3, aHg1_3, aHg2_3, aHg3_3, aHt0_3, aHt1_3, aHt2_3, aHt3_3, aAtrH_3, aHn_3, aBBH_3] = request.security(syminfo.tickerid, tf3, f_pivA(qL3, qR3, true, sh3), lookahead = barmerge.lookahead_off)

[bLv0_1, bLv1_1, bLv2_1, bLv3_1, bLg0_1, bLg1_1, bLg2_1, bLg3_1, bSd_1, bLn_1] = request.security(symB, tf1, f_pivB(qL1, qR1, false, sh1), lookahead = barmerge.lookahead_off)
[bHv0_1, bHv1_1, bHv2_1, bHv3_1, bHg0_1, bHg1_1, bHg2_1, bHg3_1, bSdH_1, bHn_1] = request.security(symB, tf1, f_pivB(qL1, qR1, true, sh1), lookahead = barmerge.lookahead_off)
[bLv0_2, bLv1_2, bLv2_2, bLv3_2, bLg0_2, bLg1_2, bLg2_2, bLg3_2, bSd_2, bLn_2] = request.security(symB, tf2, f_pivB(qL2, qR2, false, sh2), lookahead = barmerge.lookahead_off)
[bHv0_2, bHv1_2, bHv2_2, bHv3_2, bHg0_2, bHg1_2, bHg2_2, bHg3_2, bSdH_2, bHn_2] = request.security(symB, tf2, f_pivB(qL2, qR2, true, sh2), lookahead = barmerge.lookahead_off)
[bLv0_3, bLv1_3, bLv2_3, bLv3_3, bLg0_3, bLg1_3, bLg2_3, bLg3_3, bSd_3, bLn_3] = request.security(symB, tf3, f_pivB(qL3, qR3, false, sh3), lookahead = barmerge.lookahead_off)
[bHv0_3, bHv1_3, bHv2_3, bHv3_3, bHg0_3, bHg1_3, bHg2_3, bHg3_3, bSdH_3, bHn_3] = request.security(symB, tf3, f_pivB(qL3, qR3, true, sh3), lookahead = barmerge.lookahead_off)

[pH1_1, pH2_1, pH3_1, pL1_1, pL2_1, pL3_1] = request.security(syminfo.tickerid, tf1, f_slope(slopeL1, slopeL2, slopeL3, sh1), lookahead = barmerge.lookahead_off)
[pH1_2, pH2_2, pH3_2, pL1_2, pL2_2, pL3_2] = request.security(syminfo.tickerid, tf2, f_slope(slopeL1, slopeL2, slopeL3, sh2), lookahead = barmerge.lookahead_off)
[pH1_3, pH2_3, pH3_3, pL1_3, pL2_3, pL3_3] = request.security(syminfo.tickerid, tf3, f_slope(slopeL1, slopeL2, slopeL3, sh3), lookahead = barmerge.lookahead_off)
[cH1_1, cH2_1, cH3_1, cL1_1, cL2_1, cL3_1] = request.security(symB, tf1, f_slope(slopeL1, slopeL2, slopeL3, sh1), lookahead = barmerge.lookahead_off)
[cH1_2, cH2_2, cH3_2, cL1_2, cL2_2, cL3_2] = request.security(symB, tf2, f_slope(slopeL1, slopeL2, slopeL3, sh2), lookahead = barmerge.lookahead_off)
[cH1_3, cH2_3, cH3_3, cL1_3, cL2_3, cL3_3] = request.security(symB, tf3, f_slope(slopeL1, slopeL2, slopeL3, sh3), lookahead = barmerge.lookahead_off)

// quante candele di ciascuna sezione contiene lo storico caricato: e' questo,
// non il mercato, a limitare il campione delle sezioni alte su un grafico veloce
nb1 = request.security(syminfo.tickerid, tf1, bar_index, lookahead = barmerge.lookahead_off)
nb2 = request.security(syminfo.tickerid, tf2, bar_index, lookahead = barmerge.lookahead_off)
nb3 = request.security(syminfo.tickerid, tf3, bar_index, lookahead = barmerge.lookahead_off)

// guardia di correlazione, al timeframe del grafico
refNow = request.security(refSym, timeframe.period, close, lookahead = barmerge.lookahead_off)
rC   = math.log(close / nz(close[1], close))
rR   = not na(refNow) and not na(refNow[1]) and refNow[1] > 0 ? math.log(refNow / refNow[1]) : 0.0
corr = ta.correlation(rC, rR, corrLen)
corrOk = not na(corr) and corr >= minCorr

// UNA SEZIONE SOTTO IL TIMEFRAME DEL GRAFICO NON E' UN AVVISO, E' UN ERRORE.
// request.security su un timeframe piu' basso restituisce valori INTRABAR: il
// segnale ripinge e le statistiche misurano qualcosa che in tempo reale non
// esisteva. Viene disattivata, non segnalata e lasciata correre.
e1v = e1 and sec1 >= chartSec
e2v = e2 and sec2 >= chartSec
e3v = e3 and sec3 >= chartSec

atrCh  = math.max(ta.atr(atrLen), syminfo.mintick)
inSess = not useSess or not na(time(timeframe.period, sess))
szLbl  = lblSize == "tiny" ? size.tiny : lblSize == "small" ? size.small : size.normal

// ═══════════════════════════ TRACKER DI ESITO ════════════════════════════════
var array<int>   pDir = array.new<int>()
var array<int>   pBkt = array.new<int>()
var array<int>   pBar = array.new<int>()
var array<int>   pHor = array.new<int>()
var array<float> pEnt = array.new<float>()
var array<float> pAtr = array.new<float>()
var array<float> pMfe = array.new<float>()
var array<float> pMae = array.new<float>()
var array<float> stTot = array.new<float>(14, 0)
var array<float> stWin = array.new<float>(14, 0)
var array<float> stMfe = array.new<float>(14, 0)
var array<float> stMae = array.new<float>(14, 0)

f_track(int dir, int bkt, float a, int kBars) =>
    if trackOn and a > 0
        array.push(pDir, dir)
        array.push(pBkt, bkt)
        array.push(pBar, bar_index)
        array.push(pHor, horizon * kBars)
        array.push(pEnt, close)
        array.push(pAtr, a)
        array.push(pMfe, 0.0)
        array.push(pMae, 0.0)

// ═════════════════════════ RICERCA DELLA COPPIA ══════════════════════════════
// indice del pivot della serie B temporalmente piu' vicino a un dato istante
f_nearIdx(array<float> gg, float tgt, int tol) =>
    int best = -1
    float bd = 1e12
    if not na(tgt)
        for i = 0 to array.size(gg) - 1
            x = array.get(gg, i)
            if not na(x)
                d = math.abs(x - tgt)
                if d <= tol and d < bd
                    bd   := d
                    best := i
    best

//  A = serie che ANCORA il segnale: e' lei a estendere l'estremo, e la coppia
//      esaminata e' fatta dai SUOI pivot.
//  B = serie confrontata: deve NON estenderlo, letta sui pivot allineati.
//  Si prova j = 1, 2, 3 e ci si ferma alla prima coppia valida: la piu'
//  recente, cioe' quella con la struttura ancora fresca.
f_search(bool isSell, array<float> av, array<float> ag, array<float> bv, array<float> bg, float thA, float thB) =>
    int jj = -1
    int k0 = -1
    int kj = -1
    i0 = f_nearIdx(bg, array.get(ag, 0), alignM)
    if i0 >= 0 and not na(array.get(av, 0))
        for j = 1 to 3
            if jj < 0
                vj = array.get(av, j)
                gp = nz(array.get(ag, j) - array.get(ag, 0), 0)
                if not na(vj) and gp >= minGap and gp <= maxGap
                    ext = isSell ? array.get(av, 0) > vj + thA : array.get(av, 0) < vj - thA
                    if ext
                        ij = f_nearIdx(bg, array.get(ag, j), alignM)
                        if ij >= 0 and ij != i0
                            b0v = array.get(bv, i0)
                            bjv = array.get(bv, ij)
                            noc = isSell ? b0v < bjv - thB : b0v > bjv + thB
                            if noc
                                jj := j
                                k0 := i0
                                kj := ij
    [jj, k0, kj]

// ═══════════════ VALUTAZIONE DI UNA SEZIONE, LATO GRAFICO ════════════════════
//  Il trigger e' la conferma di UNO QUALSIASI dei due pivot: i due strumenti
//  girano su barre diverse, e attendere solo il prezzo scarta ogni caso in cui
//  e' il riferimento a girare per secondo.
f_eval(bool en, bool isSell, bool nwA, bool nwB,
       array<float> pv, array<float> pg, array<float> pt,
       array<float> cv, array<float> cg,
       float a_atr, float sd, float bbPos, int kBars, int cfg, string tag) =>
    var int last = na
    fr = (nwA and not nwA[1]) or (nwB and not nwB[1])
    dP = minPDelta * a_atr
    th = minCDelta * sd

    int jP = -1
    int kP0 = -1
    int kPj = -1
    if useAncP
        [x1, x2, x3] = f_search(isSell, pv, pg, cv, cg, dP, th)
        jP  := x1
        kP0 := x2
        kPj := x3
    int jR = -1
    int kR0 = -1
    int kRj = -1
    if useAncR and jP < 0
        [y1, y2, y3] = f_search(isSell, cv, cg, pv, pg, th, dP)
        jR  := y1
        kR0 := y2
        kRj := y3

    ancP  = jP >= 0
    found = ancP or jR >= 0

    float pRv = na
    float pOv = na
    float tRv = na
    float tOv = na
    float cRv = na
    float cOv = na
    float dd0 = na
    float dd1 = na
    int   gp  = 0
    if ancP
        pRv := array.get(pv, 0)
        pOv := array.get(pv, jP)
        tRv := array.get(pt, 0)
        tOv := array.get(pt, jP)
        cRv := array.get(cv, kP0)
        cOv := array.get(cv, kPj)
        dd0 := math.abs(array.get(pg, 0)  - array.get(cg, kP0))
        dd1 := math.abs(array.get(pg, jP) - array.get(cg, kPj))
        gp  := int(nz(array.get(pg, jP) - array.get(pg, 0), 0))
    else if jR >= 0
        cRv := array.get(cv, 0)
        cOv := array.get(cv, jR)
        pRv := array.get(pv, kR0)
        pOv := array.get(pv, kRj)
        tRv := array.get(pt, kR0)
        tOv := array.get(pt, kRj)
        dd0 := math.abs(array.get(cg, 0)  - array.get(pg, kR0))
        dd1 := math.abs(array.get(cg, jR) - array.get(pg, kRj))
        gp  := int(nz(array.get(cg, jR) - array.get(cg, 0), 0))

    isA  = dd0 <= alignA and dd1 <= alignA
    // estremita' di banda: misurata sul piu' recente pivot di PREZZO, che con
    // ancoraggio R non e' il pivot che ancora il segnale. E' un'approssimazione
    // voluta: la domanda e' se lo STRUMENTO OPERATO e' teso, non il riferimento.
    zoneOk = not useBB or (isSell ? bbPos >= bbHi : bbPos <= bbLo)
    cool = na(last) or bar_index - last >= cooldown
    fire = en and usePiv and found and fr and cool and corrOk and inSess and zoneOk
    if fire
        last := bar_index
        col = isSell ? (isA ? cAS : cBS) : (isA ? cAB : cBB)
        if drawLines and not na(tRv) and not na(tOv)
            // ancoraggio al TEMPO della barra del pivot: esatto anche con gap
            line.new(int(tOv), pOv, int(tRv), pRv, xloc.bar_time, color = col,
                 width = isA ? 2 : 1, style = isA ? line.style_solid : line.style_dotted)
        label.new(bar_index, isSell ? high : low,
             (isSell ? "▼" : "▲") + (isA ? "A" : "B") + (ancP ? "P " : "R ") + tag,
             xloc.bar_index, isSell ? yloc.abovebar : yloc.belowbar, col,
             isSell ? label.style_label_down : label.style_label_up,
             isSell ? color.white : color.black, szLbl,
             tooltip = (isSell ? "SELL " : "BUY ") + (isA ? "classe A" : "classe B") +
                 (ancP ? " · ancoraggio P (il prezzo estende)" : " · ancoraggio R (il riferimento estende)") + " · " + tag +
                 "\ncoppia pivot (1," + str.tostring((ancP ? jP : jR) + 1) + ")" +
                 "\nprezzo " + str.tostring(pOv, format.mintick) + " → " + str.tostring(pRv, format.mintick) +
                 "\nriferimento " + str.tostring(cOv, "#.####") + " → " + str.tostring(cRv, "#.####") +
                 " (" + str.tostring((cRv - cOv) / sd, "#.00") + ")" +
                 "\ndistanza pivot " + str.tostring(gp) + " · sfasamento " +
                 str.tostring(dd0, "#") + "/" + str.tostring(dd1, "#") +
                 "\nbanda " + str.tostring(bbPos, "#.00") + " · correlazione " + str.tostring(corr, "#.00"))
        dim = tabDim == "Classe A/B" ? (isA ? 0 : 1) : tabDim == "Metodo Pivot/Pendenza" ? 0 : (ancP ? 0 : 1)
        f_track(isSell ? -1 : 1, cfg * 4 + (isSell ? 2 : 0) + dim, a_atr, kBars)

    // ── DIAGNOSTICA: la geometria c'era ma un filtro l'ha scartata ───────────
    if showMiss and en and usePiv and fr and not fire and not na(array.get(pv, 1)) and not na(array.get(cv, 1))
        gv0 = isSell ? (array.get(pv, 0) > array.get(pv, 1) and array.get(cv, 0) < array.get(cv, 1)) : (array.get(pv, 0) < array.get(pv, 1) and array.get(cv, 0) > array.get(cv, 1))
        gv1 = isSell ? (array.get(cv, 0) > array.get(cv, 1) and array.get(pv, 0) < array.get(pv, 1)) : (array.get(cv, 0) < array.get(cv, 1) and array.get(pv, 0) > array.get(pv, 1))
        if gv0 or gv1
            dpx = math.abs(array.get(pv, 0) - array.get(pv, 1)) / a_atr
            drf = math.abs(array.get(cv, 0) - array.get(cv, 1)) / sd
            gg  = nz(array.get(pg, 1) - array.get(pg, 0), 0)
            sf  = math.abs(nz(array.get(pg, 0), 1e9) - nz(array.get(cg, 0), -1e9))
            why = ""
            why := why + (dpx <= minPDelta ? "prezzo<" + str.tostring(minPDelta, "#.00") + " " : "")
            why := why + (drf <= minCDelta ? "rifer.<" + str.tostring(minCDelta, "#.00") + " " : "")
            why := why + (gg < minGap ? "gap<min " : gg > maxGap ? "gap>max " : "")
            why := why + (sf > alignM ? "sfasati " : "")
            why := why + (not corrOk ? "corr " : "")
            why := why + (not cool ? "cooldown " : "")
            why := why + (not zoneOk ? "banda " + str.tostring(bbPos, "#.00") + " " : "")
            label.new(bar_index, isSell ? high : low, "×", xloc.bar_index,
                 isSell ? yloc.abovebar : yloc.belowbar, color.new(color.gray, 100),
                 label.style_none, color.new(color.gray, 25), szLbl,
                 tooltip = "SCARTATO · " + (isSell ? "SELL " : "BUY ") + tag +
                     "\nbloccato da: " + (why == "" ? "nessuna coppia (1,j) valida" : why) +
                     "\ndelta prezzo " + str.tostring(dpx, "#.00") + " ATR (soglia " + str.tostring(minPDelta, "#.00") + ")" +
                     "\ndelta riferimento " + str.tostring(drf, "#.00") + " (soglia " + str.tostring(minCDelta, "#.00") + ")" +
                     "\ndistanza pivot " + str.tostring(gg) + " · sfasamento " + str.tostring(sf, "#") + " (max " + str.tostring(alignM) + ")" +
                     "\ncorrelazione " + str.tostring(corr, "#.00"))
    [fire, isA, ancP]

[b1, b1A, b1P] = f_eval(e1v, false, aLn_1, bLn_1, array.from(aLv0_1, aLv1_1, aLv2_1, aLv3_1), array.from(aLg0_1, aLg1_1, aLg2_1, aLg3_1), array.from(aLt0_1, aLt1_1, aLt2_1, aLt3_1), array.from(bLv0_1, bLv1_1, bLv2_1, bLv3_1), array.from(bLg0_1, bLg1_1, bLg2_1, bLg3_1), aAtr_1, bSd_1, aBB_1, kk1, 0, "S1 " + tf1)
[s1, s1A, s1P] = f_eval(e1v, true,  aHn_1, bHn_1, array.from(aHv0_1, aHv1_1, aHv2_1, aHv3_1), array.from(aHg0_1, aHg1_1, aHg2_1, aHg3_1), array.from(aHt0_1, aHt1_1, aHt2_1, aHt3_1), array.from(bHv0_1, bHv1_1, bHv2_1, bHv3_1), array.from(bHg0_1, bHg1_1, bHg2_1, bHg3_1), aAtrH_1, bSdH_1, aBBH_1, kk1, 0, "S1 " + tf1)
[b2, b2A, b2P] = f_eval(e2v, false, aLn_2, bLn_2, array.from(aLv0_2, aLv1_2, aLv2_2, aLv3_2), array.from(aLg0_2, aLg1_2, aLg2_2, aLg3_2), array.from(aLt0_2, aLt1_2, aLt2_2, aLt3_2), array.from(bLv0_2, bLv1_2, bLv2_2, bLv3_2), array.from(bLg0_2, bLg1_2, bLg2_2, bLg3_2), aAtr_2, bSd_2, aBB_2, kk2, 1, "S2 " + tf2)
[s2, s2A, s2P] = f_eval(e2v, true,  aHn_2, bHn_2, array.from(aHv0_2, aHv1_2, aHv2_2, aHv3_2), array.from(aHg0_2, aHg1_2, aHg2_2, aHg3_2), array.from(aHt0_2, aHt1_2, aHt2_2, aHt3_2), array.from(bHv0_2, bHv1_2, bHv2_2, bHv3_2), array.from(bHg0_2, bHg1_2, bHg2_2, bHg3_2), aAtrH_2, bSdH_2, aBBH_2, kk2, 1, "S2 " + tf2)
[b3, b3A, b3P] = f_eval(e3v, false, aLn_3, bLn_3, array.from(aLv0_3, aLv1_3, aLv2_3, aLv3_3), array.from(aLg0_3, aLg1_3, aLg2_3, aLg3_3), array.from(aLt0_3, aLt1_3, aLt2_3, aLt3_3), array.from(bLv0_3, bLv1_3, bLv2_3, bLv3_3), array.from(bLg0_3, bLg1_3, bLg2_3, bLg3_3), aAtr_3, bSd_3, aBB_3, kk3, 2, "S3 " + tf3)
[s3, s3A, s3P] = f_eval(e3v, true,  aHn_3, bHn_3, array.from(aHv0_3, aHv1_3, aHv2_3, aHv3_3), array.from(aHg0_3, aHg1_3, aHg2_3, aHg3_3), array.from(aHt0_3, aHt1_3, aHt2_3, aHt3_3), array.from(bHv0_3, bHv1_3, bHv2_3, bHv3_3), array.from(bHg0_3, bHg1_3, bHg2_3, bHg3_3), aAtrH_3, bSdH_3, aBBH_3, kk3, 2, "S3 " + tf3)

// ═══════════════════════ SEGNALE DI PENDENZA ═════════════════════════════════
//  Nessun pivot, quindi nessuna distanza minima e nessun allineamento: cadono
//  tutti i filtri che scartano il caso visivamente ovvio. Le due pendenze
//  devono avere segno OPPOSTO e superare entrambe la soglia.
//  Classe A quando entrambe la superano del doppio: inclinazione inequivocabile
//  su tutti e due i lati, non una deriva marginale.
f_slopeSig(bool en, bool isSell, float p1, float p2, float p3, float c1, float c2, float c3,
           float a_atr, float bbPos, int kBars, int cfg, string tag) =>
    var int last = na
    // il disaccordo di pendenza deve valere su ALMENO UNO dei tre orizzonti:
    // una deriva che dura 12 candele e' invisibile a una finestra da 40, e una
    // che dura 50 viene diluita da una da 10. Scandire piu' orizzonti toglie
    // l'arbitrio di scegliere quanto indietro guardare.
    ok1 = isSell ? (p1 < -slopeEps and c1 > slopeEps) : (p1 > slopeEps and c1 < -slopeEps)
    ok2 = isSell ? (p2 < -slopeEps and c2 > slopeEps) : (p2 > slopeEps and c2 < -slopeEps)
    ok3 = isSell ? (p3 < -slopeEps and c3 > slopeEps) : (p3 > slopeEps and c3 < -slopeEps)
    cond = ok1 or ok2 or ok3
    win  = ok1 ? slopeL1 : ok2 ? slopeL2 : slopeL3
    pS   = ok1 ? p1 : ok2 ? p2 : p3
    cS   = ok1 ? c1 : ok2 ? c2 : c3
    zoneOk = not useBB or (isSell ? bbPos >= bbHi : bbPos <= bbLo)
    fr   = cond and not cond[1]
    cool = na(last) or bar_index - last >= cooldown
    fire = en and useSlo and fr and cool and corrOk and inSess and zoneOk and not na(pS) and not na(cS)
    isA  = math.abs(pS) > 2 * slopeEps and math.abs(cS) > 2 * slopeEps
    if fire
        last := bar_index
        col = isSell ? (isA ? cAS : cBS) : (isA ? cAB : cBB)
        label.new(bar_index, isSell ? high : low,
             (isSell ? "▼" : "▲") + "S" + (isA ? "A " : "B ") + tag,
             xloc.bar_index, isSell ? yloc.abovebar : yloc.belowbar, col,
             isSell ? label.style_label_down : label.style_label_up,
             isSell ? color.white : color.black, szLbl,
             tooltip = (isSell ? "SELL " : "BUY ") + "pendenza · classe " + (isA ? "A" : "B") + " · " + tag +
                 "\npendenza prezzo " + str.tostring(pS, "#.0000") + " ATR/candela" +
                 "\npendenza riferimento " + str.tostring(cS, "#.0000") + " ATR/candela" +
                 "\nsoglia " + str.tostring(slopeEps, "#.0000") + " · finestra " + str.tostring(win) +
                 "\nbanda " + str.tostring(bbPos, "#.00") +
                 "\ncorrelazione " + str.tostring(corr, "#.00"))
        // con la tabella su ancoraggio P/R i segnali di pendenza non hanno una
        // colonna sensata e restano fuori dal conteggio, invece di inquinarlo
        if tabDim != "Ancoraggio P/R"
            dim = tabDim == "Classe A/B" ? (isA ? 0 : 1) : 1
            f_track(isSell ? -1 : 1, cfg * 4 + (isSell ? 2 : 0) + dim, a_atr, kBars)
    [fire, isA]

[y1, y1A] = f_slopeSig(e1v, false, pL1_1, pL2_1, pL3_1, cL1_1, cL2_1, cL3_1, aAtr_1, aBB_1, kk1, 0, "S1 " + tf1)
[w1, w1A] = f_slopeSig(e1v, true,  pH1_1, pH2_1, pH3_1, cH1_1, cH2_1, cH3_1, aAtrH_1, aBBH_1, kk1, 0, "S1 " + tf1)
[y2, y2A] = f_slopeSig(e2v, false, pL1_2, pL2_2, pL3_2, cL1_2, cL2_2, cL3_2, aAtr_2, aBB_2, kk2, 1, "S2 " + tf2)
[w2, w2A] = f_slopeSig(e2v, true,  pH1_2, pH2_2, pH3_2, cH1_2, cH2_2, cH3_2, aAtrH_2, aBBH_2, kk2, 1, "S2 " + tf2)
[y3, y3A] = f_slopeSig(e3v, false, pL1_3, pL2_3, pL3_3, cL1_3, cL2_3, cL3_3, aAtr_3, aBB_3, kk3, 2, "S3 " + tf3)
[w3, w3A] = f_slopeSig(e3v, true,  pH1_3, pH2_3, pH3_3, cH1_3, cH2_3, cH3_3, aAtrH_3, aBBH_3, kk3, 2, "S3 " + tf3)

buyA  = (b1 and b1A) or (b2 and b2A) or (b3 and b3A) or (y1 and y1A) or (y2 and y2A) or (y3 and y3A)
buyB  = (b1 and not b1A) or (b2 and not b2A) or (b3 and not b3A) or (y1 and not y1A) or (y2 and not y2A) or (y3 and not y3A)
sellA = (s1 and s1A) or (s2 and s2A) or (s3 and s3A) or (w1 and w1A) or (w2 and w2A) or (w3 and w3A)
sellB = (s1 and not s1A) or (s2 and not s2A) or (s3 and not s3A) or (w1 and not w1A) or (w2 and not w2A) or (w3 and not w3A)

// Il benchmark usa l'ATR e l'orologio DEL GRAFICO. Prima ereditava quelli di
// S1: con S1 a 15 secondi su un grafico a 5 minuti l'ATR era minuscolo, target
// e stop venivano colpiti entrambi sulla prima barra e vinceva sempre lo stop.
// Un benchmark cosi' non e' un riferimento, e' un numero inventato.
if baseOn and bar_index % baseN == 0 and inSess
    f_track(1,  12, atrCh, 1)
    f_track(-1, 13, atrCh, 1)

// ══════════════════════ RISOLUZIONE DEGLI ESITI ══════════════════════════════
if trackOn and array.size(pDir) > 0
    for i = array.size(pDir) - 1 to 0
        ent = array.get(pEnt, i)
        aa  = array.get(pAtr, i)
        dir = array.get(pDir, i)
        mfe = math.max(array.get(pMfe, i), (dir == 1 ? high - ent : ent - low)  / aa)
        mae = math.min(array.get(pMae, i), (dir == 1 ? low  - ent : ent - high) / aa)
        array.set(pMfe, i, mfe)
        array.set(pMae, i, mae)
        age  = bar_index - array.get(pBar, i)
        done = false
        win  = false
        // lo stop viene valutato PRIMA del target: senza dati intrabar e'
        // l'ipotesi conservativa, e sovrastimare l'edge e' l'errore costoso
        if mae <= -stopATR
            done := true
        else if mfe >= targATR
            done := true
            win  := true
        else if age >= array.get(pHor, i)
            done := true
        if done
            bk = array.get(pBkt, i)
            array.set(stTot, bk, array.get(stTot, bk) + 1)
            array.set(stWin, bk, array.get(stWin, bk) + (win ? 1 : 0))
            array.set(stMfe, bk, array.get(stMfe, bk) + mfe)
            array.set(stMae, bk, array.get(stMae, bk) + mae)
            array.remove(pDir, i)
            array.remove(pBkt, i)
            array.remove(pBar, i)
            array.remove(pHor, i)
            array.remove(pEnt, i)
            array.remove(pAtr, i)
            array.remove(pMfe, i)
            array.remove(pMae, i)

// ════════════════════════════════ TABELLA ════════════════════════════════════
var table tb = table.new(position.top_right, 6, 18, border_width = 1)
if showTab and barstate.islast
    hb = color.new(color.gray, 20)
    table.cell(tb, 0, 0, "Setup", text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 1, 0, "TF",    text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 2, 0, "N",     text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 3, 0, "Win%",  text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 4, 0, "MFE",   text_color = color.white, bgcolor = hb, text_size = size.tiny)
    table.cell(tb, 5, 0, "MAE",   text_color = color.white, bgcolor = hb, text_size = size.tiny)
    tfs = array.from(tf1, tf2, tf3)
    ens = array.from(e1v, e2v, e3v)
    be  = stopATR / (targATR + stopATR) * 100
    for b = 0 to 13
        cfg  = int(b / 4)
        kind = b % 4
        isNull = b >= 12
        d0n = tabDim == "Classe A/B" ? "A" : tabDim == "Metodo Pivot/Pendenza" ? "piv" : "P"
        d1n = tabDim == "Classe A/B" ? "B" : tabDim == "Metodo Pivot/Pendenza" ? "pnd" : "R"
        nm = isNull ? (b == 12 ? "NULL Buy" : "NULL Sell") :
             "S" + str.tostring(cfg + 1) + (kind == 0 ? " Buy " + d0n : kind == 1 ? " Buy " + d1n : kind == 2 ? " Sell " + d0n : " Sell " + d1n)
        tfl = isNull ? "rif" : array.get(tfs, cfg)
        act = isNull ? baseOn : array.get(ens, cfg)
        n  = array.get(stTot, b)
        w  = n > 0 ? array.get(stWin, b) / n * 100 : na
        mf = n > 0 ? array.get(stMfe, b) / n : na
        ma = n > 0 ? array.get(stMae, b) / n : na
        cc = not act ? color.gray : isNull ? color.silver :
             kind == 0 ? cAB : kind == 1 ? cBB : kind == 2 ? cAS : cBS
        table.cell(tb, 0, b + 1, nm,  text_color = cc, text_size = size.tiny)
        table.cell(tb, 1, b + 1, tfl, text_color = color.silver, text_size = size.tiny)
        table.cell(tb, 2, b + 1, str.tostring(n, "#"), text_color = n < 30 ? color.orange : color.white, text_size = size.tiny)
        table.cell(tb, 3, b + 1, na(w)  ? "–" : str.tostring(w,  "#.0"), text_color = na(w) ? color.gray : w >= be ? color.lime : color.red, text_size = size.tiny)
        table.cell(tb, 4, b + 1, na(mf) ? "–" : str.tostring(mf, "#.00"), text_color = color.white, text_size = size.tiny)
        table.cell(tb, 5, b + 1, na(ma) ? "–" : str.tostring(ma, "#.00"), text_color = color.white, text_size = size.tiny)
    // una sezione richiesta ma sotto il TF del grafico e' stata DISATTIVATA
    off = (e1 and not e1v) or (e2 and not e2v) or (e3 and not e3v)
    table.cell(tb, 0, 15, off ? "⚠ sez. spenta" : "corr", text_color = off ? color.red : color.silver, text_size = size.tiny)
    table.cell(tb, 1, 15, str.tostring(corr, "#.00"), text_color = corrOk ? color.lime : color.red, text_size = size.tiny)
    table.cell(tb, 2, 15, "pareggio " + str.tostring(be, "#.0") + "%", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 3, 15, "aperti " + str.tostring(array.size(pDir)), text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 4, 15, "orizz " + str.tostring(horizon), text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 5, 15, htfConf ? "chiuse" : "intrabar", text_color = htfConf ? color.silver : color.yellow, text_size = size.tiny)
    table.cell(tb, 0, 16, tabDim, text_color = color.aqua, text_size = size.tiny)
    table.cell(tb, 1, 16, method + (useAncP ? " P" : "") + (useAncR ? "R" : ""), text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 2, 16, "algA " + str.tostring(alignA), text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 3, 16, "algB " + str.tostring(alignM), text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 4, 16, "t " + str.tostring(targATR, "#.0"), text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 5, 16, "s " + str.tostring(stopATR, "#.0"), text_color = color.gray, text_size = size.tiny)
    // storico disponibile per sezione: sotto ~300 candele nessuna statistica
    // e' credibile, e il numero va letto PRIMA delle colonne Win%
    table.cell(tb, 0, 17, "candele sez.", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 17, str.tostring(nb1, "#"), text_color = nb1 < 300 ? color.red : color.lime, text_size = size.tiny)
    table.cell(tb, 2, 17, str.tostring(nb2, "#"), text_color = nb2 < 300 ? color.red : color.lime, text_size = size.tiny)
    table.cell(tb, 3, 17, str.tostring(nb3, "#"), text_color = nb3 < 300 ? color.red : color.lime, text_size = size.tiny)
    table.cell(tb, 4, 17, "rosso = campione", text_color = color.gray, text_size = size.tiny)
    table.cell(tb, 5, 17, "non misurabile", text_color = color.gray, text_size = size.tiny)

// ═══════════════════════════════ ALERT ═══════════════════════════════════════
alertcondition(buyA,  "X-Div BUY classe A",  "VTRLS X-Div: forza relativa rialzista, classe A")
alertcondition((b1 and b1P) or (b2 and b2P) or (b3 and b3P), "X-Div BUY ancoraggio P", "VTRLS X-Div: BUY, il prezzo estende il minimo")
alertcondition((b1 and not b1P) or (b2 and not b2P) or (b3 and not b3P), "X-Div BUY ancoraggio R", "VTRLS X-Div: BUY, il riferimento estende il minimo")
alertcondition((s1 and s1P) or (s2 and s2P) or (s3 and s3P), "X-Div SELL ancoraggio P", "VTRLS X-Div: SELL, il prezzo estende il massimo")
alertcondition((s1 and not s1P) or (s2 and not s2P) or (s3 and not s3P), "X-Div SELL ancoraggio R", "VTRLS X-Div: SELL, il riferimento estende il massimo")
alertcondition(buyB,  "X-Div BUY classe B",  "VTRLS X-Div: forza relativa rialzista, classe B")
alertcondition(sellA, "X-Div SELL classe A", "VTRLS X-Div: debolezza relativa, classe A")
alertcondition(sellB, "X-Div SELL classe B", "VTRLS X-Div: debolezza relativa, classe B")
alertcondition(buyA  or buyB,  "X-Div BUY (qualsiasi)",  "VTRLS X-Div: divergenza rialzista")
alertcondition(sellA or sellB, "X-Div SELL (qualsiasi)", "VTRLS X-Div: divergenza ribassista")

if buyA or buyB or sellA or sellB
    dirT = (buyA or buyB) ? "BUY" : "SELL"
    clsT = (buyA or sellA) ? "A" : "B"
    tfT  = (b1 or s1) ? tf1 : (b2 or s2) ? tf2 : tf3
    alert("VTRLS X-Div " + dirT + " [" + clsT + "] " + tfT + " · " + syminfo.ticker +
         " vs " + refSym + " @ " + str.tostring(close, format.mintick) +
         " | corr " + str.tostring(corr, "#.00"), alert.freq_once_per_bar_close)
