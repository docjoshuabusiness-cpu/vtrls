//@version=6
// ============================================================================
//  ORDER FLOW ENGINE v2  ·  "OFE2"
//  Riscrittura di "Delta Volume + Exhaustion Signals" (DVB-EX v1).
//
//  DIFFERENZE STRUTTURALI RISPETTO ALLA v1
//  ---------------------------------------
//  1) Delta ricostruito dal timeframe INFERIORE (proxy bid/ask reale) con
//     fallback geometrico continuo. Eliminati i coefficienti arbitrari
//     0.5 / 0.7 e la discontinuita' a close == open.
//  2) Statistica ROBUSTA su finestra LAGGATA: mediana/MAD calcolate su
//     delta[1]. Nella v1 la barra corrente entrava nel proprio denominatore,
//     limitando lo z-score a (n-1)/sqrt(n) = 4.25 con n = 20.
//  3) Segno del flusso confrontato con ZERO, non con la media mobile.
//     Nella v1 "isDeltaPositive = currentDelta > deltaMA" classificava come
//     acquisto un delta ancora venditore dentro un downtrend.
//  4) Tre assi ORTOGONALI invece di due test collineari:
//        A. partecipazione  = z(volume)
//        B. sbilanciamento  = delta / volume  in [-1, 1]
//        C. risultato       = (close - open) / ATR
//  5) Filtro di regime (Efficiency Ratio) che ROUTA il tipo di evento:
//        range -> Absorption (fade)   |   trend -> Exhaustion / Initiative
//  6) Absorption ed Exhaustion sono ora eventi realmente distinti. Nella v1
//     erano lo stesso predicato in due bande di z-score adiacenti:
//        bearExhaustion == buyAbsorption con 1.2 < |z| <= 1.5
//  7) Tabella di validazione: forward return NETTO COSTI in unita' ATR,
//     hit rate e MAE per ogni tipo di segnale. Senza misura di edge un
//     indicatore e' decorazione.
//  8) Alert con payload JSON per bridge MT5 / FP Markets.
//
//  NOTA ONESTA SULLA MODALITA' GEOMETRICA
//  --------------------------------------
//  Vale l'identita' esatta   CLV = bodyRatio + wickImbalance
//  quindi l'UNICA informazione non gia' contenuta nella direzione della barra
//  e' lo sbilanciamento delle ombre. Per questo i test di assorbimento usano
//  imbOrtho = imb - bodyRatio e non imb. Senza dati intrabar l'assorbimento
//  e' intrinsecamente poco osservabile: usare la modalita' LTF quando possibile.
// ============================================================================

indicator("Order Flow Engine v2", "OFE2", overlay = false, max_labels_count = 500)

// ============================================================================
//  INPUT
// ============================================================================
grpE = "1 - Motore Delta"
useLTF    = input.bool(true, "Delta da timeframe inferiore (consigliato)", group = grpE, tooltip = "Classifica ogni barra intrabar per close vs open. Piu' informativo della geometria della candela. Serve TF grafico >= 5m per risultati stabili.")
ltfOvr    = input.string("auto", "TF inferiore", options = ["auto", "1S", "5S", "15S", "1", "5", "15"], group = grpE)
wickW     = input.float(1.0, "Peso wick imbalance", minval = 0.0, maxval = 2.0, step = 0.1, group = grpE, tooltip = "Solo modalita' geometrica. Con 1.0 si ottiene esattamente il Close Location Value.")
anchorCVD = input.bool(true, "Ancora il CVD alla sessione giornaliera", group = grpE)

grpS = "2 - Statistica"
statLen = input.int(60, "Finestra stimatori robusti", minval = 20, maxval = 500, group = grpS)
atrLen  = input.int(14, "ATR length", minval = 5, group = grpS)
erLen   = input.int(20, "Efficiency Ratio length", minval = 5, group = grpS)
extLen  = input.int(50, "Lookback estensione / estremi", minval = 10, group = grpS)

grpT = "3 - Soglie eventi"
vzMin    = input.float(1.5,  "Partecipazione minima (z volume)",     minval = 0.0, step = 0.1,  group = grpT)
vzClimax = input.float(2.0,  "Partecipazione climax (z volume)",     minval = 0.0, step = 0.1,  group = grpT)
orthoMin = input.float(0.25, "Sbilanciamento ortogonale minimo",     minval = 0.0, maxval = 1.0, step = 0.05, group = grpT)
imbMin   = input.float(0.35, "Sbilanciamento direzionale minimo",    minval = 0.0, maxval = 1.0, step = 0.05, group = grpT)
resMin   = input.float(0.35, "Risultato minimo (|close-open| / ATR)", minval = 0.0, step = 0.05, group = grpT)
erRange  = input.float(0.28, "ER sotto cui il mercato e' RANGE",     minval = 0.0, maxval = 1.0, step = 0.02, group = grpT, tooltip = "Random walk su 20 barre: E[|dnet|]=sigma*sqrt(20)=4.47sigma, E[sum|d|]=20*sigma*sqrt(2/pi)=15.96sigma -> ER mediana del rumore puro = 0.28. Sopra questo valore c'e' direzionalita' reale.")
erTrend  = input.float(0.42, "ER sopra cui il mercato e' TREND",     minval = 0.0, maxval = 1.0, step = 0.02, group = grpT, tooltip = "0.50 teneva solo il decile superiore e rendeva Exhaustion praticamente inosservabile.")
extHi    = input.float(80.0, "Percentile estensione alta", minval = 50.0, maxval = 100.0, group = grpT)
extLo    = input.float(20.0, "Percentile estensione bassa", minval = 0.0, maxval = 50.0,  group = grpT)
coolDown = input.int(3, "Barre minime tra segnali omologhi", minval = 1, group = grpT)
clvRej    = input.float(0.45, "Soglia chiusura respinta (climax)", minval = 0.1, maxval = 0.5, step = 0.05, group = grpT)
iniRegime = input.string("Sempre", "Initiative: regime richiesto", options = ["Sempre", "Solo trend", "Solo range"], group = grpT, tooltip = "Initiative e' il segnale di CONTINUAZIONE. Il gate 'Solo trend' lo rendeva raro e lasciava il grafico dominato dalle inversioni.")
iniClv    = input.float(0.60, "Initiative: chiusura minima nel range", minval = 0.50, maxval = 1.0, step = 0.05, group = grpT, tooltip = "0.50 = nessun requisito di qualita' sulla chiusura, equivalente alla bubble v1. 0.70 = solo chiusure sull'estremo della barra.")

grpD = "4 - Divergenze CVD"
useDiv = input.bool(true, "Attiva divergenze", group = grpD)
pivL   = input.int(5, "Pivot left",  minval = 1, group = grpD)
divRange = input.bool(true, "Divergenze solo fuori dal trend", group = grpD, tooltip = "Una divergenza dentro un trend forte e' la trappola classica: il CVD diverge per meta' movimento mentre il prezzo continua. Senza questo gate la divergenza spara sistematicamente contro la direzione giusta.")
pivR   = input.int(3, "Pivot right", minval = 1, group = grpD, tooltip = "La divergenza si conferma pivR barre DOPO l'estremo. E' lag dichiarato, non repaint.")

grpF = "5 - Filtro sessione"
useSess  = input.bool(true, "Limita alla sessione", group = grpF)
sessStr  = input.session("0700-2000", "Sessione attiva", group = grpF)
skipRoll = input.bool(true, "Escludi rollover broker", group = grpF)
rollStr  = input.session("2255-0105", "Finestra rollover da escludere", group = grpF)

grpX = "11 - Export per meta-labeling"
useExport = input.bool(false, "Modalita' export (feature vector)", group = grpX, tooltip = "Aggiunge le colonne del feature vector al Data Window. Poi: click destro sul grafico > Esporta dati del grafico > CSV. Le colonne finiscono nel file e vengono lette dallo script Python di training. Le etichette NON si esportano: le calcola Python dalle OHLC, cosi' la definizione delle barriere resta in un posto solo.")

grpQ = "5b - Qualita' (filtri ORTOGONALI al flusso)"
qualMode = input.string("Peso continuo", "Uso degli assi di qualita'", options = ["Off", "Gate binario", "Peso continuo"], group = grpQ, tooltip = "Gate binario: scarta i segnali che non passano. Riduce la frequenza.\nPeso continuo: NON scarta NULLA. Ogni segnale riceve un peso in [0,1] e viene dimensionato in proporzione. Stessa frequenza, rischio concentrato dove il segnale e' forte.\n\nUn filtro binario puo' solo buttare via informazione. Se gli assi contengono segnale, il peso continuo lo estrae SENZA perdere campione - e la colonna muR-w te lo dimostra: se muR-w > muR, gli assi valgono.")
mtfPen   = input.float(0.40, "   penalita' disaccordo MTF", minval = 0.0, maxval = 1.0, step = 0.05, group = grpQ, tooltip = "Peso assegnato quando il TF superiore NON concorda. 0 = equivale a scartare, 1 = MTF ignorato.")
useCusum = input.bool(true,  "1. Campionamento CUSUM", group = grpQ, tooltip = "Invece di 'z sopra soglia su UNA barra', accumula la deviazione di flusso e genera un evento solo quando la somma cumulata supera h, poi azzera. Cattura il flusso PERSISTENTE (qualcuno che lavora un ordine) invece del singolo spike. E' il campionamento a eventi di Lopez de Prado.")
cusumH   = input.float(4.0, "   soglia h", minval = 0.5, step = 0.5, group = grpQ)
cusumWin = input.int(5,     "   validita' evento (barre)", minval = 1, group = grpQ)
useConf  = input.bool(true,  "2. Barra di conferma", group = grpQ, tooltip = "Il segnale non vale alla sua chiusura: vale solo se la barra SUCCESSIVA estende nella direzione del trade. Elimina i segnali che falliscono immediatamente, che sono la maggioranza dei falsi positivi. Costo: 1 barra di ritardo.")
useLoc   = input.bool(true,  "3. Contesto di prezzo (VWAP)", group = grpQ, tooltip = "Le inversioni si prendono solo LONTANO dal valore e verso il valore. Le continuazioni solo dal lato giusto del VWAP di sessione. Asse completamente indipendente dal flusso.")
locMin   = input.float(1.2, "   distanza minima dal VWAP (sigma)", minval = 0.0, step = 0.1, group = grpQ)
useMtf   = input.bool(true,  "4. Accordo multi-timeframe", group = grpQ, tooltip = "Il trade deve concordare con il trend del timeframe superiore. Per le inversioni significa: contro-tendenza sul TF operativo, MA a favore sul TF superiore. E' il pullback classico.")
mtfRes   = input.timeframe("5", "   timeframe superiore", group = grpQ)
mtfLen   = input.int(20, "   EMA sul TF superiore", minval = 3, group = grpQ)

grpV = "6 - Validazione (edge measurement)"
showStats = input.bool(true, "Mostra tabella statistiche", group = grpV)
fwdBars   = input.int(20, "Orizzonte forward (barre)", minval = 1, maxval = 200, group = grpV)
costPts   = input.float(2.0, "Costo round-trip (in mintick)", minval = 0.0, step = 0.5, group = grpV, tooltip = "IN TICK, NON IN PIP. Preset:\n  NQ / ES futures : 2   (1 tick spread + commissioni)\n  EURUSD Raw 5dec : 7\n  XAUUSD          : 25\n  US30 CFD        : 15\nErrore tipico: lasciare 7 su NQ significa 1.75 punti invece di 0.5, cioe' circa 0.5R di costo fittizio su OGNI segnale.")

grpU = "7 - Display"
showPane  = input.bool(true, "Pannello motore", group = grpU)
showDash  = input.bool(true, "Dashboard", group = grpU)
showMarks = input.bool(true, "Marker sul grafico prezzo", group = grpU)
wImb = input.float(0.45, "Peso sbilanciamento", minval = 0.0, maxval = 1.0, step = 0.05, group = grpU)
wDz  = input.float(0.35, "Peso delta z",        minval = 0.0, maxval = 1.0, step = 0.05, group = grpU)
wRes = input.float(0.20, "Peso risultato",      minval = 0.0, maxval = 1.0, step = 0.05, group = grpU)

grpM = "6b - MODELLO DI ENTRATA"
entryMode = input.string("Pullback", "Entrata", options = ["Market", "Pullback", "Breakout"], group = grpM, tooltip = "Market: al close della barra di segnale, cioe' il prezzo peggiore disponibile (baseline di confronto).\nPullback: limite CONTRO la direzione. Se non riempie entro fillWin barre il trade non esiste - il mancato fill e' un filtro gratuito.\nBreakout: stop oltre l'estremo della barra di segnale. Il mercato deve confermare pagando.")
pbATR   = input.float(0.50, "   Pullback: profondita' (x ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = grpM)
fillWin = input.int(5, "   Barre di validita' dell'ordine", minval = 1, maxval = 50, group = grpM)
stopMode = input.string("Strutturale", "Stop", options = ["ATR", "Strutturale"], group = grpM, tooltip = "Strutturale: oltre l'estremo della barra di segnale piu' un buffer. E' l'invalidazione VERA del setup. Stop piu' stretto = R piu' piccolo = lo stesso movimento vale piu' R.")
stopBuf = input.float(0.15, "   Buffer oltre l'estremo (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = grpM)
rrTP    = input.float(1.50, "   TP (x rischio)", minval = 0.2, step = 0.1, group = grpM, tooltip = "In MULTIPLI DI RISCHIO, non in ATR: il rapporto R:R resta costante qualunque sia la distanza dello stop. Confrontalo con la colonna MFE: se il MFE mediano e' sotto questo valore, il target non viene mai raggiunto e va abbassato.")

grpA = "8 - Alert"
slATR = input.float(1.5, "SL (x ATR) - solo in modalita' stop ATR", minval = 0.1, step = 0.1, group = grpA)

// ============================================================================
//  UTILITY
// ============================================================================
EPS  = 1e-10
tick = syminfo.mintick
rng  = math.max(high - low, tick)

// soft-clip continuo a (-1, 1), senza discontinuita'
f_sq(float x) => x / math.sqrt(1.0 + x * x)

// z-score robusto (mediana/MAD) su finestra LAGGATA
f_rz(float src, simple int len) =>
    s1  = src[1]
    med = ta.median(s1, len)
    mad = ta.median(math.abs(s1 - med), len)
    0.6745 * (src - med) / math.max(mad, EPS)

f_n2(float v) => na(v) ? "n/a" : str.tostring(math.round(v, 2))
f_n0(float v) => na(v) ? "n/a" : str.tostring(math.round(v, 0))
f_rr(float v) => na(v) ? "n/a" : (v >= 0 ? "+" : "") + str.tostring(math.round(v, 2)) + "R"

// ============================================================================
//  1) MOTORE DELTA
// ============================================================================
// -- 1a) modalita' geometrica -------------------------------------------------
bodyR   = (close - open) / rng                              // direzionale   [-1,1]
upperWk = high - math.max(close, open)
lowerWk = math.min(close, open) - low
wickImb = (lowerWk - upperWk) / rng                         // ortogonale    [-1,1]
imbGeo  = math.max(-1.0, math.min(1.0, bodyR + wickW * wickImb))

// -- 1b) modalita' timeframe inferiore ---------------------------------------
// TF scelto per essere sempre < TF del grafico (evita runtime error)
tfSec  = timeframe.in_seconds()
ltfRes = ltfOvr != "auto" ? ltfOvr : tfSec >= 86400 ? "60" : tfSec >= 14400 ? "15" : tfSec >= 3600 ? "5" : tfSec >= 600 ? "1" : "5S"

[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfRes, [open, close, volume])

f_ltfImb() =>
    float up = 0.0
    float dn = 0.0
    int   n  = array.size(ltfC)
    if n > 0
        for i = 0 to n - 1
            ci = array.get(ltfC, i)
            oi = array.get(ltfO, i)
            vi = nz(array.get(ltfV, i))
            if ci > oi
                up += vi
            else if ci < oi
                dn += vi
            else
                up += vi * 0.5
                dn += vi * 0.5
    tot = up + dn
    [tot > 0 ? (up - dn) / tot : 0.0, n]

[imbLtf, ltfN] = f_ltfImb()
ltfOk = useLTF and ltfN > 2

// -- 1c) sbilanciamento unificato --------------------------------------------
imb = ltfOk ? imbLtf : imbGeo         // [-1, 1]  chi sta vincendo

// Componente NON deducibile dalla direzione della barra.
//  · modalita' LTF : imb viene dal volume intrabar reale, e' gia' informazione
//                    indipendente -> nessuna ortogonalizzazione.
//  · modalita' GEO : vale CLV = bodyR + wickImb, quindi l'unica informazione
//                    non gia' contenuta nel corpo e' lo sbilanciamento ombre.
// Sottrarre bodyR anche in LTF era un errore dimensionale: imb e' una frazione
// di volume, bodyR un rapporto geometrico. Su barra ribassista bodyR ~ -0.6,
// quindi imb - bodyR superava la soglia su quasi ogni barra ribassista.
imbOrtho = ltfOk ? imb : wickW * wickImb
delta    = imb * volume               // unita' = volume puro (non prezzo x volume)

// -- 1d) CVD ancorato alla sessione ------------------------------------------
newDay = nz(ta.change(time("D")), 0) != 0
var float cvd = 0.0
cvd := (anchorCVD and newDay ? 0.0 : nz(cvd[1])) + delta

// ============================================================================
//  2) TRE ASSI ORTOGONALI
// ============================================================================
atrS   = math.max(ta.atr(atrLen), tick)
vz     = f_rz(volume, statLen)          // A. PARTECIPAZIONE : c'e' qualcuno?
dz     = f_rz(delta,  statLen)          //    (diagnostico)
                                        // B. SBILANCIAMENTO : imb, gia' calcolato
res    = (close - open) / atrS          // C. RISULTATO      : il prezzo ha pagato?
clvPos = (close - low) / rng            // chiusura nel range [0, 1]

// ============================================================================
//  3) REGIME + CONTESTO
// ============================================================================
er   = math.abs(close - close[erLen]) / math.max(math.sum(math.abs(ta.change(close)), erLen), tick)
ext  = ta.percentrank(close, extLen)
hiN  = ta.highest(high, extLen)[1]
loN  = ta.lowest(low,  extLen)[1]
newHi = high >= hiN
newLo = low  <= loN

isRange = er < erRange
isTrend = er > erTrend

// ============================================================================
//  4) FILTRO SESSIONE
// ============================================================================
inSess  = not useSess  or not na(time(timeframe.period, sessStr))
notRoll = not skipRoll or     na(time(timeframe.period, rollStr))
ok      = inSess and notRoll and bar_index > statLen + extLen


// ============================================================================
//  4-bis) ASSI DI QUALITA'  ·  tutti ORTOGONALI al flusso
// ============================================================================
//  Stringere vzMin o imbMin NON migliora la qualita': ti muovi lungo la stessa
//  distribuzione, prendi la coda dello stesso segnale, perdi N e perdi la
//  capacita' di misurare. La qualita' si guadagna condizionando su assi
//  INDIPENDENTI. Questi quattro non guardano il delta.
// ============================================================================

// -- 1) CUSUM : campionamento a eventi ---------------------------------------
//    Flusso efficace = sbilanciamento pesato per partecipazione. La somma
//    cumulata scatta solo quando il flusso e' PERSISTENTE, non quando una
//    singola barra fa uno spike. Reset dopo ogni evento.
xFlow = imb * math.min(math.max(vz, 0.0), 4.0)
var float sPos = 0.0
var float sNeg = 0.0
sPos := math.max(0.0, nz(sPos[1]) + xFlow)
sNeg := math.min(0.0, nz(sNeg[1]) + xFlow)
cusumEvt = sPos > cusumH or sNeg < -cusumH
if cusumEvt
    sPos := 0.0
    sNeg := 0.0
sinceCusum = ta.barssince(cusumEvt)

// -- 2) VWAP di sessione con bande a sigma (contesto di prezzo) --------------
var float pvSum  = 0.0
var float vSum   = 0.0
var float pv2Sum = 0.0
if newDay
    pvSum  := 0.0
    vSum   := 0.0
    pv2Sum := 0.0
tp3 = hlc3
pvSum  += tp3 * volume
vSum   += volume
pv2Sum += tp3 * tp3 * volume
vwap = vSum > 0 ? pvSum / vSum : close
vwSd = vSum > 0 ? math.sqrt(math.max(pv2Sum / vSum - vwap * vwap, 0.0)) : 0.0
vwZ  = vwSd > 0 ? (close - vwap) / vwSd : 0.0

// -- 3) Timeframe superiore (expr[1] = valore chiuso, nessun repaint) --------
htfEma = request.security(syminfo.tickerid, mtfRes, ta.ema(close, mtfLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfUp  = close > htfEma

// -- 4a) PESO CONTINUO  ·  qualita' in [0,1], nessun segnale scartato ---------
//    Un filtro binario puo' solo buttare via informazione. Se questi assi
//    contengono segnale, pesare lo estrae senza perdere campione: il trade
//    debole non si elimina, si prende con meno rischio.
//    Media geometrica: basta un asse a zero per azzerare il peso, mentre la
//    media aritmetica lascerebbe che due assi buoni coprano un veto.
f_qw(int dir, bool isFade) =>
    // quanto e' "fresco" l'evento CUSUM: 1 appena scattato, ->0 allontanandosi
    qc = useCusum ? math.exp(-nz(sinceCusum, 99999) / math.max(cusumWin, 1)) : 1.0
    // posizione rispetto al valore: >0 = lato favorevole al trade
    pos = isFade ? -dir * vwZ : dir * vwZ
    ql  = useLoc ? 1.0 / (1.0 + math.exp(-2.0 * (pos - (isFade ? locMin : 0.0)))) : 1.0
    qm  = useMtf ? ((dir > 0 ? htfUp : not htfUp) ? 1.0 : mtfPen) : 1.0
    math.pow(math.max(qc * ql * qm, 0.0), 1.0 / 3.0)

// -- 4b) Gate binario (solo se qualMode = "Gate binario") --------------------------------------------------------
//    isFade = true  -> segnale di inversione (Absorption, Exhaustion, Divergence)
//    isFade = false -> segnale di continuazione (Initiative)
f_qual(bool raw, int dir, bool isFade) =>
    // conferma: la barra SUCCESSIVA deve estendere nella direzione del trade
    r = useConf ? (raw[1] and (dir > 0 ? high > high[1] : low < low[1])) : raw
    cOk = not useCusum or nz(sinceCusum, 99999) <= cusumWin
    // inversione: solo lontano dal valore E verso il valore
    // continuazione: solo dal lato giusto del valore
    lOk = not useLoc or (isFade ? (math.abs(vwZ) >= locMin and dir * vwZ < 0) : dir * vwZ > 0)
    mOk = not useMtf or (dir > 0 ? htfUp : not htfUp)
    qualMode == "Gate binario" ? (r and cOk and lOk and mOk) : r

// ============================================================================
//  5) EVENTI  (quattro famiglie realmente distinte)
// ============================================================================
// ---- ABSORPTION : sforzo CONTRO-direzionale senza risultato, in RANGE -------
//      il prezzo scende ma il flusso resta compratore -> venditori assorbiti
rawBuyAbs  = ok and isRange and vz > vzMin and imbOrtho >  orthoMin and res < -resMin
rawSellAbs = ok and isRange and vz > vzMin and imbOrtho < -orthoMin and res >  resMin

// ---- EXHAUSTION : climax PRO-trend in estensione, chiusura respinta ---------
//      nuovo estremo + volume climatico + chiusura rifiutata + flusso nascosto
//      contrario. Concettualmente l'upthrust di Wyckoff.
rawBullExh = ok and isTrend and vz > vzClimax and newHi and ext > extHi and clvPos < clvRej and imbOrtho < -orthoMin
rawBearExh = ok and isTrend and vz > vzClimax and newLo and ext < extLo and clvPos > 1.0 - clvRej and imbOrtho >  orthoMin

// ---- INITIATIVE : flusso e prezzo allineati in TREND, chiusura forte --------
// Il gate isTrend rendeva Initiative quasi inosservabile e lasciava la v2
// dominata da segnali di inversione (Absorption, Exhaustion, Divergence: tre
// famiglie su quattro). La continuazione e' un fenomeno reale e distinto -
// lo sbilanciamento di flusso a breve orizzonte e' autocorrelato - e merita
// di essere misurata senza essere strozzata da un filtro di regime.
// Con iniRegime = "Sempre" e iniClv = 0.50 questo e' l'equivalente pulito
// della "bubble" v1: partecipazione + sbilanciamento + displacement, senza
// z-score contaminato e senza doppio conteggio del volume.
iniOk = iniRegime == "Sempre" ? true : iniRegime == "Solo trend" ? isTrend : isRange
rawBullIni = ok and iniOk and vz > vzMin and imb >  imbMin and res >  resMin and clvPos > iniClv
rawBearIni = ok and iniOk and vz > vzMin and imb < -imbMin and res < -resMin and clvPos < 1.0 - iniClv

// ---- DIVERGENCE : CVD normalizzato vs prezzo su pivot confermati ------------
cvdN = f_rz(cvd, statLen)                  // solo per il plot: scala confrontabile

// BUG CORRETTO: i due pivot venivano confrontati sui loro z-score rolling.
// La finestra di normalizzazione si sposta tra un pivot e l'altro, quindi due
// z presi in istanti diversi NON sono confrontabili: un CVD in salita puo'
// mostrare uno z in discesa se la mediana locale e' salita piu' in fretta.
// Il confronto va fatto sui LIVELLI di CVD, e solo se i due pivot cadono
// nella stessa sessione (il CVD si azzera a inizio giornata).
var int dayN = 0
if newDay
    dayN += 1
divOk = not divRange or not isTrend
ph = ta.pivothigh(high, pivL, pivR)
pl = ta.pivotlow(low,  pivL, pivR)

var float lastPH  = na
var float prevPH  = na
var float lastPHc = na
var float prevPHc = na
var float lastPL  = na
var float prevPL  = na
var float lastPLc = na
var float prevPLc = na
var int   lastPHd = 0
var int   prevPHd = 0
var int   lastPLd = 0
var int   prevPLd = 0

if not na(ph)
    prevPH  := lastPH
    prevPHc := lastPHc
    prevPHd := lastPHd
    lastPH  := ph
    lastPHc := cvd[pivR]
    lastPHd := dayN
if not na(pl)
    prevPL  := lastPL
    prevPLc := lastPLc
    prevPLd := lastPLd
    lastPL  := pl
    lastPLc := cvd[pivR]
    lastPLd := dayN

rawBearDiv = useDiv and ok and divOk and not na(ph) and not na(prevPH) and lastPHd == prevPHd and lastPH > prevPH and lastPHc < prevPHc
rawBullDiv = useDiv and ok and divOk and not na(pl) and not na(prevPL) and lastPLd == prevPLd and lastPL < prevPL and lastPLc > prevPLc

// ---- de-duplica temporale (ogni call-site ha il proprio stato) --------------
f_gate(bool raw) =>
    var int last = -1000000
    fire = raw and (bar_index - last >= coolDown)
    if fire
        last := bar_index
    fire

buyAbs  = f_gate(f_qual(rawBuyAbs,   1, true))
sellAbs = f_gate(f_qual(rawSellAbs, -1, true))
bullExh = f_gate(f_qual(rawBullExh, -1, true))   // trade SHORT
bearExh = f_gate(f_qual(rawBearExh,  1, true))   // trade LONG
bullIni = f_gate(f_qual(rawBullIni,  1, false))
bearIni = f_gate(f_qual(rawBearIni, -1, false))
bullDiv = f_gate(f_qual(rawBullDiv,  1, true))
bearDiv = f_gate(f_qual(rawBearDiv, -1, true))

// ============================================================================
//  6) SCORE COMPOSITO CONTINUO  [-1, 1]
// ============================================================================
wSum  = math.max(wImb + wDz + wRes, EPS)
score = (wImb * imb + wDz * f_sq(dz / 2.0) + wRes * f_sq(res)) / wSum

// ============================================================================
//  7) VALIDAZIONE  ·  forward return NETTO COSTI in unita' ATR
// ============================================================================
// La versione precedente misurava il rendimento a fwdBars barre normalizzato
// per l'ATR di UNA barra. Due difetti: (a) ignorava lo stop, quindi contava
// come vincenti trade che nella realta' erano gia' stati chiusi in perdita
// (gli MAE osservati erano -2.3 / -3.4 ATR contro uno SL di 1.5 ATR: OGNI
// trade era stato stoppato), (b) l'unita' "R" non era il rischio assunto.
// Ora: triple barrier (SL / TP / uscita a tempo), R = rischio reale.

// ---------------------------------------------------------------------------
//  MODELLO DI ENTRATA  ·  macchina a stati  IDLE -> PENDING -> OPEN
// ---------------------------------------------------------------------------
//  Entrare al close della barra di segnale e' il prezzo PEGGIORE disponibile:
//  quella barra e' per costruzione ad alto volume e alto displacement, quindi
//  si compra in cima allo spike. Adverse selection pura, e gonfia il rischio
//  (denominatore di R) proprio quando lo si vorrebbe piccolo.
//
//  Tre modelli, misurati tutti dallo stesso motore a barriere:
//    Market    - entrata al close (comportamento precedente, baseline)
//    Pullback  - limite a pbATR ATR CONTRO la direzione del trade. Se non
//                viene riempito entro fillWin barre, il trade non esiste.
//                Il mancato riempimento e' un filtro gratuito: scarta i casi
//                in cui il prezzo scappa senza di te, che sono spesso quelli
//                che poi rientrano.
//    Breakout  - stop oltre l'estremo della barra di segnale. Richiede che il
//                mercato confermi pagando il prezzo, al costo di entrare peggio.
//
//  STOP STRUTTURALE: l'invalidazione naturale di un assorbimento sul minimo e'
//  sotto quel minimo, non a 1.5 ATR arbitrari. Stop piu' stretto = R piu'
//  piccolo = stesso movimento vale piu' R.
//
//  TP espresso in MULTIPLI DI RISCHIO, non in ATR: cosi' il rapporto R:R resta
//  costante qualunque sia la distanza dello stop.
// ---------------------------------------------------------------------------
f_trade(bool evt, int dir, float qwIn) =>
    var int   n     = 0
    var int   nSig  = 0
    var int   wins  = 0
    var float sumR  = 0.0
    var float sumFe = 0.0
    var float sumAe = 0.0
    var float sumWR = 0.0        // rendimento pesato per la qualita'
    var float sumW  = 0.0
    var float qw    = 1.0
    var int   st    = 0            // 0 idle · 1 pending · 2 open
    var float px    = 0.0          // prezzo di entrata desiderato
    var float sHi   = 0.0          // estremi della barra di segnale
    var float sLo   = 0.0
    var float sAtr  = 0.0
    var float ent   = 0.0
    var float slp   = 0.0
    var float tpp   = 0.0
    var float rsk   = 0.0
    var float mfe   = 0.0
    var float mae   = 0.0
    var int   wait  = 0
    var int   held  = 0

    // ---- PENDING: attesa del riempimento ----------------------------------
    if st == 1
        wait += 1
        fill = entryMode == "Pullback" ? (dir > 0 ? low <= px : high >= px)
                                       : (dir > 0 ? high >= px : low <= px)
        if fill
            ent := px
            slp := stopMode == "Strutturale" ? (dir > 0 ? math.min(sLo, ent) - stopBuf * sAtr : math.max(sHi, ent) + stopBuf * sAtr) : ent - dir * slATR * sAtr
            rsk := math.max(math.abs(ent - slp), tick)
            tpp := ent + dir * rrTP * rsk
            st   := 2
            held := 0
            mfe  := 0.0
            mae  := 0.0
        else if wait >= fillWin
            st := 0

    // ---- OPEN: barriere ----------------------------------------------------
    if st == 2
        held += 1
        mfe := math.max(mfe, dir > 0 ? (high - ent) / rsk : (ent - low)  / rsk)
        mae := math.min(mae, dir > 0 ? (low  - ent) / rsk : (ent - high) / rsk)
        hitSL = dir > 0 ? low  <= slp : high >= slp
        hitTP = dir > 0 ? high >= tpp : low  <= tpp
        float r = na
        // pessimistico: se nella stessa barra toccano entrambi, vince lo stop
        if hitSL
            r := -1.0
        else if hitTP
            r := rrTP
        else if held >= fwdBars
            r := dir * (close - ent) / rsk
        if not na(r)
            r     -= costPts * tick / rsk
            n     += 1
            sumR  += r
            wins  += r > 0 ? 1 : 0
            sumFe += mfe
            sumAe += mae
            sumWR += qw * r
            sumW  += qw
            st    := 0

    // ---- nuovo segnale -----------------------------------------------------
    if evt and st == 0
        nSig += 1
        qw   := qualMode == "Peso continuo" ? math.max(qwIn, 0.01) : 1.0
        sHi  := high
        sLo  := low
        sAtr := atrS
        wait := 0
        if entryMode == "Market"
            ent := close
            slp := stopMode == "Strutturale" ? (dir > 0 ? math.min(sLo, ent) - stopBuf * sAtr : math.max(sHi, ent) + stopBuf * sAtr) : ent - dir * slATR * sAtr
            rsk := math.max(math.abs(ent - slp), tick)
            tpp := ent + dir * rrTP * rsk
            st   := 2
            held := 0
            mfe  := 0.0
            mae  := 0.0
        else
            px := entryMode == "Pullback" ? close - dir * pbATR * sAtr : (dir > 0 ? sHi + stopBuf * sAtr : sLo - stopBuf * sAtr)
            st := 1

    [n, nSig, n > 0 ? sumR / n : float(na), n > 0 ? 100.0 * wins / n : float(na), n > 0 ? sumFe / n : float(na), n > 0 ? sumAe / n : float(na), sumW > 0 ? sumWR / sumW : float(na)]

// -- BASELINE: ingresso su OGNI barra, stesso modello di entrata. Separa
//    l'edge del segnale dalla DERIVA del campione. Su un campione che scende
//    TUTTI i segnali short sembrano buoni: la baseline lo smaschera.
warm = bar_index > statLen + extLen
[nBL, gBL, rBL, hBL, fBL, aBL, wBL] = f_trade(warm, 1, f_qw(1, true))
[nBS, gBS, rBS, hBS, fBS, aBS, wBS] = f_trade(warm, -1, f_qw(-1, true))

[nBA, gBA, rBA, hBA, fBA, aBA, wBA] = f_trade(buyAbs, 1, f_qw(1, true))
[nSA, gSA, rSA, hSA, fSA, aSA, wSA] = f_trade(sellAbs, -1, f_qw(-1, true))
[nBE, gBE, rBE, hBE, fBE, aBE, wBE] = f_trade(bullExh, -1, f_qw(-1, true))   // bull exhaustion -> SHORT
[nRE, gRE, rRE, hRE, fRE, aRE, wRE] = f_trade(bearExh, 1, f_qw(1, true))   // bear exhaustion -> LONG
[nBI, gBI, rBI, hBI, fBI, aBI, wBI] = f_trade(bullIni, 1, f_qw(1, false))
[nSI, gSI, rSI, hSI, fSI, aSI, wSI] = f_trade(bearIni, -1, f_qw(-1, false))
[nBD, gBD, rBD, hBD, fBD, aBD, wBD] = f_trade(bullDiv, 1, f_qw(1, true))
[nSD, gSD, rSD, hSD, fSD, aSD, wSD] = f_trade(bearDiv, -1, f_qw(-1, true))


// ============================================================================
//  7-bis) BENCHMARK v1  ·  reimplementazione FEDELE del DVB-EX originale
// ============================================================================
//  Serve a rispondere con i numeri, non a occhio, alla domanda "quale genera
//  segnali migliori". Stessa metodologia forward-return, stessi costi, stesso
//  storico. Nessun filtro di sessione: la v1 non ne aveva, resta com'era.
// ============================================================================
grpB     = "9 - Benchmark v1 (originale)"
showV1   = input.bool(true, "Misura anche i segnali v1", group = grpB)
v1Len    = input.int(20,    "v1 Delta MA Length", minval = 5, group = grpB)
v1SensB  = input.float(2.0, "v1 Bubble Sensitivity",     step = 0.1, group = grpB)
v1SensA  = input.float(1.5, "v1 Absorption Sensitivity", step = 0.1, group = grpB)
v1SensE  = input.float(1.2, "v1 Exhaustion Sensitivity", step = 0.1, group = grpB)
v1UseVol = input.bool(true, "v1 Volume Spike Filter", group = grpB)
v1VolTh  = input.float(1.3, "v1 Volume Threshold", step = 0.1, group = grpB)
v1Align  = input.int(3,     "v1 Flow Confirmation Bars", minval = 1, group = grpB)
v1Cool   = input.int(2,     "v1 Min Bars Between", minval = 1, group = grpB)
showV1Mk = input.bool(false, "Disegna anche i marker v1 (confronto visivo)", group = grpB, tooltip = "Attivalo per verificare che la reimplementazione v1 coincida con il tuo indicatore originale, e per confrontare a occhio la densita' dei segnali.")

v1BodyRange = high - low
v1UpperWick = high - math.max(close, open)
v1LowerWick = math.min(close, open) - low
v1BuyP  = close > open ? (close - open) + (v1LowerWick * 0.5) : (v1LowerWick * 0.7)
v1SellP = close < open ? (open - close) + (v1UpperWick * 0.5) : (v1UpperWick * 0.7)
v1Raw   = (v1BuyP - v1SellP) * volume
v1Vel   = (close - open) / math.max(v1BodyRange, 0.0001)
v1Delta = v1Raw * (1 + math.abs(v1Vel))

v1MA    = ta.sma(v1Delta, v1Len)
v1SD    = ta.stdev(v1Delta, v1Len)
v1ND    = v1SD > 0 ? (v1Delta - v1MA) / v1SD : 0.0     // z contaminato dalla barra corrente
v1VolMA = ta.sma(volume, v1Len)
v1Spike = not v1UseVol or volume > v1VolMA * v1VolTh
v1ATR   = ta.atr(14)
v1Sig   = math.abs(close - close[1]) > v1ATR * 0.3
v1Up    = close > close[1]
v1Dn    = close < close[1]
v1DPos  = v1Delta > v1MA                                // NB: confronto con la MA, non con zero
v1DNeg  = v1Delta < v1MA
v1Strong = math.abs(v1ND) > v1SensA
v1Mod    = math.abs(v1ND) > v1SensE

v1BuyAbs  = v1Dn and v1DPos and v1Strong and v1Spike and v1Sig
v1SellAbs = v1Up and v1DNeg and v1Strong and v1Spike and v1Sig
v1BullExh = v1Up and v1DNeg and v1Mod and v1Spike and v1Sig and not v1SellAbs
v1BearExh = v1Dn and v1DPos and v1Mod and v1Spike and v1Sig and not v1BuyAbs

v1BullFlowC = v1Up and v1DPos and v1ND >  0.5
v1BearFlowC = v1Dn and v1DNeg and v1ND < -0.5
var int v1BullCnt = 0
var int v1BearCnt = 0
if v1BullFlowC
    v1BullCnt += 1
    v1BearCnt := 0
else if v1BearFlowC
    v1BearCnt += 1
    v1BullCnt := 0
else
    v1BullCnt := 0
    v1BearCnt := 0
v1BullFlow = v1BullCnt == v1Align
v1BearFlow = v1BearCnt == v1Align

v1BullBub = v1ND >  v1SensB and v1Spike and v1Delta > 0 and not v1BuyAbs  and not v1BearExh
v1BearBub = v1ND < -v1SensB and v1Spike and v1Delta < 0 and not v1SellAbs and not v1BullExh

f_gate1(bool raw) =>
    var int last = -1000000
    fire = raw and (bar_index - last >= v1Cool)
    if fire
        last := bar_index
    fire

g1BuyAbs  = f_gate1(v1BuyAbs)
g1SellAbs = f_gate1(v1SellAbs)
g1BullExh = f_gate1(v1BullExh)
g1BearExh = f_gate1(v1BearExh)
g1BullFlw = f_gate1(v1BullFlow)
g1BearFlw = f_gate1(v1BearFlow)
g1BullBub = f_gate1(v1BullBub)
g1BearBub = f_gate1(v1BearBub)

[n1a, g1a, r1a, h1a, f1a, a1a, w1a] = f_trade(g1BuyAbs, 1, f_qw(1, true))
[n1b, g1b, r1b, h1b, f1b, a1b, w1b] = f_trade(g1SellAbs, -1, f_qw(-1, true))
[n1c, g1c, r1c, h1c, f1c, a1c, w1c] = f_trade(g1BullExh, -1, f_qw(-1, true))   // v1: "potential reversal SHORT"
[n1d, g1d, r1d, h1d, f1d, a1d, w1d] = f_trade(g1BearExh, 1, f_qw(1, true))   // v1: "potential reversal LONG"
[n1e, g1e, r1e, h1e, f1e, a1e, w1e] = f_trade(g1BullFlw, 1, f_qw(1, true))
[n1f, g1f, r1f, h1f, f1f, a1f, w1f] = f_trade(g1BearFlw, -1, f_qw(-1, true))
[n1g, g1g, r1g, h1g, f1g, a1g, w1g] = f_trade(g1BullBub, 1, f_qw(1, true))
[n1h, g1h, r1h, h1h, f1h, a1h, w1h] = f_trade(g1BearBub, -1, f_qw(-1, true))

// ============================================================================
//  8) COLORI
// ============================================================================
cUp   = color.new(#26A69A, 0)
cDn   = color.new(#EF5350, 0)
cAbsB = color.new(#00E676, 0)
cAbsS = color.new(#FF1744, 0)
cExhB = color.new(#AB47BC, 0)
cExhR = color.new(#26C6DA, 0)
cIniB = color.new(#FFEB3B, 0)
cIniS = color.new(#FF9800, 0)
cDivB = color.new(#7CB342, 0)
cDivS = color.new(#D81B60, 0)

// ============================================================================
//  9) PANNELLO MOTORE (scale omogenee: tutto normalizzato)
// ============================================================================
plot(showPane ? dz : na, "Delta z", style = plot.style_columns, color = delta > 0 ? color.new(cUp, 55) : color.new(cDn, 55))
plot(showPane ? cvdN : na,        "CVD z",    color = color.new(#2962FF, 0), linewidth = 2)
plot(showPane ? score * 4.0 : na, "Score x4", color = color.new(#FFFFFF, 35), linewidth = 1)
plot(showPane ?  vzMin : na, "Soglia +", color = color.new(color.gray, 70))
plot(showPane ? -vzMin : na, "Soglia -", color = color.new(color.gray, 70))
hline(0, "zero", color = color.new(color.gray, 50))

bgcolor(isTrend ? color.new(color.blue, 93) : isRange ? color.new(color.orange, 93) : na, title = "Regime")

// ============================================================================
// 10) MARKER SUL GRAFICO PREZZO
// ============================================================================
plotshape(showMarks and buyAbs,  "Buy Absorption",  shape.arrowup,      location.belowbar, cAbsB, size = size.normal, force_overlay = true)
plotshape(showMarks and sellAbs, "Sell Absorption", shape.arrowdown,    location.abovebar, cAbsS, size = size.normal, force_overlay = true)
plotshape(showMarks and bullExh, "Bull Exhaustion", shape.diamond,      location.abovebar, cExhB, size = size.small,  force_overlay = true)
plotshape(showMarks and bearExh, "Bear Exhaustion", shape.diamond,      location.belowbar, cExhR, size = size.small,  force_overlay = true)
plotshape(showMarks and bullIni, "Bull Initiative", shape.triangleup,   location.belowbar, cIniB, size = size.tiny,   force_overlay = true)
plotshape(showMarks and bearIni, "Bear Initiative", shape.triangledown, location.abovebar, cIniS, size = size.tiny,   force_overlay = true)
plotshape(showMarks and bullDiv, "Bull Divergence", shape.circle,       location.belowbar, cDivB, size = size.tiny,   force_overlay = true)
plotshape(showMarks and bearDiv, "Bear Divergence", shape.circle,       location.abovebar, cDivS, size = size.tiny,   force_overlay = true)

// -- marker v1 (grigi, per confronto visivo diretto) --------------------------
cV1L = color.new(#B0BEC5, 20)
cV1S = color.new(#78909C, 20)
plotshape(showV1Mk and g1BuyAbs,  "v1 Buy Abs",  shape.xcross, location.belowbar, cV1L, size = size.tiny, force_overlay = true)
plotshape(showV1Mk and g1SellAbs, "v1 Sell Abs", shape.xcross, location.abovebar, cV1S, size = size.tiny, force_overlay = true)
plotshape(showV1Mk and g1BearExh, "v1 Bear Exh", shape.cross,  location.belowbar, cV1L, size = size.tiny, force_overlay = true)
plotshape(showV1Mk and g1BullExh, "v1 Bull Exh", shape.cross,  location.abovebar, cV1S, size = size.tiny, force_overlay = true)
plotshape(showV1Mk and g1BullFlw, "v1 Bull Flow", shape.square, location.belowbar, cV1L, size = size.tiny, force_overlay = true)
plotshape(showV1Mk and g1BearFlw, "v1 Bear Flow", shape.square, location.abovebar, cV1S, size = size.tiny, force_overlay = true)
plotshape(showV1Mk and g1BullBub, "v1 Bull Bub", shape.circle, location.belowbar, cV1L, size = size.tiny, force_overlay = true)
plotshape(showV1Mk and g1BearBub, "v1 Bear Bub", shape.circle, location.abovebar, cV1S, size = size.tiny, force_overlay = true)

// ============================================================================
// 11) DASHBOARD + TABELLA EDGE   (tabelle e funzioni a scope globale)
// ============================================================================
var table tDash = table.new(position.top_right, 3, 8, border_width = 1, bgcolor = color.new(#0B0E11, 12), frame_color = color.new(color.gray, 40), frame_width = 1)
var table tEdge = table.new(position.bottom_right, 8, 20, border_width = 1, bgcolor = color.new(#0B0E11, 12), frame_color = color.new(color.gray, 40), frame_width = 1)

f_edgeRow(table tb, int row, string name, int n, int nsig, float r, float h, float fe, float ae, float rw, float base, color c) =>
    exc = r - base                                     // edge al netto della deriva
    rc  = na(r)   ? color.gray : r   > 0 ? color.lime : color.red
    ec  = na(exc) ? color.gray : exc > 0 ? color.lime : color.red
    nc  = n < 30 ? color.orange : n < 100 ? color.yellow : color.silver
    // "riempiti/segnali" quando il modello di entrata scarta qualcosa
    ns  = nsig > n ? str.tostring(n) + "/" + str.tostring(nsig) : str.tostring(n)
    // MFE sotto il TP = il target non viene mai raggiunto, va abbassato
    fc  = na(fe) ? color.gray : fe < rrTP ? color.orange : color.silver
    table.cell(tb, 0, row, name,    text_color = c,            text_size = size.tiny)
    table.cell(tb, 1, row, ns,      text_color = nc,           text_size = size.tiny)
    table.cell(tb, 2, row, f_n0(h), text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 3, row, f_rr(r), text_color = rc,           text_size = size.tiny)
    table.cell(tb, 4, row, f_rr(exc), text_color = ec,         text_size = size.tiny)
    table.cell(tb, 5, row, f_n2(fe), text_color = fc,          text_size = size.tiny)
    table.cell(tb, 6, row, f_n2(ae), text_color = color.silver, text_size = size.tiny)
    // muR-w > muR  =>  gli assi di qualita' contengono segnale, e lo estraggono
    // SENZA scartare un solo trade. Se non lo alzano, non valgono.
    wc = na(rw) or na(r) ? color.gray : rw > r ? color.lime : color.red
    table.cell(tb, 7, row, f_rr(rw), text_color = wc, text_size = size.tiny)

if barstate.islast and showDash
    hdr = color.new(color.gray, 55)
    table.cell(tDash, 0, 0, "OFE2", bgcolor = hdr, text_color = color.white, text_size = size.small)
    table.cell(tDash, 1, 0, ltfOk ? "LTF " + ltfRes : "GEO", bgcolor = hdr, text_color = ltfOk ? color.lime : color.orange, text_size = size.small)
    table.cell(tDash, 2, 0, ok ? "ON" : "OFF", bgcolor = hdr, text_color = ok ? color.lime : color.red, text_size = size.small)

    table.cell(tDash, 0, 1, "Partecipazione z", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 1, f_n2(vz), text_color = vz > vzClimax ? color.fuchsia : vz > vzMin ? color.yellow : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 1, vz > vzClimax ? "CLIMAX" : vz > vzMin ? "alta" : "normale", text_color = color.gray, text_size = size.tiny)

    table.cell(tDash, 0, 2, "Sbilanciamento", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 2, f_n2(imb), text_color = imb > 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(tDash, 2, 2, "ortho " + f_n2(imbOrtho), text_color = color.gray, text_size = size.tiny)

    table.cell(tDash, 0, 3, "Risultato (ATR)", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 3, f_n2(res), text_color = res > 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(tDash, 2, 3, "clv " + f_n2(clvPos), text_color = color.gray, text_size = size.tiny)

    table.cell(tDash, 0, 4, "Regime (ER)", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 4, f_n2(er), text_color = isTrend ? color.aqua : isRange ? color.orange : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 4, isTrend ? "TREND" : isRange ? "RANGE" : "misto", text_color = isTrend ? color.aqua : color.orange, text_size = size.tiny)

    table.cell(tDash, 0, 5, "Estensione", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 5, f_n0(ext) + "%", text_color = ext > extHi or ext < extLo ? color.fuchsia : color.gray, text_size = size.tiny)
    table.cell(tDash, 2, 5, "CVD z " + f_n2(cvdN), text_color = color.aqua, text_size = size.tiny)

    table.cell(tDash, 0, 6, "Score", text_color = color.silver, text_size = size.tiny)
    table.cell(tDash, 1, 6, f_n2(score), text_color = score > 0 ? color.lime : color.red, text_size = size.tiny)
    table.cell(tDash, 2, 6, "VWAP z " + f_n2(vwZ), text_color = math.abs(vwZ) >= locMin ? color.fuchsia : color.gray, text_size = size.tiny)

    ev  = buyAbs ? "BUY ABS" : sellAbs ? "SELL ABS" : bullExh ? "BULL EXH" : bearExh ? "BEAR EXH" : bullIni ? "BULL INI" : bearIni ? "BEAR INI" : bullDiv ? "BULL DIV" : bearDiv ? "BEAR DIV" : "-"
    evc = buyAbs ? cAbsB : sellAbs ? cAbsS : bullExh ? cExhB : bearExh ? cExhR : bullIni ? cIniB : bearIni ? cIniS : bullDiv ? cDivB : bearDiv ? cDivS : color.gray
    table.cell(tDash, 0, 7, "EVENTO", text_color = color.white, text_size = size.tiny)
    table.cell(tDash, 1, 7, ev, text_color = evc, text_size = size.tiny)
    table.cell(tDash, 2, 7, "", text_color = color.gray, text_size = size.tiny)

if barstate.islast and showStats
    hdr2 = color.new(color.gray, 55)
    table.cell(tEdge, 0, 0, entryMode + " " + str.tostring(dayN) + "gg", bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 1, 0, "N",     bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 2, 0, "Hit%",  bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 3, 0, "muR",   bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 4, 0, "vs base", bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 5, 0, "MFE",     bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 6, 0, "MAE",     bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    table.cell(tEdge, 7, 0, "muR-w",   bgcolor = hdr2, text_color = color.white, text_size = size.tiny)
    f_edgeRow(tEdge, 1, "Buy Abs", nBA, gBA, rBA, hBA, fBA, aBA, wBA, rBL, cAbsB)
    f_edgeRow(tEdge, 2, "Sell Abs", nSA, gSA, rSA, hSA, fSA, aSA, wSA, rBS, cAbsS)
    f_edgeRow(tEdge, 3, "Bull Exh", nBE, gBE, rBE, hBE, fBE, aBE, wBE, rBS, cExhB)
    f_edgeRow(tEdge, 4, "Bear Exh", nRE, gRE, rRE, hRE, fRE, aRE, wRE, rBL, cExhR)
    f_edgeRow(tEdge, 5, "Bull Ini", nBI, gBI, rBI, hBI, fBI, aBI, wBI, rBL, cIniB)
    f_edgeRow(tEdge, 6, "Bear Ini", nSI, gSI, rSI, hSI, fSI, aSI, wSI, rBS, cIniS)
    f_edgeRow(tEdge, 7, "Bull Div", nBD, gBD, rBD, hBD, fBD, aBD, wBD, rBL, cDivB)
    f_edgeRow(tEdge, 8, "Bear Div", nSD, gSD, rSD, hSD, fSD, aSD, wSD, rBS, cDivS)
    f_edgeRow(tEdge, 9,  "BASE long",  nBL, gBL, rBL, hBL, fBL, aBL, rBL, color.gray)
    f_edgeRow(tEdge, 10, "BASE short", nBS, gBS, rBS, hBS, fBS, aBS, wBS, rBS, color.gray)
    if showV1
        table.cell(tEdge, 0, 11, "-- v1 --", text_color = color.gray, text_size = size.tiny)
        table.cell(tEdge, 1, 11, "", text_size = size.tiny)
        table.cell(tEdge, 2, 11, "", text_size = size.tiny)
        table.cell(tEdge, 3, 11, "", text_size = size.tiny)
        table.cell(tEdge, 4, 11, "", text_size = size.tiny)
        table.cell(tEdge, 5, 11, "", text_size = size.tiny)
        table.cell(tEdge, 6, 11, "", text_size = size.tiny)
        table.cell(tEdge, 7, 11, "", text_size = size.tiny)
        f_edgeRow(tEdge, 12, "v1 BuyAbs", n1a, g1a, r1a, h1a, f1a, a1a, w1a, rBL, color.silver)
        f_edgeRow(tEdge, 13, "v1 SellAbs", n1b, g1b, r1b, h1b, f1b, a1b, w1b, rBS, color.silver)
        f_edgeRow(tEdge, 14, "v1 BullExh", n1c, g1c, r1c, h1c, f1c, a1c, w1c, rBS, color.silver)
        f_edgeRow(tEdge, 15, "v1 BearExh", n1d, g1d, r1d, h1d, f1d, a1d, w1d, rBL, color.silver)
        f_edgeRow(tEdge, 16, "v1 BullFlw", n1e, g1e, r1e, h1e, f1e, a1e, w1e, rBL, color.silver)
        f_edgeRow(tEdge, 17, "v1 BearFlw", n1f, g1f, r1f, h1f, f1f, a1f, w1f, rBS, color.silver)
        f_edgeRow(tEdge, 18, "v1 BullBub", n1g, g1g, r1g, h1g, f1g, a1g, w1g, rBL, color.silver)
        f_edgeRow(tEdge, 19, "v1 BearBub", n1h, g1h, r1h, h1h, f1h, a1h, w1h, rBS, color.silver)

// ============================================================================
// 12) ALERT  ·  payload JSON per bridge MT5 / FP Markets
// ============================================================================
// Il payload rispecchia il MODELLO DI ENTRATA configurato, non piu' un
// market order fisso: il bridge riceve tipo d'ordine, prezzo, validita' in
// barre, e uno stop coerente con la modalita' scelta.
f_json(string kind, int dir) =>
    px  = entryMode == "Market"   ? close : entryMode == "Pullback" ? close - dir * pbATR * atrS : (dir > 0 ? high + stopBuf * atrS : low - stopBuf * atrS)
    sl  = stopMode == "Strutturale" ? (dir > 0 ? math.min(low, px) - stopBuf * atrS : math.max(high, px) + stopBuf * atrS) : px - dir * slATR * atrS
    rk  = math.max(math.abs(px - sl), tick)
    tp  = px + dir * rrTP * rk
    ord = entryMode == "Market" ? "market" : entryMode == "Pullback" ? "limit" : "stop"
    '{"sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","evt":"' + kind + '","dir":' + str.tostring(dir) + ',"ord":"' + ord + '","px":' + str.tostring(px, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp":' + str.tostring(tp, format.mintick) + ',"riskpts":' + str.tostring(rk, format.mintick) + ',"validbars":' + str.tostring(fillWin) + ',"atr":' + str.tostring(atrS, format.mintick) + ',"vz":' + str.tostring(vz, "#.##") + ',"imb":' + str.tostring(imb, "#.##") + ',"er":' + str.tostring(er, "#.##") + ',"score":' + str.tostring(score, "#.##") + ',"qw":' + str.tostring(f_qw(dir, kind != "BULL_INITIATIVE" and kind != "BEAR_INITIATIVE"), "#.##") + ',"t":' + str.tostring(time_close, "#") + '}'

if buyAbs
    alert(f_json("BUY_ABSORPTION", 1), alert.freq_once_per_bar_close)
if sellAbs
    alert(f_json("SELL_ABSORPTION", -1), alert.freq_once_per_bar_close)
if bullExh
    alert(f_json("BULL_EXHAUSTION", -1), alert.freq_once_per_bar_close)
if bearExh
    alert(f_json("BEAR_EXHAUSTION", 1), alert.freq_once_per_bar_close)
if bullIni
    alert(f_json("BULL_INITIATIVE", 1), alert.freq_once_per_bar_close)
if bearIni
    alert(f_json("BEAR_INITIATIVE", -1), alert.freq_once_per_bar_close)
if bullDiv
    alert(f_json("BULL_DIVERGENCE", 1), alert.freq_once_per_bar_close)
if bearDiv
    alert(f_json("BEAR_DIVERGENCE", -1), alert.freq_once_per_bar_close)

// ============================================================================
// 13) EXPORT  ·  feature vector per meta-labeling
// ============================================================================
//  Le feature sono lo STATO AL MOMENTO DEL SEGNALE. Nessuna etichetta qui:
//  l'esito a barriere lo ricostruisce Python dalle OHLC dello stesso CSV,
//  cosi' la definizione di SL/TP/orizzonte vive in un posto solo e non puo'
//  divergere tra ricerca e produzione.
//
//  sig: codifica famiglia x direzione. Positivo = trade LONG, negativo = SHORT.
//    1 BuyAbs   -1 SellAbs
//    2 BearExh  -2 BullExh
//    3 BullIni  -3 BearIni
//    4 BullDiv  -4 BearDiv
// ============================================================================
sigCode = buyAbs ? 1 : sellAbs ? -1 : bearExh ? 2 : bullExh ? -2 : bullIni ? 3 : bearIni ? -3 : bullDiv ? 4 : bearDiv ? -4 : 0

// raw = segnale PRIMA del gate di qualita'. Serve a far imparare al modello
// cosa il gate scarta a ragione e cosa scarta per niente.
rawCode = rawBuyAbs ? 1 : rawSellAbs ? -1 : rawBearExh ? 2 : rawBullExh ? -2 : rawBullIni ? 3 : rawBearIni ? -3 : rawBullDiv ? 4 : rawBearDiv ? -4 : 0

dd = display.data_window
plot(useExport ? sigCode       : na, "x_sig",     display = dd)
plot(useExport ? rawCode       : na, "x_sigraw",  display = dd)
plot(useExport ? vz            : na, "x_vz",      display = dd)
plot(useExport ? dz            : na, "x_dz",      display = dd)
plot(useExport ? imb           : na, "x_imb",     display = dd)
plot(useExport ? imbOrtho      : na, "x_ortho",   display = dd)
plot(useExport ? res           : na, "x_res",     display = dd)
plot(useExport ? clvPos        : na, "x_clv",     display = dd)
plot(useExport ? er            : na, "x_er",      display = dd)
plot(useExport ? ext           : na, "x_ext",     display = dd)
plot(useExport ? vwZ           : na, "x_vwz",     display = dd)
plot(useExport ? cvdN          : na, "x_cvdz",    display = dd)
plot(useExport ? atrS          : na, "x_atr",     display = dd)
plot(useExport ? (htfUp ? 1 : 0) : na, "x_htf",   display = dd)
plot(useExport ? nz(sinceCusum, 9999) : na, "x_cusumage", display = dd)
plot(useExport ? (hour + minute / 60.0) : na, "x_hour", display = dd)
plot(useExport ? dayofweek     : na, "x_dow",     display = dd)
plot(useExport ? score         : na, "x_score",   display = dd)
plot(useExport ? f_qw(1, true) : na, "x_qwl", display = dd)
plot(useExport ? f_qw(-1, true) : na, "x_qws", display = dd)
plot(useExport ? (ltfOk ? 1 : 0) : na, "x_ltf",   display = dd)
