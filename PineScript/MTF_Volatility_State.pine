//@version=6
// =============================================================================
//  MTF Volatility State   v3.0
//  Evoluzione multi-timeframe di "Volatility State Indicator [Ferro]"
//  ---------------------------------------------------------------------------
//  COSA FA
//  Misura in che stato di volatilita' si trova il mercato su cinque orizzonti
//  contemporaneamente, e marca le candele in espansione. Niente segnali di
//  ingresso: e' uno strumento di CONTESTO, non un motore di trading.
//
//  COSA CAMBIA RISPETTO ALLA v1 (e perche')
//
//  1. STIMATORE COERENTE
//     Nella v1 l'ATR usava RMA e Parkinson una SMA: due memorie diverse mediate
//     insieme. Qui entrambe le componenti passano per RMA della stessa lunghezza,
//     quindi il blend e' omogeneo e l'aggiornamento live e' esatto per costruzione.
//
//  2. GARMAN-KLASS
//     Parkinson vede solo high/low: sottostima quando la candela ha drift interno
//     o apre in gap. Garman-Klass aggiunge open e close ed e' ~7x piu' efficiente
//     del close-to-close. Selezionabile.
//
//  3. DUE BASI DI CALCOLO, A e C (gruppo 1)
//     A · TF NATIVO           ogni sezione usa le candele del PROPRIO timeframe
//     C · ORIZZONTE EQUIVALENTE  tutto sulle barre del grafico, finestra len*k
//     Non sono la stessa cosa con un ritardo diverso: sono due misure diverse.
//     Vedi i tooltip del selettore.
//
//  4. STRUTTURA A TERMINE
//     slope = percentile della sezione piu' VELOCE meno quello della piu' LENTA.
//       slope >> 0  espansione NASCENTE: parte dal corto, il lungo non l'ha vista
//       slope << 0  espansione ESAURITA: il lungo e' alto, il corto rientra gia'
//     Un singolo percentile alto non distingue i due casi. E' l'unica lettura di
//     volatilita' che cambia la decisione.
//
//  5. VALIDAZIONE DELL'ESPANSIONE
//     Dopo ogni marker misura l'escursione massima nelle N barre successive, in
//     ATR, e la confronta con la stessa statistica su barre QUALSIASI (campione
//     non sovrapposto). Il rapporto e' l'unico numero che dice se la candela di
//     espansione anticipa movimento o se e' solo la fotografia di un movimento
//     gia' avvenuto. Non filtra nulla, misura.
// =============================================================================

indicator("MTF Volatility State", shorttitle="VSI-MTF", overlay=false, max_bars_back=2000, max_labels_count=500)

// ------------------------------------------------------------- 1 · MOTORE ----
var string gC = "1 · Motore volatilita'"
estMode  = input.string("Blend (ATR% + Garman-Klass)", "Stimatore",
     options=["ATR %","Parkinson","Garman-Klass","Blend (ATR% + Parkinson)","Blend (ATR% + Garman-Klass)"], group=gC,
     tooltip="ATR %: escursione vera media in percentuale del prezzo. Include i gap, e' l'unica componente che li vede.\n\nPARKINSON: usa solo high/low. Circa 5x piu' efficiente del close-to-close a parita' di campione, ma CIECO ai gap e al drift interno alla candela: sottostima proprio quando il mercato salta.\n\nGARMAN-KLASS: aggiunge open e close, ~7x piu' efficiente. Corregge il drift intrabar che Parkinson ignora. Resta cieco ai gap fra candele.\n\nBLEND (default): media di ATR% e stimatore di range. L'ATR porta l'informazione sui gap, il range estimator porta l'efficienza statistica. Sono errori non correlati, quindi la media e' piu' stabile di entrambe le componenti.")
vBasis   = input.string("A · TF nativo", "Base di calcolo",
     options=["A · TF nativo","C · Barre grafico (orizzonte equivalente)"], group=gC,
     tooltip="A · TF NATIVO\nOgni sezione calcola ATR, varianza e percentile sulle candele del PROPRIO timeframe. E' l'unica modalita' in cui la sezione 5m misura davvero la distribuzione delle candele da 5 minuti, e in cui l'espansione e' l'espansione di una candela da 5 minuti.\nCon LIVE acceso la candela in formazione viene ricostruita sulle barre del grafico, quindi non c'e' ritardo di gradino. Con LIVE spento il valore si aggiorna una volta per candela HTF.\n\nC · ORIZZONTE EQUIVALENTE\nNessun timeframe superiore: tutto e' calcolato sulle candele DEL GRAFICO con finestra len*k, dove k = TF sezione / TF grafico. La sezione 5m su grafico 5s guarda 60 barre da 5 secondi, non candele da 5 minuti.\nAggiornamento a OGNI barra del grafico, zero ritardo, zero dipendenza da request.security. In compenso non esiste alcun contenuto multi-timeframe: e' un proxy di ORIZZONTE.\n\nDIFFERENZA CHE CONTA SULL'ESPANSIONE\nIn A: TR della candela HTF in formazione contro l'ATR del suo timeframe → 'la candela da 15m si sta allargando'.\nIn C: TR della barra del grafico contro l'ATR a orizzonte lungo → 'questa barra e' anomala rispetto alla volatilita' dell'ultima ora'.\nDue domande diverse, entrambe legittime. Sapere quale stai facendo non e' opzionale.")
atrLen   = input.int(14, "Finestra dello stimatore (candele)", minval=2, maxval=200, group=gC,
     tooltip="Numero di candele su cui mediare TR e varianza di range. In modo C viene moltiplicata per k, cosi' l'orizzonte fisico resta lo stesso della sezione.")
emaSm    = input.int(3, "Smoothing EMA", minval=1, maxval=50, group=gC)
liveMode = input.bool(true, "Ricostruzione LIVE della candela in formazione (solo modo A)", group=gC,
     tooltip="ACCESO (consigliato in modo A): la candela HTF in formazione viene ricostruita sulle barre del grafico e usata per aggiornare ATR e varianza con la formula ricorsiva esatta\n   ATR_live = ATR_chiuso + (TR_in_formazione - ATR_chiuso) / atrLen\ncioe' la candela parziale entra nella media con lo stesso peso 1/atrLen che avra' alla chiusura. Percentile e z si muovono a ogni barra del grafico.\n\nSPENTO: ogni sezione mostra il valore dell'ultima candela HTF chiusa. Curva a gradini: su una sezione 4h da un grafico 1m il valore resta fermo 240 barre.\n\nLa ricostruzione e' interamente lato grafico: NON passa da request.security, che su storico restituirebbe massimo e minimo FINALI della candela contenente la barra, cioe' valori che in quel momento non esistevano ancora. Un indicatore costruito su quei dati sembra profetico in backtest e inutile in tempo reale.\n\nIn modo C questa opzione e' inerte: li' e' gia' tutto calcolato sulle barre del grafico.")
confirmed= input.bool(true, "Solo candele HTF chiuse per centro e scala (no repaint)", group=gC,
     tooltip="Media, deviazione standard e campione del percentile vengono sempre dalle candele HTF CHIUSE. Con il LIVE acceso non costa nulla in reattivita', perche' il numeratore e' gia' il valore in formazione, e garantisce che lo storico non ripinga.\n\nRilevante solo in modo A e solo per le sezioni con TF superiore a quello del grafico.")

// ------------------------------------------------------- 2 · SEZIONI / TF ----
var string gT = "2 · Sezioni (timeframe)"
use1 = input.bool(true, "S1", inline="s1", group=gT)
tf1  = input.timeframe("1",  "", inline="s1", group=gT)
ln1  = input.int(100, "Len", minval=20, maxval=500, inline="s1", group=gT)
cc1  = input.color(color.new(#42a5f5, 0), "", inline="s1", group=gT)

use2 = input.bool(true, "S2", inline="s2", group=gT)
tf2  = input.timeframe("5",  "", inline="s2", group=gT)
ln2  = input.int(100, "Len", minval=20, maxval=500, inline="s2", group=gT)
cc2  = input.color(color.new(#7e57c2, 0), "", inline="s2", group=gT)

use3 = input.bool(true, "S3", inline="s3", group=gT)
tf3  = input.timeframe("15", "", inline="s3", group=gT)
ln3  = input.int(100, "Len", minval=20, maxval=500, inline="s3", group=gT)
cc3  = input.color(color.new(#ffa726, 0), "", inline="s3", group=gT)

use4 = input.bool(true, "S4", inline="s4", group=gT)
tf4  = input.timeframe("60", "", inline="s4", group=gT)
ln4  = input.int(100, "Len", minval=20, maxval=500, inline="s4", group=gT)
cc4  = input.color(color.new(#ec407a, 0), "", inline="s4", group=gT)

use5 = input.bool(true, "S5", inline="s5", group=gT)
tf5  = input.timeframe("240","", inline="s5", group=gT)
ln5  = input.int(100, "Len", minval=20, maxval=500, inline="s5", group=gT)
cc5  = input.color(color.new(#bdbdbd, 0), "", inline="s5", group=gT)

// -------------------------------------------------------- 3 · REGIMI ---------
var string gL = "3 · Soglie di regime (percentile)"
thExt = input.int(90, "EXTREME", minval=50, maxval=100, group=gL)
thHi  = input.int(70, "HIGH",    minval=50, maxval=100, group=gL)
thLo  = input.int(30, "LOW",     minval=0,  maxval=50,  group=gL)

// ------------------------------------------- 4 · CANDELE DI ESPANSIONE -------
var string gE = "4 · Candela di espansione"
expSrc   = input.string("Barra del grafico", "Misurata su",
     options=["Barra del grafico","S1","S2","S3","S4","S5"], group=gE,
     tooltip="BARRA DEL GRAFICO: TR della barra corrente diviso ATR del grafico su atrLen barre. Come nella v1, indipendente dal modo.\n\nSEZIONE Sx, MODO A: TR della candela HTF IN FORMAZIONE diviso ATR di quel timeframe. Marca l'espansione MENTRE la candela superiore si allarga, non a candela chiusa. Quando la candela da 15m ha gia' fatto 1.8 ATR e le restano 9 minuti, il movimento e' in corso ADESSO: la colonna 't' del cruscotto dice quanto tempo resta.\n\nSEZIONE Sx, MODO C: TR della barra del grafico diviso ATR calcolato su atrLen*k barre del grafico. Non misura una candela superiore, misura se QUESTA barra e' anomala rispetto alla volatilita' di quell'orizzonte. Aggiornamento a ogni barra.")
expTh    = input.float(1.8, "Soglia espansione (TR/ATR)", minval=1.0, maxval=10.0, step=0.1, group=gE,
     tooltip="Sopra 1.0 la candela e' piu' ampia della media recente. 1.8 e' circa il 90esimo percentile su FX liquido, ma dipende dallo strumento: guarda la colonna TR/ATR del cruscotto e il contatore 'exp' per tararla su quello che operi. Una soglia che produce zero marker su mille barre e' inutile quanto una che ne produce cento.")
expOne   = input.bool(true, "Un solo marker per episodio", group=gE,
     tooltip="ACCESO: marca solo la barra in cui la condizione DIVENTA vera. Su una sezione HTF l'espansione resta vera per tutte le barre in cui la candela superiore e' larga: senza questo avresti una fila di triangoli sullo stesso identico evento, e il contatore conterebbe barre invece di episodi.\n\nSPENTO: marca ogni barra in cui la condizione e' vera.")
expPane  = input.bool(true, "Marker nel pannello",    inline="ep", group=gE)
expChart = input.bool(true, "Marker sul grafico prezzi", inline="ep", group=gE)
expDir   = input.bool(true, "Forma secondo la direzione della candela", group=gE,
     tooltip="ACCESO: triangolo su o giu' secondo il segno della candela che si sta espandendo. In modo A il confronto e' con l'apertura della CANDELA SUPERIORE in formazione, non con quella della barra del grafico: sono due cose diverse e la seconda sarebbe rumore.\n\nSPENTO: un rombo neutro. Usalo se non vuoi che la forma suggerisca una direzione che l'indicatore non sta affermando.")
cExp     = input.color(color.new(#FFEB3B, 0), "Colore", group=gE)

// ------------------------------------------------------- 5 · VALIDAZIONE -----
var string gM = "5 · Validazione empirica dell'espansione"
useMv    = input.bool(true, "Misura il movimento dopo il marker", group=gM,
     tooltip="Dopo ogni marker misura l'escursione massima (in ATR del grafico) nelle N barre successive, e la confronta con la stessa misura presa su barre qualsiasi, con campione NON sovrapposto.\n\nIl numero che conta e' il rapporto nella riga 'move':\n  ~1.0  il marker non aggiunge nulla: stai fotografando la volatilita', non anticipandola\n  >1.3  l'espansione precede davvero un'escursione maggiore\n  <0.8  il marker arriva a movimento gia' fatto: e' un indicatore in ritardo, e su una candela di espansione e' l'esito PIU' PROBABILE, non l'eccezione\n\nBias dichiarato: il tracker segue un episodio alla volta, quindi di un grappolo di espansioni misura solo il primo, mentre il baseline campiona uniformemente nel tempo. Il confronto e' 'prima espansione di un grappolo' contro 'barra qualsiasi'. E' il confronto che serve a te, ma non e' 'espansione media contro barra media'.")
mvLen    = input.int(30, "   orizzonte (barre)", minval=3, maxval=500, group=gM)
atrChLen = input.int(14, "   ATR del grafico per normalizzare", minval=2, maxval=200, group=gM)

// ---------------------------------------------------------- 6 · GRAFICA ------
var string gV = "6 · Grafica"
showCur  = input.bool(true, "Curve percentile nel pannello", group=gV)
curStyle = input.string("Linea", "Stile delle curve", options=["Linea","Colonne (solo la piu' veloce)"], group=gV)
showZ    = input.bool(false, "Curva z-score della sezione piu' lenta (scalata)", group=gV)
showLv   = input.bool(true, "Linee di soglia", group=gV)
showBg   = input.bool(false, "Sfondo quando la sezione piu' veloce e' in EXTREME", group=gV)
showTab  = input.bool(true, "Mostra cruscotto", group=gV)
showTags = input.bool(true, "Etichette del periodo a destra delle curve", group=gV)
tagOff   = input.int(4, "   distanza (barre)", minval=1, maxval=50, group=gV)
dashSz   = input.string("Piccolo", "Dimensione testo cruscotto", options=["Minimo","Piccolo","Normale","Grande"], group=gV)

// =============================================================================
//  STIMATORI
// =============================================================================

// Varianza logaritmica per candela. Parkinson vede solo l'escursione, Garman-Klass
// corregge il drift fra apertura e chiusura: e' la differenza fra una candela che
// oscilla e una che percorre lo stesso range in linea retta.
f_estVar(float o, float h, float l, float c) =>
    float lnHL = h > 0 and l > 0 ? math.log(h / l) : 0.0
    float lnCO = c > 0 and o > 0 ? math.log(c / o) : 0.0
    float park = lnHL * lnHL / (4.0 * math.log(2.0))
    float gk   = 0.5 * lnHL * lnHL - (2.0 * math.log(2.0) - 1.0) * lnCO * lnCO
    str.contains(estMode, "Garman") ? math.max(gk, 0.0) : park

// Composito a partire dalle due componenti gia' mediate.
f_comp(float atrv, float px, float meanVar) =>
    float vA = px > 0 ? atrv / px * 100.0 : 0.0
    float vR = math.sqrt(math.max(meanVar, 0.0)) * 100.0
    estMode == "ATR %" ? vA : (estMode == "Parkinson" or estMode == "Garman-Klass") ? vR : (vA + vR) / 2.0

// -----------------------------------------------------------------------------
//  MODO A · eseguita DENTRO il contesto del timeframe della sezione.
//    vNat  volatilita' smussata, nativa (shiftata se 'confirmed')
//    pNat  percentile nativo
//    zNat  z-score nativo
//    mu/sd centro e scala, sempre dalla candela CHIUSA
//    atrC  ATR alla chiusura            -> base dell'aggiornamento live
//    mvC   varianza media alla chiusura -> base dell'aggiornamento live
//    vC    volatilita' smussata alla chiusura -> base dell'EMA live e campione
//    trN   TR/ATR nativo
// -----------------------------------------------------------------------------
f_htf(simple int pctLen, simple bool shift) =>
    float tr   = ta.tr(true)
    float atrv = ta.rma(tr, atrLen)
    float ev   = f_estVar(open, high, low, close)
    float mv   = ta.rma(ev, atrLen)
    float vc   = f_comp(atrv, close, mv)
    float vs   = ta.ema(vc, emaSm)
    float pr   = ta.percentrank(vs, pctLen)
    float mu   = ta.sma(vs, pctLen)
    float sd   = ta.stdev(vs, pctLen)
    float zz   = sd > 0 ? (vs - mu) / sd : 0.0
    float trn  = atrv > 0 ? tr / atrv : 0.0
    [shift ? vs[1] : vs, shift ? pr[1] : pr, shift ? zz[1] : zz, nz(mu[1], mu), nz(sd[1], sd), nz(atrv[1], atrv), nz(mv[1], mv), vs[1], shift ? trn[1] : trn]

// -----------------------------------------------------------------------------
//  MODO C · tutto sulle barre del grafico, finestra dello stimatore = atrLen*k.
//  Nessun ritardo, nessun timeframe superiore.
//
//  Qui NON c'e' ta.percentrank. La sua finestra in modo C sarebbe len*k: su un
//  grafico a 5 secondi con una sezione a 4h sono 288.000 barre, e percentrank
//  costa O(finestra) PER BARRA. Cinque sezioni cosi' fanno saltare il limite di
//  calcolo di TradingView ("Calculation timed out").
//  Il percentile viene invece calcolato sotto, con f_rank, su un campione
//  SOTTOCAMPIONATO (un valore ogni k barre) e tenuto ordinato: costo O(log n)
//  per barra. Non e' un ripiego: barre del grafico adiacenti sono quasi
//  perfettamente autocorrelate, quindi len*k barre sovrapposte contengono circa
//  la stessa informazione di len osservazioni distanti k. Stesso contenuto
//  statistico, costo diviso per k.
// -----------------------------------------------------------------------------
f_chart(simple int aLen) =>
    float tr   = ta.tr(true)
    float atrv = ta.rma(tr, aLen)
    float ev   = f_estVar(open, high, low, close)
    float mv   = ta.rma(ev, aLen)
    float vc   = f_comp(atrv, close, mv)
    float vs   = ta.ema(vc, emaSm)
    float trn  = atrv > 0 ? tr / atrv : 0.0
    [vs, trn]

// tiene il valore e lo aggiorna una volta ogni k barre: e' il campionamento che
// rende il percentile del modo C calcolabile in tempo costante
f_hold(bool act, float v, simple int kk) =>
    var float h = na
    if act and bar_index % kk == 0
        h := v
    h

// -----------------------------------------------------------------------------
//  Ricostruzione della candela HTF in formazione, interamente lato grafico.
//  Limite: i confini sono blocchi di durata pari al timeframe. Esatto per i TF
//  che dividono l'ora (15S, 30S, 1, 2, 5, 15, 30, 60); su TF che attraversano le
//  interruzioni di sessione i blocchi possono non coincidere con quelli di
//  TradingView.
// -----------------------------------------------------------------------------
f_form(simple int secTf) =>
    var float fO = na
    var float fH = na
    var float fL = na
    var float pc = na
    var int   fT = 0
    float bk = math.floor(time / (secTf * 1000.0))
    bool isNew = na(bk[1]) or bk != bk[1]
    if isNew
        pc := nz(close[1], open)
        fO := open
        fH := high
        fL := low
        fT := time
    else
        fH := math.max(fH, high)
        fL := math.min(fL, low)
    float trF = math.max(fH - fL, math.max(math.abs(fH - pc), math.abs(pc - fL)))
    float evF = f_estVar(fO, fH, fL, close)
    float pg  = math.min(1.0, math.max(0.0, (time - fT) / (secTf * 1000.0)))
    [trF, evF, pg, fO]

// -----------------------------------------------------------------------------
//  Percentile LIVE (modo A). ta.percentrank non serve: il valore corrente e'
//  ESTERNO al campione. Ogni sezione tiene l'array degli ultimi N valori delle
//  sue candele CHIUSE e calcola il rango del valore live contro quel campione.
//  Il push avviene quando il valore di chiusura CAMBIA: e' auto-sincronizzato
//  con request.security e non dipende da come TradingView allinea storico e
//  realtime.
//  Il campione e' tenuto ORDINATO, quindi il rango costa O(log n) per barra
//  invece di O(n). Con 5 sezioni e len 500 e' la differenza fra ~45 e ~2500
//  operazioni per barra, e la seconda fa interrompere il calcolo su storico
//  lungo. L'inserimento ordinato costa O(n) ma avviene una volta per candela.
//
//  f_cntLt: numero di elementi STRETTAMENTE minori di v. Scritta per essere
//  corretta con entrambe le convenzioni di binary_search_leftmost (indice del
//  valore trovato, oppure punto di inserimento).
// -----------------------------------------------------------------------------
f_cntLt(array<float> srt, float v) =>
    int sz = array.size(srt)
    int c  = 0
    if sz > 0
        int q = array.binary_search_leftmost(srt, v)
        c := q < 0 ? 0 : q >= sz ? sz : (array.get(srt, q) < v ? q + 1 : q)
    c

//  Restituisce anche media e deviazione standard del campione, mantenute con
//  somma e somma dei quadrati aggiornate a ogni push/evict: cosi' il modo C non
//  ha bisogno di ta.sma / ta.stdev su finestre enormi.
//  'act' spegne completamente il lavoro quando la modalita' non e' quella
//  attiva: senza, lo script pagherebbe SEMPRE il costo di entrambi i modi.
f_rank(bool act, float vClosed, float vLive, simple int n) =>
    var array<float> raw = array.new_float()
    var array<float> srt = array.new_float()
    var float sum = 0.0
    var float ssq = 0.0
    if act and not na(vClosed) and (na(vClosed[1]) or vClosed != vClosed[1])
        array.push(raw, vClosed)
        sum += vClosed
        ssq += vClosed * vClosed
        int ip = f_cntLt(srt, vClosed)
        if ip >= array.size(srt)
            array.push(srt, vClosed)
        else
            array.insert(srt, ip, vClosed)
        if array.size(raw) > n
            float outv = array.shift(raw)
            sum -= outv
            ssq -= outv * outv
            int rp = array.binary_search(srt, outv)
            if rp >= 0
                array.remove(srt, rp)
    int sz = array.size(srt)
    float mu = sz > 0 ? sum / sz : na
    float sd = sz > 1 ? math.sqrt(math.max(0.0, (ssq / sz - mu * mu)) * sz / (sz - 1)) : na
    float pr = sz > 0 and not na(vLive) ? 100.0 * f_cntLt(srt, vLive) / sz : na
    [pr, sz, mu, sd]

// =============================================================================
//  CALCOLO PER SEZIONE
// =============================================================================
modeA = vBasis == "A · TF nativo"
modeC = not modeA

chartSec = timeframe.in_seconds()
sc1 = timeframe.in_seconds(tf1)
sc2 = timeframe.in_seconds(tf2)
sc3 = timeframe.in_seconds(tf3)
sc4 = timeframe.in_seconds(tf4)
sc5 = timeframe.in_seconds(tf5)

// k = quante barre del grafico entrano in una candela della sezione
k1 = int(math.max(1, math.round(sc1 / float(chartSec))))
k2 = int(math.max(1, math.round(sc2 / float(chartSec))))
k3 = int(math.max(1, math.round(sc3 / float(chartSec))))
k4 = int(math.max(1, math.round(sc4 / float(chartSec))))
k5 = int(math.max(1, math.round(sc5 / float(chartSec))))

// Tetto della finestra dello stimatore in modo C. ta.rma si appoggia a una SMA
// di innesco, quindi una finestra enorme costa memoria e tempo di avvio. Sopra
// il tetto la sezione misura un orizzonte PIU' CORTO di quello richiesto: il
// cruscotto lo segnala con ⚠, non e' un dettaglio estetico.
//   Su grafico 5s una sezione 4h chiederebbe 14*2880 = 40320 barre. Se vedi il
//   flag su tutte le sezioni lente, il modo C non e' lo strumento giusto per
//   quella combinazione: usa il modo A, o abbassa i timeframe delle sezioni.
CAPW = 1000
aW1 = int(math.min(CAPW, atrLen * k1))
aW2 = int(math.min(CAPW, atrLen * k2))
aW3 = int(math.min(CAPW, atrLen * k3))
aW4 = int(math.min(CAPW, atrLen * k4))
aW5 = int(math.min(CAPW, atrLen * k5))
cap1 = modeC and atrLen * k1 > CAPW
cap2 = modeC and atrLen * k2 > CAPW
cap3 = modeC and atrLen * k3 > CAPW
cap4 = modeC and atrLen * k4 > CAPW
cap5 = modeC and atrLen * k5 > CAPW

// COSTO: Pine valuta TUTTO, anche il ramo della modalita' non attiva. Senza
// collassare le lunghezze, lo script pagherebbe sempre il conto di entrambi i
// modi ed e' esattamente cosi' che si arriva al timeout.
//   in modo C le cinque request.security puntano al timeframe DEL GRAFICO
//   (nessun ricampionamento HTF) e con finestra minima;
//   in modo A le cinque serie del grafico girano con finestra 5.
tS1 = modeA ? tf1 : timeframe.period
tS2 = modeA ? tf2 : timeframe.period
tS3 = modeA ? tf3 : timeframe.period
tS4 = modeA ? tf4 : timeframe.period
tS5 = modeA ? tf5 : timeframe.period
lS1 = modeA ? ln1 : 20
lS2 = modeA ? ln2 : 20
lS3 = modeA ? ln3 : 20
lS4 = modeA ? ln4 : 20
lS5 = modeA ? ln5 : 20
cW1 = modeC ? aW1 : 5
cW2 = modeC ? aW2 : 5
cW3 = modeC ? aW3 : 5
cW4 = modeC ? aW4 : 5
cW5 = modeC ? aW5 : 5

sh1 = (liveMode or confirmed) and sc1 > chartSec
sh2 = (liveMode or confirmed) and sc2 > chartSec
sh3 = (liveMode or confirmed) and sc3 > chartSec
sh4 = (liveMode or confirmed) and sc4 > chartSec
sh5 = (liveMode or confirmed) and sc5 > chartSec

[vN1, pN1, zN1, mu1, sd1, atC1, mvC1, vCl1, tN1] = request.security(syminfo.tickerid, tS1, f_htf(lS1, sh1), lookahead = barmerge.lookahead_off)
[vN2, pN2, zN2, mu2, sd2, atC2, mvC2, vCl2, tN2] = request.security(syminfo.tickerid, tS2, f_htf(lS2, sh2), lookahead = barmerge.lookahead_off)
[vN3, pN3, zN3, mu3, sd3, atC3, mvC3, vCl3, tN3] = request.security(syminfo.tickerid, tS3, f_htf(lS3, sh3), lookahead = barmerge.lookahead_off)
[vN4, pN4, zN4, mu4, sd4, atC4, mvC4, vCl4, tN4] = request.security(syminfo.tickerid, tS4, f_htf(lS4, sh4), lookahead = barmerge.lookahead_off)
[vN5, pN5, zN5, mu5, sd5, atC5, mvC5, vCl5, tN5] = request.security(syminfo.tickerid, tS5, f_htf(lS5, sh5), lookahead = barmerge.lookahead_off)

[vX1, tX1] = f_chart(cW1)
[vX2, tX2] = f_chart(cW2)
[vX3, tX3] = f_chart(cW3)
[vX4, tX4] = f_chart(cW4)
[vX5, tX5] = f_chart(cW5)

[trF1, evF1, pg1, op1] = f_form(sc1)
[trF2, evF2, pg2, op2] = f_form(sc2)
[trF3, evF3, pg3, op3] = f_form(sc3)
[trF4, evF4, pg4, op4] = f_form(sc4)
[trF5, evF5, pg5, op5] = f_form(sc5)

// Aggiornamento ricorsivo esatto: la candela in formazione entra nella media con
// il peso 1/atrLen che le spetta, esattamente come fara' alla chiusura.
f_live(float atrC, float mvC, float vSC, float trF, float evF, bool on) =>
    bool  ok = on and not na(atrC) and not na(vSC) and atrC > 0
    float aL = ok ? atrC + (trF - atrC) / atrLen : nz(atrC)
    float mL = ok ? mvC  + (evF - mvC)  / atrLen : nz(mvC)
    float cL = ok ? f_comp(aL, close, mL) : na
    float sL = ok ? vSC + (cL - vSC) * 2.0 / (emaSm + 1.0) : nz(vSC)
    float rr = aL > 0 ? trF / aL : 0.0
    [sL, aL, rr]

// il live e' una correzione della candela HTF in formazione: in modo C non c'e'
// nessuna candela superiore da correggere, quindi e' inerte
liveOn = liveMode and modeA

[vL1, aL1, rL1] = f_live(atC1, mvC1, vCl1, trF1, evF1, liveOn)
[vL2, aL2, rL2] = f_live(atC2, mvC2, vCl2, trF2, evF2, liveOn)
[vL3, aL3, rL3] = f_live(atC3, mvC3, vCl3, trF3, evF3, liveOn)
[vL4, aL4, rL4] = f_live(atC4, mvC4, vCl4, trF4, evF4, liveOn)
[vL5, aL5, rL5] = f_live(atC5, mvC5, vCl5, trF5, evF5, liveOn)

volA1 = liveOn ? vL1 : vN1
volA2 = liveOn ? vL2 : vN2
volA3 = liveOn ? vL3 : vN3
volA4 = liveOn ? vL4 : vN4
volA5 = liveOn ? vL5 : vN5

// campione del percentile: in modo A sono le candele HTF chiuse, in modo C e'
// la serie del grafico sottocampionata ogni k barre. Un solo motore per due modi.
hd1 = f_hold(modeC, vX1, k1)
hd2 = f_hold(modeC, vX2, k2)
hd3 = f_hold(modeC, vX3, k3)
hd4 = f_hold(modeC, vX4, k4)
hd5 = f_hold(modeC, vX5, k5)

rkOn = modeC or liveOn
[pR1, nS1, muR1, sdR1] = f_rank(rkOn, modeC ? hd1 : vCl1, modeC ? vX1 : volA1, ln1)
[pR2, nS2, muR2, sdR2] = f_rank(rkOn, modeC ? hd2 : vCl2, modeC ? vX2 : volA2, ln2)
[pR3, nS3, muR3, sdR3] = f_rank(rkOn, modeC ? hd3 : vCl3, modeC ? vX3 : volA3, ln3)
[pR4, nS4, muR4, sdR4] = f_rank(rkOn, modeC ? hd4 : vCl4, modeC ? vX4 : volA4, ln4)
[pR5, nS5, muR5, sdR5] = f_rank(rkOn, modeC ? hd5 : vCl5, modeC ? vX5 : volA5, ln5)

vol1 = modeC ? vX1 : volA1
vol2 = modeC ? vX2 : volA2
vol3 = modeC ? vX3 : volA3
vol4 = modeC ? vX4 : volA4
vol5 = modeC ? vX5 : volA5

pct1 = modeC ? pR1 : liveOn ? nz(pR1, pN1) : pN1
pct2 = modeC ? pR2 : liveOn ? nz(pR2, pN2) : pN2
pct3 = modeC ? pR3 : liveOn ? nz(pR3, pN3) : pN3
pct4 = modeC ? pR4 : liveOn ? nz(pR4, pN4) : pN4
pct5 = modeC ? pR5 : liveOn ? nz(pR5, pN5) : pN5

z1 = modeC ? (nz(sdR1) > 0 ? (vX1 - muR1) / sdR1 : 0.0) : liveOn and sd1 > 0 ? (volA1 - mu1) / sd1 : zN1
z2 = modeC ? (nz(sdR2) > 0 ? (vX2 - muR2) / sdR2 : 0.0) : liveOn and sd2 > 0 ? (volA2 - mu2) / sd2 : zN2
z3 = modeC ? (nz(sdR3) > 0 ? (vX3 - muR3) / sdR3 : 0.0) : liveOn and sd3 > 0 ? (volA3 - mu3) / sd3 : zN3
z4 = modeC ? (nz(sdR4) > 0 ? (vX4 - muR4) / sdR4 : 0.0) : liveOn and sd4 > 0 ? (volA4 - mu4) / sd4 : zN4
z5 = modeC ? (nz(sdR5) > 0 ? (vX5 - muR5) / sdR5 : 0.0) : liveOn and sd5 > 0 ? (volA5 - mu5) / sd5 : zN5

// TR/ATR della sezione. In A e' la candela HTF (in formazione se live), in C e'
// la barra del grafico contro l'ATR a orizzonte equivalente: misure diverse.
trA1 = modeC ? tX1 : liveOn ? rL1 : tN1
trA2 = modeC ? tX2 : liveOn ? rL2 : tN2
trA3 = modeC ? tX3 : liveOn ? rL3 : tN3
trA4 = modeC ? tX4 : liveOn ? rL4 : tN4
trA5 = modeC ? tX5 : liveOn ? rL5 : tN5

// Campione effettivo dichiarato dalla sezione, stesso significato nei due modi.
// Quando il motore ad array e' spento (modo A con LIVE off) il percentile viene
// da ta.percentrank dentro il contesto HTF: la finestra e' quella nominale.
ne1 = rkOn ? nS1 : ln1
ne2 = rkOn ? nS2 : ln2
ne3 = rkOn ? nS3 : ln3
ne4 = rkOn ? nS4 : ln4
ne5 = rkOn ? nS5 : ln5

// ----------------------------------------- sezione piu' veloce / piu' lenta ---
BIG = 1e12
m1 = use1 ? sc1 : BIG
m2 = use2 ? sc2 : BIG
m3 = use3 ? sc3 : BIG
m4 = use4 ? sc4 : BIG
m5 = use5 ? sc5 : BIG
minSec = math.min(math.min(math.min(math.min(m1, m2), m3), m4), m5)
x1 = use1 ? sc1 : 0
x2 = use2 ? sc2 : 0
x3 = use3 ? sc3 : 0
x4 = use4 ? sc4 : 0
x5 = use5 ? sc5 : 0
maxSec = math.max(math.max(math.max(math.max(x1, x2), x3), x4), x5)

nAct = (use1 ? 1 : 0) + (use2 ? 1 : 0) + (use3 ? 1 : 0) + (use4 ? 1 : 0) + (use5 ? 1 : 0)

pFast  = minSec >= BIG ? na : m1 == minSec ? pct1 : m2 == minSec ? pct2 : m3 == minSec ? pct3 : m4 == minSec ? pct4 : pct5
tfFast = minSec >= BIG ? "-" : m1 == minSec ? tf1  : m2 == minSec ? tf2  : m3 == minSec ? tf3  : m4 == minSec ? tf4  : tf5
pSlow  = maxSec == 0 ? na  : x5 == maxSec ? pct5 : x4 == maxSec ? pct4 : x3 == maxSec ? pct3 : x2 == maxSec ? pct2 : pct1
zSlow  = maxSec == 0 ? na  : x5 == maxSec ? z5   : x4 == maxSec ? z4   : x3 == maxSec ? z3   : x2 == maxSec ? z2   : z1
tfSlow = maxSec == 0 ? "-" : x5 == maxSec ? tf5  : x4 == maxSec ? tf4  : x3 == maxSec ? tf3  : x2 == maxSec ? tf2  : tf1

// STRUTTURA A TERMINE: e' questo il numero che distingue un'espansione nascente
// da una gia' finita. Un percentile alto da solo non lo dice.
slope = na(pFast) or na(pSlow) ? na : pFast - pSlow

// VOL-OF-VOL: dispersione del percentile veloce. Alta = il regime sta cambiando;
// bassa = regime stabile, e le soglie sono rumore intorno a un livello fermo.
vov = ta.stdev(pFast, 20)

// =============================================================================
//  CANDELA DI ESPANSIONE
// =============================================================================
atrCh  = math.max(ta.atr(atrChLen), syminfo.mintick)
trAtrC = ta.tr(true) / atrCh

isSec  = expSrc != "Barra del grafico"
trAtrE = expSrc == "S1" ? trA1 : expSrc == "S2" ? trA2 : expSrc == "S3" ? trA3 : expSrc == "S4" ? trA4 : expSrc == "S5" ? trA5 : trAtrC

// Frazione della candela HTF gia' consumata. Significativa solo in modo A: in C
// non esiste nessuna candela superiore in formazione.
pgE = not (isSec and modeA) ? na : expSrc == "S1" ? pg1 : expSrc == "S2" ? pg2 : expSrc == "S3" ? pg3 : expSrc == "S4" ? pg4 : pg5

// Direzione. In modo A va confrontata con l'apertura della CANDELA SUPERIORE in
// formazione, non con quella della barra del grafico: sono due cose diverse e la
// seconda sarebbe rumore. In modo C la candela superiore non esiste, quindi il
// riferimento e' giustamente l'apertura della barra.
opE = not (isSec and modeA) ? open : expSrc == "S1" ? op1 : expSrc == "S2" ? op2 : expSrc == "S3" ? op3 : expSrc == "S4" ? op4 : op5

isExp = not na(trAtrE) and trAtrE > expTh

// nz() non ha overload booleano: lo stato precedente lo tengo esplicito, cosi'
// alla prima barra vale false invece di na
var bool expPrev = false
expNew  = isExp and not expPrev
expPrev := isExp
expMk   = expOne ? expNew : isExp

expUp  = expMk and expDir and close >= opE
expDn  = expMk and expDir and close <  opE
expNeu = expMk and not expDir

// =============================================================================
//  VALIDAZIONE: movimento dopo il marker contro baseline non condizionato
// =============================================================================
var array<float> mvSig  = array.new_float()
var array<float> mvBase = array.new_float()
var bool  trk    = false
var float trkPx  = 0.0
var float trkAtr = 1.0
var float trkMax = 0.0
var int   trkBar = 0

if useMv and trk
    trkBar += 1
    trkMax := math.max(trkMax, math.max(high - trkPx, trkPx - low))
    if trkBar >= mvLen
        array.push(mvSig, trkMax / trkAtr)
        if array.size(mvSig) > 500
            array.shift(mvSig)
        trk := false

if useMv and expMk and not trk
    trk    := true
    trkPx  := close
    trkAtr := atrCh
    trkMax := 0.0
    trkBar := 0

// baseline: stessa statistica su barre qualsiasi, campionata ogni mvLen barre
// cosi' le finestre non si sovrappongono e le osservazioni restano indipendenti
baseFwd = (math.max(ta.highest(high, mvLen) - close[mvLen], close[mvLen] - ta.lowest(low, mvLen))) / math.max(nz(atrCh[mvLen], atrCh), syminfo.mintick)
if useMv and bar_index > mvLen and bar_index % mvLen == 0 and not na(baseFwd)
    array.push(mvBase, baseFwd)
    if array.size(mvBase) > 500
        array.shift(mvBase)

nSig  = array.size(mvSig)
nBase = array.size(mvBase)
mvSigMed  = nSig  >= 5 ? array.percentile_nearest_rank(mvSig, 50) : na
mvBaseMed = nBase >= 5 ? array.percentile_nearest_rank(mvBase, 50) : na
mvRatio   = na(mvSigMed) or na(mvBaseMed) or mvBaseMed <= 0 ? na : mvSigMed / mvBaseMed

// =============================================================================
//  PLOT
// =============================================================================
f_regCol(float p) =>
    na(p) ? color.gray : p >= thExt ? color.red : p >= thHi ? color.orange : p >= thLo ? color.gray : color.blue

colFast = f_regCol(pFast)
asCols  = curStyle == "Colonne (solo la piu' veloce)"

plot(showCur and asCols ? pFast : na, "percentile piu' veloce", color=colFast, style=plot.style_columns, linewidth=1)
plot(showCur and not asCols and use1 ? pct1 : na, "pct S1", color=cc1, linewidth=1)
plot(showCur and not asCols and use2 ? pct2 : na, "pct S2", color=cc2, linewidth=1)
plot(showCur and not asCols and use3 ? pct3 : na, "pct S3", color=cc3, linewidth=1)
plot(showCur and not asCols and use4 ? pct4 : na, "pct S4", color=cc4, linewidth=1)
plot(showCur and not asCols and use5 ? pct5 : na, "pct S5", color=cc5, linewidth=2)
plot(showZ ? zSlow * 10 + 50 : na, "z sezione lenta (scalato)", color=color.new(color.white, 55), linewidth=1)

hline(50, "mediana", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
plot(showLv ? thExt : na, "EXTREME", color=color.new(color.red, 30),    style=plot.style_linebr)
plot(showLv ? thHi  : na, "HIGH",    color=color.new(color.orange, 40), style=plot.style_linebr)
plot(showLv ? thLo  : na, "LOW",     color=color.new(color.blue, 40),   style=plot.style_linebr)

bgcolor(showBg and not na(pFast) and pFast >= thExt ? color.new(color.red, 92) : na, title="Sfondo EXTREME")

// ---- MARKER DI ESPANSIONE: giallo, pannello E grafico prezzi ----------------
// La dimensione e' fissa: il parametro 'size' di plotshape richiede un valore
// costante, quindi non puo' arrivare da un input. Tiny nel pannello, small sul
// grafico dove deve restare leggibile accanto alle candele.
plotshape(expPane  and expUp,  "Espansione ▲ (pannello)", style=shape.triangleup,   location=location.bottom,   color=cExp, size=size.tiny)
plotshape(expPane  and expDn,  "Espansione ▼ (pannello)", style=shape.triangledown, location=location.bottom,   color=cExp, size=size.tiny)
plotshape(expPane  and expNeu, "Espansione ◆ (pannello)", style=shape.diamond,      location=location.bottom,   color=cExp, size=size.tiny)
plotshape(expChart and expUp,  "Espansione ▲ (grafico)",  style=shape.triangleup,   location=location.belowbar, color=cExp, size=size.small, force_overlay=true)
plotshape(expChart and expDn,  "Espansione ▼ (grafico)",  style=shape.triangledown, location=location.abovebar, color=cExp, size=size.small, force_overlay=true)
plotshape(expChart and expNeu, "Espansione ◆ (grafico)",  style=shape.diamond,      location=location.abovebar, color=cExp, size=size.small, force_overlay=true)

// =============================================================================
//  ETICHETTE E CRUSCOTTO
// =============================================================================
szD = dashSz == "Minimo" ? size.tiny : dashSz == "Piccolo" ? size.small : dashSz == "Normale" ? size.normal : size.large

f_tag(bool use, string tf, float y, color c) =>
    var label lb = label.new(bar_index, 0.0, "", style=label.style_none, size=size.tiny, textalign=text.align_left)
    if barstate.islast
        label.set_xy(lb, bar_index + tagOff, nz(y))
        label.set_text(lb, showCur and showTags and use and not asCols ? tf : "")
        label.set_textcolor(lb, c)
    lb

f_tag(use1, tf1, pct1, cc1)
f_tag(use2, tf2, pct2, cc2)
f_tag(use3, tf3, pct3, cc3)
f_tag(use4, tf4, pct4, cc4)
f_tag(use5, tf5, pct5, cc5)

f_cnt(bool c) =>
    var int n = 0
    if c
        n += 1
    n

cHit1 = f_cnt(use1 and pct1 >= thExt and nz(pct1[1], 0) < thExt)
cHit2 = f_cnt(use2 and pct2 >= thExt and nz(pct2[1], 0) < thExt)
cHit3 = f_cnt(use3 and pct3 >= thExt and nz(pct3[1], 0) < thExt)
cHit4 = f_cnt(use4 and pct4 >= thExt and nz(pct4[1], 0) < thExt)
cHit5 = f_cnt(use5 and pct5 >= thExt and nz(pct5[1], 0) < thExt)
cExpN = f_cnt(expMk)

f_n1(float v) => na(v) ? "n/a" : str.tostring(v, "#.0")
f_n2(float v) => na(v) ? "n/a" : str.tostring(v, "#.00")
f_reg(float p) => na(p) ? "n/a" : p >= thExt ? "EXTREME" : p >= thHi ? "HIGH" : p >= thLo ? "NORMAL" : "LOW"

var table dash = table.new(position.top_right, 7, 10, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
if showTab and barstate.islast
    hdr = color.new(color.gray, 70)
    table.cell(dash, 0, 0, "TF",      bgcolor=hdr, text_color=color.white, text_size=szD)
    table.cell(dash, 1, 0, "vol %",   bgcolor=hdr, text_color=color.white, text_size=szD)
    table.cell(dash, 2, 0, "pct",     bgcolor=hdr, text_color=color.white, text_size=szD)
    table.cell(dash, 3, 0, "z",       bgcolor=hdr, text_color=color.white, text_size=szD)
    table.cell(dash, 4, 0, "TR/ATR",  bgcolor=hdr, text_color=color.white, text_size=szD)
    table.cell(dash, 5, 0, "n · hit", bgcolor=hdr, text_color=color.white, text_size=szD)
    table.cell(dash, 6, 0, "regime",  bgcolor=hdr, text_color=color.white, text_size=szD)

    tfs = array.from(tf1, tf2, tf3, tf4, tf5)
    scs = array.from(sc1, sc2, sc3, sc4, sc5)
    vls = array.from(vol1, vol2, vol3, vol4, vol5)
    pcs = array.from(pct1, pct2, pct3, pct4, pct5)
    zzs = array.from(z1, z2, z3, z4, z5)
    trs = array.from(trA1, trA2, trA3, trA4, trA5)
    nes = array.from(ne1, ne2, ne3, ne4, ne5)
    lns = array.from(ln1, ln2, ln3, ln4, ln5)
    cps = array.from(cap1, cap2, cap3, cap4, cap5)
    hts = array.from(cHit1, cHit2, cHit3, cHit4, cHit5)
    uss = array.from(use1, use2, use3, use4, use5)
    cls = array.from(cc1, cc2, cc3, cc4, cc5)

    for i = 0 to 4
        act  = array.get(uss, i)
        p    = array.get(pcs, i)
        bad  = act and array.get(scs, i) < chartSec
        capd = act and array.get(cps, i)
        thin = act and array.get(nes, i) < array.get(lns, i)
        col  = not act ? color.new(color.gray, 60) : bad ? color.new(color.red, 25) : p >= thExt ? color.new(color.red, 55) : p >= thHi ? color.new(color.orange, 60) : p < thLo ? color.new(color.blue, 65) : color.new(color.gray, 85)
        table.cell(dash, 0, i + 1, "S" + str.tostring(i + 1) + " " + (act ? (bad ? "⚠<graf" : array.get(tfs, i)) : "off"), text_size=szD, text_color=act ? array.get(cls, i) : color.gray, bgcolor=col)
        table.cell(dash, 1, i + 1, act ? f_n2(array.get(vls, i)) : "–", text_size=szD, text_color=color.white, bgcolor=col)
        table.cell(dash, 2, i + 1, act ? f_n1(p) : "–", text_size=szD, text_color=color.white, bgcolor=col)
        table.cell(dash, 3, i + 1, act ? f_n2(array.get(zzs, i)) : "–", text_size=szD, text_color=color.white, bgcolor=col)
        table.cell(dash, 4, i + 1, act ? f_n2(array.get(trs, i)) : "–", text_size=szD, text_color=act and array.get(trs, i) > expTh ? cExp : color.white, bgcolor=col)
        table.cell(dash, 5, i + 1, act ? str.tostring(array.get(nes, i)) + (capd ? "⚠" : "") + " · " + str.tostring(array.get(hts, i)) : "–", text_size=szD, text_color=capd ? color.red : thin ? color.orange : color.white, bgcolor=col)
        table.cell(dash, 6, i + 1, act ? f_reg(p) : "–", text_size=szD, text_color=color.white, bgcolor=col)

    // --- modo e struttura a termine: la riga da leggere per prima ------------
    sCol = na(slope) ? hdr : slope >= 20 ? color.new(color.lime, 45) : slope <= -20 ? color.new(color.red, 45) : color.new(color.gray, 80)
    sTxt = na(slope) ? "n/a" : slope >= 20 ? "NASCENTE" : slope <= -20 ? "ESAURITA" : "piatta"
    mCol = modeC ? color.new(color.orange, 45) : liveOn ? color.new(color.teal, 45) : hdr
    table.cell(dash, 0, 6, modeA ? "A nativo" : "C orizz.", text_size=szD, text_color=color.white, bgcolor=mCol)
    table.cell(dash, 1, 6, modeC ? "no HTF" : liveOn ? "LIVE" : "step", text_size=szD, text_color=modeC ? color.orange : liveOn ? color.aqua : color.silver, bgcolor=mCol)
    table.cell(dash, 2, 6, "term " + tfFast + "→" + tfSlow, text_size=szD, text_color=color.silver, bgcolor=hdr)
    table.cell(dash, 3, 6, f_n1(slope), text_size=szD, text_color=color.white, bgcolor=sCol)
    table.cell(dash, 4, 6, sTxt, text_size=szD, text_color=color.white, bgcolor=sCol)
    table.cell(dash, 5, 6, "volvol " + f_n1(vov), text_size=szD, text_color=not na(vov) and vov < 5 ? color.orange : color.white, bgcolor=hdr)
    table.cell(dash, 6, 6, str.tostring(nAct) + " sez", text_size=szD, text_color=nAct == 0 ? color.red : color.white, bgcolor=hdr)

    // --- espansione ----------------------------------------------------------
    ebg = color.new(color.gray, 88)
    table.cell(dash, 0, 7, "espans.", text_size=szD, text_color=color.white, bgcolor=isExp ? color.new(color.yellow, 55) : ebg)
    table.cell(dash, 1, 7, isSec ? expSrc + " " + (expSrc == "S1" ? tf1 : expSrc == "S2" ? tf2 : expSrc == "S3" ? tf3 : expSrc == "S4" ? tf4 : tf5) : "grafico", text_size=szD, text_color=color.silver, bgcolor=ebg)
    table.cell(dash, 2, 7, f_n2(trAtrE), text_size=szD, text_color=isExp ? cExp : color.white, bgcolor=ebg)
    table.cell(dash, 3, 7, "th " + str.tostring(expTh, "#.0"), text_size=szD, text_color=color.silver, bgcolor=ebg)
    table.cell(dash, 4, 7, na(pgE) ? "t –" : "t " + f_n2(pgE), text_size=szD, text_color=na(pgE) ? color.gray : pgE > 0.8 ? color.orange : color.lime, bgcolor=ebg)
    table.cell(dash, 5, 7, "exp " + str.tostring(cExpN), text_size=szD, text_color=cExpN == 0 ? color.red : cExp, bgcolor=ebg)
    table.cell(dash, 6, 7, isExp ? "ESPANSIONE" : "–", text_size=szD, text_color=isExp ? cExp : color.gray, bgcolor=ebg)

    // --- validazione: l'unica riga che puo' dirti di buttare la taratura -----
    mbg  = color.new(color.gray, 88)
    rCol = na(mvRatio) ? color.gray : mvRatio >= 1.3 ? color.lime : mvRatio >= 1.05 ? color.silver : mvRatio >= 0.8 ? color.orange : color.red
    rTxt = na(mvRatio) ? "campione" : mvRatio >= 1.3 ? "anticipa" : mvRatio >= 1.05 ? "debole" : mvRatio >= 0.8 ? "nullo" : "in ritardo"
    table.cell(dash, 0, 8, "move " + str.tostring(mvLen) + "b", text_size=szD, text_color=color.white, bgcolor=mbg)
    table.cell(dash, 1, 8, "sig " + f_n2(mvSigMed), text_size=szD, text_color=color.white, bgcolor=mbg)
    table.cell(dash, 2, 8, "base " + f_n2(mvBaseMed), text_size=szD, text_color=color.silver, bgcolor=mbg)
    table.cell(dash, 3, 8, "x" + f_n2(mvRatio), text_size=szD, text_color=rCol, bgcolor=mbg)
    table.cell(dash, 4, 8, rTxt, text_size=szD, text_color=rCol, bgcolor=mbg)
    table.cell(dash, 5, 8, "n " + str.tostring(nSig), text_size=szD, text_color=nSig < 30 ? color.orange : color.silver, bgcolor=mbg)
    table.cell(dash, 6, 8, "nb " + str.tostring(nBase), text_size=szD, text_color=nBase < 30 ? color.orange : color.silver, bgcolor=mbg)

    // --- ATR del grafico, per dimensionare lo stop ---------------------------
    abg = color.new(color.gray, 92)
    table.cell(dash, 0, 9, "ATR graf", text_size=szD, text_color=color.silver, bgcolor=abg)
    table.cell(dash, 1, 9, str.tostring(atrCh, format.mintick) + " pt", text_size=szD, text_color=color.white, bgcolor=abg)
    table.cell(dash, 2, 9, str.tostring(math.round(atrCh / syminfo.mintick)) + " t", text_size=szD, text_color=color.white, bgcolor=abg)
    table.cell(dash, 3, 9, "barra " + f_n2(trAtrC), text_size=szD, text_color=color.white, bgcolor=abg)
    table.cell(dash, 4, 9, "", text_size=szD, bgcolor=abg)
    table.cell(dash, 5, 9, "", text_size=szD, bgcolor=abg)
    table.cell(dash, 6, 9, "", text_size=szD, bgcolor=abg)

// =============================================================================
//  ALERT
// =============================================================================
alertcondition(expMk, "VSI · Candela in espansione", "Espansione TR/ATR su {{ticker}} {{interval}}")
alertcondition(not na(pFast) and pFast >= thExt and nz(pFast[1], 0) < thExt, "VSI · Ingresso in EXTREME", "Volatilita' entrata in regime EXTREME su {{ticker}} {{interval}}")
alertcondition(not na(pFast) and pFast <= thLo and nz(pFast[1], 100) > thLo, "VSI · Ingresso in LOW", "Volatilita' entrata in regime LOW su {{ticker}} {{interval}}")

if expMk
    alert("VSI-MTF espansione " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | TR/ATR=" + f_n2(trAtrE) + " | src=" + (isSec ? expSrc : "grafico") + " | modo=" + (modeA ? "A" : "C") + " | pct " + tfFast + "=" + f_n1(pFast) + " | slope=" + f_n1(slope) + " | ATR=" + str.tostring(atrCh, format.mintick) + "pt", alert.freq_once_per_bar_close)
