28798,-0.1,-1;28803,-0.2,-1;28808,-0.2,-1;28838,-0.3,-1;28848,-0.5,-1;28853,-0.2,-1;28868,-0.2,-1;28878,-0.4,-1;28908,-0.2,-1;28918,-0.2,-1;28928,0.2,1;28948,-0.2,-1;28953,-0.6,-1;28968,-0.2,-1;28978,-0.8,-1;28988,0.1,1;28998,0.2,1;29003,-0.1,-1;29008,-0.2,-1;29028,-0.4,-1;29038,0.1,1;29048,-0.3,-1;29053,-0.4,-1;29068,0.5,1;29078,-0.1,-1;29088,0.7,1;29098,0.3,1;29103,0.1,1;29108,0.3,1;29118,0.4,1;29128,0.5,1;29138,0.2,1;29148,0.6,1;29158,0.1,1;29168,-0.4,-1;29178,-0.3,-1;29188,0.2,1;29198,0.8,1;29203,0.1,1;29208,0.9,1;29228,0.3,1;29238,0.5,1;29248,0.6,1;29253,0.3,1;29258,0.1,1;29268,10.0,1;29278,0.9,1;29288,0.4,1;29298,0.2,1;29303,0.3,1;29308,0.6,1;29318,0.3,1;29328,0.6,1;29338,0.4,1;29353,-0.4,-1;29358,-0.3,-1;29378,0.5,1;29388,0.2,1;29398,0.1,1;29403,0.8,1;29408,0.9,1;29418,0.3,1;29428,2.9,1;29438,1.1,1;29448,1.5,1;29453,0.4,1;29468,0.5,1;29478,1.2,1;29488,0.3,1;29498,0.6,1;29503,0.1,1;29518,0.8,1;29528,0.3,1;29553,0.2,1;29558,0.2,1;29568,6.8,1;29578,1.9,1;29588,0.1,1;29608,1.1,1;29618,0.1,1;29628,0.3,1;29638,1.0,1;29648,0.1,1;29668,1.1,1;29678,1.5,1;29688,2.7,1;29703,-0.1,-1;29708,1.0,1;29778,0.6,1;29788,0.1,1;29798,0.2,1;29803,0.2,1;29808,0.2,1;29818,0.2,1;29828,0.2,1;29878,0.3,1;29978,0.4,1;30028,0.1,1;30058,0.2,1;30078,0.2,1;30178,1.0,1;30678,0.2,1;31278,0.3,1")
dataStamp = input.string("", "Data/ora del paste  (YYYY-MM-DD HH:MM)", group=groupGex, tooltip="Ora exchange in cui hai incollato la stringa. L'open interest si aggiorna a fine sessione: un profilo di ieri descrive un mercato che non esiste piu', e senza questo campo niente te lo ricorda. Lascia vuoto per disattivare il controllo.")
dataMaxAgeH = input.float(9.0, "Eta' massima dei dati (ore)", minval=0.5, step=0.5, group=groupGex)
showStatus = input.bool(true, "Pannello di stato", group=groupGex)
strikeSpaceMode = input.string("NQ", "Spazio degli strike", options=["NQ", "NDX"], group=groupGex, tooltip="Non esiste un gamma nativo di NQ: qualunque livello 'NQ' e' gamma NDX/QQQ riportato nello spazio prezzo del future.\n\nNQ  = gli strike arrivano col basis gia' sommato dentro (formato TLADe, campo S:). Il basis congelato in S: viene corretto verso quello misurato adesso.\n\nNDX = incolli gli strike cash come sono (InsiderFinance, CBOE) e viene sommato per intero il basis vivo. Modalita' robusta: non c'e' nessun basis congelato, quindi non c'e' drift che invecchia.")
gexDataInput = input.text_area("", title="Live GEX Override", group=groupGex, tooltip="Paste live data to override weekly. Leave empty for weekly.")
string gexDataRaw = gexDataInput != "" ? gexDataInput : WEEKLY_DATA
string gexDataActive = gexDataRaw
if str.contains(gexDataActive, "%7C") or str.contains(gexDataActive, "%7c")
    gexDataActive := str.replace_all(gexDataActive, "%7C", "|")
    gexDataActive := str.replace_all(gexDataActive, "%7c", "|")
    gexDataActive := str.replace_all(gexDataActive, "%20", " ")
if str.startswith(gexDataActive, "s:")
    gexDataActive := "S:" + str.substring(gexDataActive, 2)

groupGexVis = "GEX Visibility"
showGexLevels = input.bool(true, "Call/Put Walls", group=groupGexVis)
showSystemLevels = input.bool(true, "System (ZG, MaxPain, EM, VolBands)", group=groupGexVis)
showStructureLevels = input.bool(true, "Structure (PDH/PDL/PWH/PWL)", group=groupGexVis)
showCharmMagnet = input.bool(true, "Charm Magnet", group=groupGexVis)
showDeltaFlip = input.bool(true, "Delta Flip", group=groupGexVis)
showProfile = input.bool(true, "GEX Profile Bars", group=groupGexVis)
showSecondary = input.bool(true, "Livelli secondari (AbsGEX, DEX, OI, Volume)", group=groupGexVis, tooltip="Prodotti da tools/gex_full_string.py. AbsGEX e' gamma lorda call+put: cattura gli strike dove il netto si cancella ma l'hedging e' massimo, invisibili a una mappa net-only.")
colorSecondary = input.color(#8b5cf6, "Colore secondari", group=groupGexVis)
maxLevelsChoice = input.string("10", "Max GEX Levels", options=["5", "10", "15", "20", "All"], group=groupGexVis)
int maxVisibleLevels = maxLevelsChoice == "All" ? 999 : int(str.tonumber(maxLevelsChoice))
showOnlyNear = input.bool(false, "Show only levels near price", group=groupGexVis)
nearPct = input.float(3.0, "  Radius (%)", step=0.5, minval=0.5, maxval=10.0, group=groupGexVis)
enableThreshold = input.bool(false, "Min GEX Threshold", group=groupGexVis)
gexThreshold = input.float(50.0, "  Min Magnitude (M)", step=10.0, group=groupGexVis)

groupProfile = "GEX Profile Style"
profileWidth = input.int(50, "Bar Width", group=groupProfile, inline="p1")
barThickness = input.int(8, "Bar Height", group=groupProfile, inline="p1")
profileOffset = input.int(15, "Offset", group=groupProfile)

groupBOS = "Breakout Structure (BOS)"
showBOS_M = input.bool(false, "Monthly", group=groupBOS, inline="bos0")
showBOS_W = input.bool(false, "Weekly", group=groupBOS, inline="bos0")
showBOS_D = input.bool(false, "Daily", group=groupBOS, inline="bos1")
showBOS_H4 = input.bool(false, "4H", group=groupBOS, inline="bos1")
showBOS_H1 = input.bool(false, "1H", group=groupBOS, inline="bos2")
bosLineWidth = input.int(2, "BOS Line Width", minval=1, maxval=4, group=groupBOS)
colorBOS_Bull = input.color(#22c55e, "Bull", group=groupBOS, inline="bosc")
colorBOS_Bear = input.color(#ef4444, "Bear", group=groupBOS, inline="bosc")

groupSess = "Session Boxes"
showSessions = input.bool(true, "Show Session Boxes", group=groupSess)
showAsia = input.bool(true, "Asia", group=groupSess, inline="s1")
showEU = input.bool(true, "Europe", group=groupSess, inline="s1")
showPre = input.bool(true, "Pre-Mkt", group=groupSess, inline="s1")
showUS = input.bool(true, "US RTH", group=groupSess, inline="s1")
colorAsia = input.color(color.new(#f59e0b, 90), "Asia", group=groupSess, inline="sc")
colorEU = input.color(color.new(#3b82f6, 90), "EU", group=groupSess, inline="sc")
colorPre = input.color(color.new(#a855f7, 92), "Pre", group=groupSess, inline="sc2")
colorUS = input.color(color.new(#22c55e, 92), "US", group=groupSess, inline="sc2")
showHistoricalSessions = input.bool(false, "Show Historical (prev days)", group=groupSess, tooltip="When off, only the current trading day is displayed.")

groupAVWAP = "Session AVWAP"
showAVWAP = input.bool(true, "Show Session AVWAPs", group=groupAVWAP)
showAvwapAsia = input.bool(true, "Asia VWAP", group=groupAVWAP, inline="av1")
showAvwapEU = input.bool(true, "EU VWAP", group=groupAVWAP, inline="av1")
showAvwapUS = input.bool(true, "US VWAP", group=groupAVWAP, inline="av1")
showAvwapPD = input.bool(true, "US Prev Day", group=groupAVWAP, inline="av1")
colorAvwapAsia = input.color(#f59e0b, "Asia", group=groupAVWAP, inline="avc")
colorAvwapEU = input.color(#3b82f6, "EU", group=groupAVWAP, inline="avc")
colorAvwapUS = input.color(#22c55e, "US", group=groupAVWAP, inline="avc")
colorAvwapPD = input.color(color.new(#22c55e, 50), "PD", group=groupAVWAP, inline="avc")
showHistoricalAVWAP = input.bool(false, "Show Historical (prev days)", group=groupAVWAP, tooltip="When off, only the current trading day is displayed.")
avwapWidth = input.int(2, "AVWAP Line Width", minval=1, maxval=4, group=groupAVWAP)
showAvwapLabels = input.bool(true, "Labels", group=groupAVWAP, inline="avopt")
showAvwapExtend = input.bool(true, "Extend Lines Right", group=groupAVWAP, inline="avopt")

groupCol = "Colors & Style"
colorScheme = input.string("Wall Street Classic", "Color Theme", options=["Wall Street Classic", "Boreal", "Lady Trader"], group=groupCol)
colorZeroGamma = input.color(#9ca3af, "Zero Gamma", group=groupCol, inline="sys1")
colorMaxPain = input.color(#ef4444, "Max Pain", group=groupCol, inline="sys1")
colorEM = input.color(#3b82f6, "Expected Move", group=groupCol, inline="sys2")
colorVolBand = input.color(#9ca3af, "Vol Bands", group=groupCol, inline="sys2")
colorStructure = input.color(#9ca3af, "Structure", group=groupCol)
colorCharm = input.color(#f97316, "Charm Magnet", group=groupCol)
colorDeltaFlip = input.color(#f59e0b, "Delta Flip", group=groupCol)
lineLeftExt = input.int(50, "Line Left Extension", minval=1, group=groupCol)
lineStyleInput = input.string("Dotted", "Line Style", options=["Solid", "Dashed", "Dotted"], group=groupCol)
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=groupCol)
labelSide = input.string("Left", "Label Side", options=["Left", "Right"], group=groupCol, tooltip="Where level labels render.")
barColorStyle = input.string("Theme Colors", "Profile Bar Color", options=["Theme Colors", "Greyscale"], group=groupCol)

groupConfluence = "Confluence Zones"
showConfluence = input.bool(true, "Show Confluence Zones", group=groupConfluence)
colorConfluence3 = input.color(color.new(#facc15, 75), "3-level", group=groupConfluence, inline="cc1")
colorConfluence4 = input.color(color.new(#fb923c, 70), "4-level", group=groupConfluence, inline="cc1")
colorConfluence5 = input.color(color.new(#ef4444, 65), "5+ (UBER)", group=groupConfluence, inline="cc1")

// ── Confluence Engine v2 ──────────────────────────────────────────────────────
groupC2 = "Confluence v2"
confBandPts    = input.float(12.0, "Banda cluster (punti NQ)", minval=2.0, step=0.5, group=groupC2, tooltip="Ampiezza totale della zona. Con griglie strike a 10 (QQQ) e 25 (NDX) punti, sotto i ~10 punti non intercetti mai una vera coincidenza cross-family.")
confQuantum    = input.float(12.0, "Quanto de-dup intra-famiglia", minval=0.0, step=1.0, group=groupC2, tooltip="Due livelli della STESSA famiglia piu' vicini di questo valore vengono collassati in uno solo (si tiene il piu' pesante). Neutralizza l'arrotondamento a 10 punti degli strike QQQ.")
confDecay      = input.float(0.40, "Decadimento intra-famiglia", minval=0.0, maxval=1.0, step=0.05, group=groupC2, tooltip="Peso del 2o, 3o, ... livello della stessa famiglia nella stessa zona. Livelli correlati non sono prove indipendenti. 1.0 = torni al conteggio di v1.")
confCrossOnly  = input.bool(true,  "Solo zone cross-family", group=groupC2, tooltip="Richiede almeno due famiglie diverse (GEX / PriceAction / BOS / VWAP). E' il filtro che toglie piu' rumore.")
confMinScore   = input.float(2.5,  "Score minimo", minval=0.5, step=0.25, group=groupC2)
confMaxZones   = input.int(6,      "Zone massime", minval=1, maxval=20, group=groupC2)
confSepMult    = input.float(1.5,  "Separazione minima (x banda)", minval=1.0, maxval=4.0, step=0.1, group=groupC2)
confFixBasis   = input.bool(true,  "Correggi drift di basis sui livelli GEX", group=groupC2, tooltip="Gli strike arrivano in spazio NQ con il basis del momento dello snapshot (campo S:). Il carry NQ-NDX decade di ~15-20 punti a settimana e salta al roll. Senza correzione le confluenze cross-family misurano rumore.")
confBasisSym   = input.symbol("CME_MINI:NQ1!", "Future di riferimento", group=groupC2)
confBasisTF    = input.timeframe("5", "Timeframe per la misura del basis", group=groupC2, tooltip="NON usa il timeframe del grafico. NDX non ha dati sotto il minuto: su un grafico a 5 secondi la richiesta torna vuota o congelata, e il basis misurato e' un artefatto. 5 minuti e' il minimo affidabile qualunque sia il grafico.")
confBasisManual = input.float(0.0, "Basis manuale (0 = misurato)", step=1.0, group=groupC2, tooltip="Se i tuoi feed CME o NDX sono in ritardo, il basis misurato sottrae due prezzi presi in momenti diversi ed e' inutilizzabile. In quel caso leggi NQ1! e NDX nello stesso istante a mercato aperto, fai la differenza e scrivila qui.\nControllo di sanita': il carry vale circa spot x (r - q) x giorni/365, quindi qualche decina di punti POSITIVI. Un basis negativo a scadenza lontana significa che stai misurando un artefatto.")
confBasisLen   = input.int(20,     "Finestra mediana basis (barre)", minval=1, maxval=500, group=groupC2)
confDriftCap   = input.float(120.0,"Drift massimo accettato (punti)", minval=10.0, step=10.0, group=groupC2, tooltip="Oltre questa soglia il drift viene ignorato e segnalato: dato molto vecchio, roll in corso, o campo S: assente.")

wZG    = input.float(3.00, "ZeroGamma", group=groupC2, inline="cw1")
wMP    = input.float(1.50, "MaxPain",   group=groupC2, inline="cw1")
wEM    = input.float(1.75, "EM edge",   group=groupC2, inline="cw1")
wVB    = input.float(0.75, "VolBand",   group=groupC2, inline="cw2")
wWall  = input.float(1.00, "Wall base", group=groupC2, inline="cw2")
wCMDF  = input.float(1.60, "Charm/DFlip", group=groupC2, inline="cw2")
wPDay  = input.float(1.50, "PDH/PDL",  group=groupC2, inline="cw3")
wPWk   = input.float(2.00, "PWH/PWL",  group=groupC2, inline="cw3")
wBosM  = input.float(3.00, "BOS M",    group=groupC2, inline="cw4")
wBosW  = input.float(2.50, "BOS W",    group=groupC2, inline="cw4")
wBosD  = input.float(2.00, "BOS D",    group=groupC2, inline="cw4")
wBosI  = input.float(0.75, "BOS H1/H4",group=groupC2, inline="cw4")
wAG    = input.float(2.00, "AbsGEX",   group=groupC2, inline="cw6")
wDEX   = input.float(1.50, "DEX",      group=groupC2, inline="cw6")
wOI    = input.float(1.00, "OI peak",  group=groupC2, inline="cw6")
wVOL   = input.float(1.25, "Vol flow", group=groupC2, inline="cw6")
wVwUS  = input.float(1.50, "VWAP US/PD",   group=groupC2, inline="cw5")
wVwEA  = input.float(0.90, "VWAP EU/Asia", group=groupC2, inline="cw5")

// ── Livelli esterni da altri indicatori sul grafico ──────────────────────────
// input.source() aggancia il plot di UN ALTRO indicatore presente sul grafico
// (TanukiTrade, TLADe, qualunque cosa esponga un plot). E' l'unico ponte
// legittimo fra due script: nessun reverse engineering, nessun dato copiato.
// Peso 0 = slot spento. Necessario perche' input.source() non ha un valore
// "nessuno": lasciato al default punta a close, e un livello sempre esattamente
// sul prezzo avvelenerebbe ogni zona.
groupExt = "Livelli esterni (altri indicatori)"
extFamilyMode = input.string("GEX (evita doppio conteggio)", "Famiglia dei livelli esterni", options=["GEX (evita doppio conteggio)", "Famiglia indipendente"], group=groupExt, tooltip="Se la fonte esterna e' anch'essa options-derived (GEX, HVL, walls), tenerla nella famiglia GEX: altrimenti la stessa informazione verrebbe contata due volte come se fossero prove indipendenti. Scegli 'indipendente' solo per fonti di natura diversa.")
ext1n = input.string("HVL / Zero Gamma", "1", group=groupExt, inline="e1")
ext1s = input.source(close, "", group=groupExt, inline="e1")
ext1w = input.float(0.0, "w", minval=0.0, step=0.25, group=groupExt, inline="e1")
ext2n = input.string("Call Wall", "2", group=groupExt, inline="e2")
ext2s = input.source(close, "", group=groupExt, inline="e2")
ext2w = input.float(0.0, "w", minval=0.0, step=0.25, group=groupExt, inline="e2")
ext3n = input.string("Put Wall", "3", group=groupExt, inline="e3")
ext3s = input.source(close, "", group=groupExt, inline="e3")
ext3w = input.float(0.0, "w", minval=0.0, step=0.25, group=groupExt, inline="e3")
ext4n = input.string("Call Resistance", "4", group=groupExt, inline="e4")
ext4s = input.source(close, "", group=groupExt, inline="e4")
ext4w = input.float(0.0, "w", minval=0.0, step=0.25, group=groupExt, inline="e4")
ext5n = input.string("Put Support", "5", group=groupExt, inline="e5")
ext5s = input.source(close, "", group=groupExt, inline="e5")
ext5w = input.float(0.0, "w", minval=0.0, step=0.25, group=groupExt, inline="e5")
ext6n = input.string("Extra", "6", group=groupExt, inline="e6")
ext6s = input.source(close, "", group=groupExt, inline="e6")
ext6w = input.float(0.0, "w", minval=0.0, step=0.25, group=groupExt, inline="e6")
extShowLines = input.bool(true, "Disegna anche le linee dei livelli esterni", group=groupExt)
extColor = input.color(#a855f7, "Colore", group=groupExt)

// ── Coerenza fra timeframe del grafico e logiche interne ─────────────────────
groupTF = "Timeframe & conferme"
wallFlipTF  = input.timeframe("5", "Timeframe conferma wall-flip", group=groupTF, tooltip="Timeframe su cui si contano le chiusure oltre un muro. NON e' quello del grafico: se il grafico e' piu' lento, si usa direttamente la chiusura del grafico (altrimenti si perderebbero chiusure); se e' piu' veloce, si legge la barra superiore GIA' CHIUSA, senza ripintura.")
wallFlipN   = input.int(2, "Chiusure consecutive per il flip", minval=1, maxval=10, group=groupTF)
wallFlipBuf = input.float(0.0, "Buffer oltre il livello (punti)", minval=0.0, step=0.25, group=groupTF, tooltip="Due chiusure un tick oltre un muro sono rumore: attorno a un muro e' esattamente cio' che il prezzo fa. Con 3-5 punti su NQ chiedi che il livello sia davvero superato.")
tfGuard     = input.bool(true, "Disattiva le logiche incompatibili col timeframe", group=groupTF, tooltip="Sopra il giornaliero session box e AVWAP non hanno significato; un livello BOS su timeframe inferiore a quello del grafico non e' calcolabile. Con questa opzione vengono spenti invece di produrre valori inventati.")

groupAlerts = "Alerts"
enableAlerts = input.bool(false, "Enable Level Cross Alerts", group=groupAlerts)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  CORE FUNCTIONS                                                              ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

f_convertPrice(float nqPrice) =>
    float adj = nqPrice + gexDrift
    tickerChoice == "NDX" ? adj - gexBasisUse : tickerChoice == "QQQ" ? (adj - gexBasisUse) / ndxQqqRatio : adj

f_formatPrice(float nqPrice) =>
    float cv = f_convertPrice(nqPrice)
    tickerChoice == "QQQ" ? str.tostring(cv, "#.##") : str.tostring(cv, "#")

f_lineStyle(string s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

color colorPos = colorScheme == "Boreal" ? #22d3ee : colorScheme == "Lady Trader" ? #2dd4bf : #22c55e
color colorNeg = colorScheme == "Boreal" ? #f472b6 : colorScheme == "Lady Trader" ? #c084fc : #ef4444

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  STATE                                                                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

var box[] gexBoxes = array.new_box()
var box[] confluenceBoxes = array.new_box()
var label[] confluenceLabels = array.new_label()
var line[] gexLines = array.new_line()
var label[] gexLabels = array.new_label()
var label timestampLabel = na
var label ratioErrLabel = na
var string prevState = ""
var int lastBarIdx = -1

var line[] bosLines = array.new_line()
var label[] bosLabels = array.new_label()
var float[] bosLevels = array.new_float()
var bool[] bosBullish = array.new_bool()
var string[] bosTF = array.new_string()

var float[]  wallStrikes  = array.new_float()
var string[] wallTypes    = array.new_string()
var int[]    wallCounters = array.new_int()
var bool[]   wallFlipped  = array.new_bool()
var string   wallParseKey = ""

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  BREAKOUT STRUCTURE                                                          ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

bool mChanged  = ta.change(time("M")) != 0
bool wChanged  = ta.change(time("W")) != 0
bool dChanged  = ta.change(time("D")) != 0
bool h4Changed = ta.change(time("240")) != 0
bool h1Changed = ta.change(time("60")) != 0

[mPrevH, mPrevL, mCurrC, mCurrH, mCurrL]      = request.security(syminfo.tickerid, "M",   [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[wPrevH, wPrevL, wCurrC, wCurrH, wCurrL]      = request.security(syminfo.tickerid, "W",   [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[dPrevH, dPrevL, dCurrC, dCurrH, dCurrL]      = request.security(syminfo.tickerid, "D",   [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[h4PrevH, h4PrevL, h4CurrC, h4CurrH, h4CurrL] = request.security(syminfo.tickerid, "240", [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)
[h1PrevH, h1PrevL, h1CurrC, h1CurrH, h1CurrL] = request.security(syminfo.tickerid, "60",  [high[1], low[1], close, high, low], lookahead=barmerge.lookahead_off)

// Conferma del wall-flip, valida su QUALUNQUE timeframe.
//  - grafico piu' lento o uguale al TF di conferma  -> si usa la chiusura del
//    grafico stessa: chiedere un TF piu' veloce restituirebbe una sola
//    sotto-barra per barra, perdendo le altre chiusure.
//  - grafico piu' veloce -> si legge la barra superiore GIA' completata
//    (valore alla barra precedente il cambio di timestamp): niente ripintura.
float tfSec   = timeframe.in_seconds(timeframe.period)
float flipSec = timeframe.in_seconds(wallFlipTF)
bool  flipOnChart = tfSec >= flipSec

[cFlipHTF, tFlipHTF] = request.security(syminfo.tickerid, wallFlipTF, [close, time], lookahead=barmerge.lookahead_off)
bool  newFlipBar = flipOnChart ? barstate.isconfirmed : ta.change(tFlipHTF) != 0
float flipClose  = flipOnChart ? close : nz(cFlipHTF[1], cFlipHTF)

// Logiche che dipendono da un tempo lineare o da un TF minimo.
bool sessOK  = not tfGuard or tfSec < 86400
bool bosOKH1 = not tfGuard or tfSec <= 3600
bool bosOKH4 = not tfGuard or tfSec <= 14400
bool bosOKD  = not tfGuard or tfSec <= 86400
bool bosOKW  = not tfGuard or tfSec <= 604800

// ── Basis live: NQ - NDX misurato adesso, indipendente dal ticker a grafico ──
// MEDIANA e non media: NQ1! e' un continuous, al roll il basis salta di decine
// di punti in un tick e una media resta sbagliata per tutta la sua finestra.
// Timeframe fisso, non quello del grafico: NDX non quota sotto il minuto, e su
// un chart a 5 secondi la misura del basis e' rumore congelato.
nqLiveC  = request.security(confBasisSym, confBasisTF, close, barmerge.gaps_off, barmerge.lookahead_off)
ndxLiveC = request.security("NASDAQ:NDX", confBasisTF, close, barmerge.gaps_off, barmerge.lookahead_off)
float basisRawC  = nqLiveC - ndxLiveC
float basisLiveC = confBasisManual != 0.0 ? confBasisManual : ta.median(nz(basisRawC), confBasisLen)

f_pushLvl(array<float> aPx, array<float> aW, array<int> aFam, array<string> aNm, float px, float w, int fam, string nm) =>
    if not na(px) and w > 0
        array.push(aPx, px)
        array.push(aW,  w)
        array.push(aFam, fam)
        array.push(aNm, nm)

// Somma con rendimento decrescente: livelli della stessa famiglia sono misure
// correlate, quindi il 2o, il 3o... contano progressivamente meno.
f_famScore(array<float> ws, float decay) =>
    array.sort(ws, order.descending)
    float s = 0.0
    float k = 1.0
    for w in ws
        s += w * k
        k *= decay
    s

f_checkBOS(float prevH, float prevL, float currC, float currH, float currL, bool changed, bool enabled) =>
    float bullLevel = na
    float bearLevel = na
    if enabled and changed and not na(prevH)
        if currC > prevH
            float bodyAbove = currC - prevH
            float upperShadow = currH - currC
            if bodyAbove > upperShadow and bodyAbove > 0
                bullLevel := prevH
        if currC < prevL
            float bodyBelow = prevL - currC
            float lowerShadow = currC - currL
            if bodyBelow > lowerShadow and bodyBelow > 0
                bearLevel := prevL
    [bullLevel, bearLevel]

[mBull, mBear]   = f_checkBOS(mPrevH, mPrevL, mCurrC, mCurrH, mCurrL, mChanged, showBOS_M)
[wBull, wBear]   = f_checkBOS(wPrevH, wPrevL, wCurrC, wCurrH, wCurrL, wChanged, showBOS_W and bosOKW)
[dBull, dBear]   = f_checkBOS(dPrevH, dPrevL, dCurrC, dCurrH, dCurrL, dChanged, showBOS_D and bosOKD)
[h4Bull, h4Bear] = f_checkBOS(h4PrevH, h4PrevL, h4CurrC, h4CurrH, h4CurrL, h4Changed, showBOS_H4 and bosOKH4)
[h1Bull, h1Bear] = f_checkBOS(h1PrevH, h1PrevL, h1CurrC, h1CurrH, h1CurrL, h1Changed, showBOS_H1 and bosOKH1)

// I livelli BOS vengono dall'OHLC del grafico: sono GIA' in scala grafico e non
// vanno riconvertiti (era il bug che li spostava di 178 punti su chart NDX).
f_addBOS(float level, bool isBull, string tf) =>
    if not na(level)
        float cv = level
        color clr = isBull ? colorBOS_Bull : colorBOS_Bear
        int w = tf == "M" ? bosLineWidth + 2 : tf == "W" ? bosLineWidth + 1 : tf == "D" ? bosLineWidth : math.max(bosLineWidth - 1, 1)
        bool solid = tf == "M" or tf == "W" or tf == "D"
        line newL = line.new(bar_index, cv, bar_index + 1, cv, color=clr, style=solid ? line.style_solid : line.style_dashed, width=w, extend=extend.right)
        array.push(bosLines, newL)
        string dir = isBull ? "+" : "-"
        label newLbl = label.new(bar_index, cv, tf + dir, color=color.new(clr, 50), textcolor=color.white, style=isBull ? label.style_label_up : label.style_label_down, size=size.tiny)
        array.push(bosLabels, newLbl)
        array.push(bosLevels, cv)
        array.push(bosBullish, isBull)
        array.push(bosTF, tf)

f_addBOS(mBull, true, "M")
f_addBOS(mBear, false, "M")
f_addBOS(wBull, true, "W")
f_addBOS(wBear, false, "W")
f_addBOS(dBull, true, "D")
f_addBOS(dBear, false, "D")
f_addBOS(h4Bull, true, "H4")
f_addBOS(h4Bear, false, "H4")
f_addBOS(h1Bull, true, "H1")
f_addBOS(h1Bear, false, "H1")

if array.size(bosLines) > 0
    int i = array.size(bosLines) - 1
    while i >= 0
        float lvl = array.get(bosLevels, i)
        bool isBull = array.get(bosBullish, i)
        bool broken = isBull ? close < lvl : close > lvl
        if broken
            line.delete(array.get(bosLines, i))
            label.delete(array.get(bosLabels, i))
            array.remove(bosLines, i)
            array.remove(bosLabels, i)
            array.remove(bosLevels, i)
            array.remove(bosBullish, i)
            array.remove(bosTF, i)
        i -= 1

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  WALL FLIP TRACKING — 5m close based                                         ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

f_parseWalls(string dataStr) =>
    array.clear(wallStrikes)
    array.clear(wallTypes)
    array.clear(wallCounters)
    array.clear(wallFlipped)
    string rest = dataStr
    if str.startswith(rest, "S:")
        int sEnd = str.pos(rest, "|")
        if sEnd > 2
            rest := str.substring(rest, sEnd + 1)
    if str.startswith(rest, "R:")
        int rEnd = str.pos(rest, "|")
        if rEnd > 2
            rest := str.substring(rest, rEnd + 1)
    string lvlSection = rest
    if str.contains(rest, "|P:")
        int pp = str.pos(rest, "|P:")
        lvlSection := str.substring(rest, 0, pp)
    if str.startswith(lvlSection, "L:")
        lvlSection := str.substring(lvlSection, 2)
    if lvlSection != ""
        string[] pairs = str.split(lvlSection, ";")
        for pair in pairs
            string[] p = str.split(pair, ",")
            if array.size(p) >= 2
                float s = str.tonumber(array.get(p, 0))
                string t = array.get(p, 1)
                if not na(s) and (t == "CW" or t == "PW")
                    array.push(wallStrikes, s)
                    array.push(wallTypes, t)
                    array.push(wallCounters, 0)
                    array.push(wallFlipped, false)

f_getWallFlipped(float strike) =>
    bool found = false
    int n = array.size(wallStrikes)
    int i = 0
    while i < n and not found
        if array.get(wallStrikes, i) == strike
            found := array.get(wallFlipped, i)
            i := n
        else
            i += 1
    found

if wallParseKey != gexDataActive
    wallParseKey := gexDataActive
    f_parseWalls(gexDataActive)

if newFlipBar and array.size(wallStrikes) > 0
    float close5mNQ = flipClose
    if tickerChoice == "NDX"
        close5mNQ := flipClose + nqNdxSpread
    else if tickerChoice == "QQQ"
        close5mNQ := flipClose * ndxQqqRatio + nqNdxSpread
    int n = array.size(wallStrikes)
    for i = 0 to n - 1
        float strike = array.get(wallStrikes, i) + gexDrift
        string wType = array.get(wallTypes, i)
        bool   isF   = array.get(wallFlipped, i)
        int    cnt   = array.get(wallCounters, i)
        bool beyond = false
        // Buffer: un muro non e' un prezzo, e' una zona. Chiusure a un tick oltre
        // sono la normale raccolta di liquidita', non un cambio di ruolo.
        float up = strike + wallFlipBuf
        float dn = strike - wallFlipBuf
        if wType == "CW"
            beyond := isF ? close5mNQ < dn : close5mNQ > up
        else if wType == "PW"
            beyond := isF ? close5mNQ > up : close5mNQ < dn
        if beyond
            cnt += 1
            if cnt >= wallFlipN
                isF := not isF
                cnt := 0
        else
            cnt := 0
        array.set(wallCounters, i, cnt)
        array.set(wallFlipped, i, isF)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  SESSION BOXES                                                               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

int etHour = hour(time, "America/New_York")
int etMin  = minute(time, "America/New_York")
int etMins = etHour * 60 + etMin

bool inAsia = etMins >= 1080 or etMins < 180
bool inEU   = etMins >= 180 and etMins < 480
bool inPre  = etMins >= 480 and etMins < 570
bool inUS   = etMins >= 570 and etMins < 960

var box curAsiaBox = na
var float _asiaHi = na
var float _asiaLo = na
var bool _asiaActive = false
var box curEUBox = na
var float _euHi = na
var float _euLo = na
var bool _euActive = false
var box curPreBox = na
var float _preHi = na
var float _preLo = na
var bool _preActive = false
var box curUSBox = na
var float _usHi = na
var float _usLo = na
var bool _usActive = false

bool recentSessionOnly = sessOK and (showHistoricalSessions or (time >= timenow - 30 * 3600000))

if showSessions and showAsia and recentSessionOnly
    if inAsia
        if not _asiaActive
            _asiaActive := true
            _asiaHi := high
            _asiaLo := low
            curAsiaBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorAsia, 70), border_width=1, bgcolor=colorAsia)
        else
            _asiaHi := math.max(_asiaHi, high)
            _asiaLo := math.min(_asiaLo, low)
            if not na(curAsiaBox)
                box.set_right(curAsiaBox, bar_index)
                box.set_top(curAsiaBox, _asiaHi)
                box.set_bottom(curAsiaBox, _asiaLo)
    else
        _asiaActive := false

if showSessions and showEU and recentSessionOnly
    if inEU
        if not _euActive
            _euActive := true
            _euHi := high
            _euLo := low
            curEUBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorEU, 70), border_width=1, bgcolor=colorEU)
        else
            _euHi := math.max(_euHi, high)
            _euLo := math.min(_euLo, low)
            if not na(curEUBox)
                box.set_right(curEUBox, bar_index)
                box.set_top(curEUBox, _euHi)
                box.set_bottom(curEUBox, _euLo)
    else
        _euActive := false

if showSessions and showPre and recentSessionOnly
    if inPre
        if not _preActive
            _preActive := true
            _preHi := high
            _preLo := low
            curPreBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorPre, 70), border_width=1, bgcolor=colorPre)
        else
            _preHi := math.max(_preHi, high)
            _preLo := math.min(_preLo, low)
            if not na(curPreBox)
                box.set_right(curPreBox, bar_index)
                box.set_top(curPreBox, _preHi)
                box.set_bottom(curPreBox, _preLo)
    else
        _preActive := false

if showSessions and showUS and recentSessionOnly
    if inUS
        if not _usActive
            _usActive := true
            _usHi := high
            _usLo := low
            curUSBox := box.new(bar_index, high, bar_index, low, border_color=color.new(colorUS, 70), border_width=1, bgcolor=colorUS)
        else
            _usHi := math.max(_usHi, high)
            _usLo := math.min(_usLo, low)
            if not na(curUSBox)
                box.set_right(curUSBox, bar_index)
                box.set_top(curUSBox, _usHi)
                box.set_bottom(curUSBox, _usLo)
    else
        _usActive := false

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  SESSION AVWAP                                                               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

float src = hlc3
float vol = nz(volume, 1)

bool asiaStart = inAsia and not inAsia[1]
bool euStart   = inEU   and not inEU[1]
bool usStart   = inUS   and not inUS[1]

var bool inCurrentDay = false
if asiaStart
    inCurrentDay := true

bool inGap = etMins >= 960 and etMins < 1080
if inGap
    inCurrentDay := false

var float aSumPV = 0.0
var float aSumV  = 0.0
var bool asiaActive = false
if asiaStart
    aSumPV := src * vol
    aSumV  := vol
    asiaActive := true
else if asiaActive and inCurrentDay
    aSumPV += src * vol
    aSumV  += vol
float avwapAsia = aSumV > 0 ? aSumPV / aSumV : na

var float eSumPV = 0.0
var float eSumV  = 0.0
var bool euActive = false
if asiaStart
    euActive := false
if euStart
    eSumPV := src * vol
    eSumV  := vol
    euActive := true
else if euActive and inCurrentDay
    eSumPV += src * vol
    eSumV  += vol
float avwapEU = eSumV > 0 ? eSumPV / eSumV : na

var float uSumPV = 0.0
var float uSumV  = 0.0
var bool usActive = false
if asiaStart
    usActive := false
if usStart
    uSumPV := src * vol
    uSumV  := vol
    usActive := true
else if usActive and inUS
    uSumPV += src * vol
    uSumV  += vol
float avwapUS = uSumV > 0 ? uSumPV / uSumV : na

var float pdSumPV = 0.0
var float pdSumV  = 0.0
if asiaStart and uSumV > 0
    pdSumPV := uSumPV
    pdSumV  := uSumV
else if pdSumV > 0 and inCurrentDay
    pdSumPV += src * vol
    pdSumV  += vol
float avwapPD = pdSumV > 0 ? pdSumPV / pdSumV : na

bool recentOnly = sessOK and (showHistoricalAVWAP or (time >= timenow - 30 * 3600000))
float pAsia = showAVWAP and showAvwapAsia and asiaActive and inCurrentDay and recentOnly ? avwapAsia : na
float pEU   = showAVWAP and showAvwapEU   and euActive   and inCurrentDay and recentOnly ? avwapEU   : na
float pUS   = showAVWAP and showAvwapUS   and usActive   and inUS         and recentOnly ? avwapUS   : na
float pPD   = showAVWAP and showAvwapPD   and pdSumV > 0 and inCurrentDay and recentOnly ? avwapPD   : na

plot(pAsia, "AVWAP Asia",    color=colorAvwapAsia, linewidth=avwapWidth, style=plot.style_linebr)
plot(pEU,   "AVWAP EU",      color=colorAvwapEU,   linewidth=avwapWidth, style=plot.style_linebr)
plot(pUS,   "AVWAP US",      color=colorAvwapUS,   linewidth=avwapWidth, style=plot.style_linebr)
plot(pPD,   "AVWAP US Prev", color=colorAvwapPD,   linewidth=avwapWidth, style=plot.style_linebr)

var line avwapLineAsia = na
var line avwapLineEU   = na
var line avwapLineUS   = na
var line avwapLinePD   = na

if showAVWAP and showAvwapExtend and barstate.islast
    if showAvwapAsia and not na(pAsia)
        if na(avwapLineAsia)
            avwapLineAsia := line.new(bar_index, pAsia, bar_index + 1, pAsia, color=colorAvwapAsia, width=avwapWidth, style=line.style_dotted, extend=extend.right)
        else
            line.set_xy1(avwapLineAsia, bar_index, pAsia)
            line.set_xy2(avwapLineAsia, bar_index + 1, pAsia)
    if showAvwapEU and not na(pEU)
        if na(avwapLineEU)
            avwapLineEU := line.new(bar_index, pEU, bar_index + 1, pEU, color=colorAvwapEU, width=avwapWidth, style=line.style_dotted, extend=extend.right)
        else
            line.set_xy1(avwapLineEU, bar_index, pEU)
            line.set_xy2(avwapLineEU, bar_index + 1, pEU)
    if showAvwapUS and not na(pUS)
        if na(avwapLineUS)
            avwapLineUS := line.new(bar_index, pUS, bar_index + 1, pUS, color=colorAvwapUS, width=avwapWidth, style=line.style_dotted, extend=extend.right)
        else
            line.set_xy1(avwapLineUS, bar_index, pUS)
            line.set_xy2(avwapLineUS, bar_index + 1, pUS)
    if showAvwapPD and not na(pPD)
        if na(avwapLinePD)
            avwapLinePD := line.new(bar_index, pPD, bar_index + 1, pPD, color=colorAvwapPD, width=avwapWidth, style=line.style_dashed, extend=extend.right)
        else
            line.set_xy1(avwapLinePD, bar_index, pPD)
            line.set_xy2(avwapLinePD, bar_index + 1, pPD)

var label avwapLblAsia = na
var label avwapLblEU   = na
var label avwapLblUS   = na
var label avwapLblPD   = na

if showAVWAP and showAvwapLabels and barstate.islast
    if showAvwapAsia and not na(pAsia)
        if na(avwapLblAsia)
            avwapLblAsia := label.new(bar_index + 3, pAsia, "ASIA " + str.tostring(pAsia, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapAsia)
        else
            label.set_xy(avwapLblAsia, bar_index + 3, pAsia)
            label.set_text(avwapLblAsia, "ASIA " + str.tostring(pAsia, format.mintick))
    if showAvwapEU and not na(pEU)
        if na(avwapLblEU)
            avwapLblEU := label.new(bar_index + 3, pEU, "EU " + str.tostring(pEU, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapEU)
        else
            label.set_xy(avwapLblEU, bar_index + 3, pEU)
            label.set_text(avwapLblEU, "EU " + str.tostring(pEU, format.mintick))
    if showAvwapUS and not na(pUS)
        if na(avwapLblUS)
            avwapLblUS := label.new(bar_index + 3, pUS, "US " + str.tostring(pUS, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapUS)
        else
            label.set_xy(avwapLblUS, bar_index + 3, pUS)
            label.set_text(avwapLblUS, "US " + str.tostring(pUS, format.mintick))
    if showAvwapPD and not na(pPD)
        if na(avwapLblPD)
            avwapLblPD := label.new(bar_index + 3, pPD, "US PD " + str.tostring(pPD, format.mintick), style=label.style_label_left, size=size.small, textcolor=color.white, color=colorAvwapPD)
        else
            label.set_xy(avwapLblPD, bar_index + 3, pPD)
            label.set_text(avwapLblPD, "US PD " + str.tostring(pPD, format.mintick))

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  GEX LEVELS + PROFILE + CONFLUENCE v2  (solo ultima barra)                   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

string stateKey = gexDataActive + str.tostring(profileWidth) + str.tostring(barThickness) + str.tostring(profileOffset) + colorScheme + barColorStyle + lineStyleInput + str.tostring(lineWidth) + str.tostring(lineLeftExt) + tickerChoice
bool needsRedraw = barstate.islast and (stateKey != prevState or bar_index != lastBarIdx)

if needsRedraw
    for b in gexBoxes
        box.delete(b)
    array.clear(gexBoxes)
    for l in gexLines
        line.delete(l)
    array.clear(gexLines)
    for lbl in gexLabels
        label.delete(lbl)
    array.clear(gexLabels)
    if not na(timestampLabel)
        label.delete(timestampLabel)
    if not na(ratioErrLabel)
        label.delete(ratioErrLabel)
        ratioErrLabel := na

    lastBarIdx := bar_index
    timestampLabel := label.new(bar_index + profileOffset, high + syminfo.mintick * 50, "TLADe " + tickerChoice, color=color.new(color.gray, 100), style=label.style_label_center, textcolor=color.new(color.gray, 40), size=size.tiny)

    string levelsData = ""
    string profileData = ""
    string rawInput = gexDataActive

    if str.startswith(rawInput, "S:")
        int sEnd = str.pos(rawInput, "|")
        if sEnd > 2
            float parsedSpread = str.tonumber(str.substring(rawInput, 2, sEnd))
            if not na(parsedSpread) and parsedSpread > 0
                nqNdxSpread := parsedSpread
            rawInput := str.substring(rawInput, sEnd + 1)

    if str.startswith(rawInput, "R:")
        int rEnd = str.pos(rawInput, "|")
        if rEnd > 2
            float parsedRatio = str.tonumber(str.substring(rawInput, 2, rEnd))
            if not na(parsedRatio) and parsedRatio > 0
                ndxQqqRatio := parsedRatio
                ndxQqqRatioLoaded := true
            rawInput := str.substring(rawInput, rEnd + 1)

    // Drift = basis di adesso meno il basis congelato nel campo S:. Va applicato
    // PRIMA di disegnare qualsiasi cosa, altrimenti linee e zone divergono.
    // Quanto basis e' gia' incorporato negli strike: in spazio NQ e' il campo S:,
    // in spazio NDX e' zero e va sommato tutto il basis vivo.
    bool  spaceNDX = strikeSpaceMode == "NDX"
    float sRef = spaceNDX ? 0.0 : nqNdxSpread
    float dRaw = na(basisLiveC) ? na : basisLiveC - sRef
    // In spazio NDX senza un basis valido i livelli finirebbero sul grafico
    // decine di punti fuori posto, quindi e' un errore, non un caso limite.
    gexDriftBad := na(dRaw) ? spaceNDX : spaceNDX ? (dRaw < -20 or dRaw > 400) : math.abs(dRaw) > confDriftCap
    gexDrift    := not na(dRaw) and not gexDriftBad and (confFixBasis or spaceNDX) ? dRaw : 0.0
    gexBasisUse := na(basisLiveC) or basisLiveC == 0.0 ? nqNdxSpread : basisLiveC

    if str.contains(rawInput, "|P:")
        int pipePos = str.pos(rawInput, "|P:")
        string beforePipe = str.substring(rawInput, 0, pipePos)
        profileData := str.substring(rawInput, pipePos + 3)
        if str.startswith(beforePipe, "L:")
            levelsData := str.substring(beforePipe, 2)
    else
        profileData := rawInput

    bool qqqNoRatio = tickerChoice == "QQQ" and not ndxQqqRatioLoaded
    if qqqNoRatio
        ratioErrLabel := label.new(bar_index, high, "TLADe: QQQ ratio missing — re-copy the data string from the terminal (must include R:).", color=color.new(color.red, 0), style=label.style_label_down, textcolor=color.white, size=size.small)

    // ── livelli ─────────────────────────────────────────────────────────────
    if levelsData != "" and not qqqNoRatio
        string[] levelPairs = str.split(levelsData, ";")
        int gexAboveDrawn = 0
        int gexBelowDrawn = 0
        int halfMax = math.ceil(maxVisibleLevels / 2)

        float closestAbove = na
        float closestAboveDist = 999999.0
        float closestBelow = na
        float closestBelowDist = 999999.0
        for lvlPair in levelPairs
            string[] p = str.split(lvlPair, ",")
            if array.size(p) >= 3
                float s = str.tonumber(array.get(p, 0))
                string t = array.get(p, 1)
                if not na(s) and (t == "CW" or t == "PW")
                    float cv = f_convertPrice(s)
                    float dist = math.abs(cv - close)
                    if cv > close and dist < closestAboveDist
                        closestAboveDist := dist
                        closestAbove := cv
                    else if cv <= close and dist < closestBelowDist
                        closestBelowDist := dist
                        closestBelow := cv

        for lvlPair in levelPairs
            string[] p = str.split(lvlPair, ",")
            if array.size(p) >= 3
                float lvlStrike = str.tonumber(array.get(p, 0))
                string lvlType = array.get(p, 1)
                string lvlLabel = array.get(p, 2)
                string lvlTooltip = array.size(p) >= 4 ? str.replace_all(array.get(p, 3), "~", "\n") : ""
                float lvlMag = array.size(p) >= 5 ? str.tonumber(array.get(p, 4)) : 0.0

                if not na(lvlStrike)
                    float cv = f_convertPrice(lvlStrike)
                    bool inRange = not showOnlyNear or (math.abs(close - cv) / close * 100.0 <= nearPct)
                    bool isGex = lvlType == "CW" or lvlType == "PW"
                    bool isSys = lvlType == "ZG" or lvlType == "MP" or lvlType == "EH" or lvlType == "EL" or lvlType == "VH" or lvlType == "VL"
                    bool isSec = lvlType == "AG" or lvlType == "DP" or lvlType == "DN" or lvlType == "OC" or lvlType == "OP" or lvlType == "OA" or lvlType == "VC" or lvlType == "VP"
                    bool isCM = lvlType == "CM"
                    bool isDF = lvlType == "DF"
                    bool passThresh = not enableThreshold or not isGex or nz(lvlMag) >= gexThreshold or nz(lvlMag) == 0.0
                    bool isAbove = cv > close
                    bool isProtected = (not na(closestAbove) and cv == closestAbove) or (not na(closestBelow) and cv == closestBelow)

                    bool shouldShow = false
                    if isGex and showGexLevels and passThresh
                        shouldShow := isProtected or (isAbove ? gexAboveDrawn < halfMax : gexBelowDrawn < halfMax)
                    else if isSys and showSystemLevels
                        shouldShow := true
                    else if isCM and showCharmMagnet
                        shouldShow := true
                    else if isDF and showDeltaFlip
                        shouldShow := true
                    else if isSec and showSecondary
                        shouldShow := true

                    if shouldShow and inRange
                        color lvlColor = color.gray
                        int sc = 0
                        string finalTT = lvlTooltip
                        bool isWallFlipped = false

                        if lvlType == "CW"
                            isWallFlipped := f_getWallFlipped(lvlStrike)
                            lvlColor := colorNeg
                            if not isProtected
                                if isAbove
                                    gexAboveDrawn += 1
                                else
                                    gexBelowDrawn += 1
                            finalTT += "\n" + (isWallFlipped ? "Flipped Res -> Sup (2x 5m close beyond)" : "Resistance")
                        else if lvlType == "PW"
                            isWallFlipped := f_getWallFlipped(lvlStrike)
                            lvlColor := colorPos
                            if not isProtected
                                if isAbove
                                    gexAboveDrawn += 1
                                else
                                    gexBelowDrawn += 1
                            finalTT += "\n" + (isWallFlipped ? "Flipped Sup -> Res (2x 5m close beyond)" : "Support")
                        else if lvlType == "ZG"
                            lvlColor := colorZeroGamma
                            zgLevel := cv
                        else if lvlType == "MP"
                            lvlColor := colorMaxPain
                            sc := 2
                        else if lvlType == "EH" or lvlType == "EL"
                            lvlColor := colorEM
                            sc := 1
                        else if lvlType == "VH" or lvlType == "VL"
                            lvlColor := colorVolBand
                            sc := 2
                        else if lvlType == "CM"
                            lvlColor := colorCharm
                        else if lvlType == "DF"
                            lvlColor := colorDeltaFlip
                            sc := 1
                        else if isSec
                            lvlColor := colorSecondary
                            sc := 2

                        string ls = sc == 2 ? line.style_dotted : sc == 1 ? line.style_dashed : f_lineStyle(lineStyleInput)
                        if isCM
                            ls := line.style_solid
                        int useWidth = isWallFlipped ? math.max(lineWidth - 1, 1) : lineWidth
                        array.push(gexLines, line.new(bar_index - lineLeftExt, cv, bar_index + profileOffset, cv, color=lvlColor, style=ls, width=useWidth, extend=extend.both))
                        string flipSuffix = isWallFlipped ? " (F)" : ""
                        string dLabel = f_formatPrice(lvlStrike) + " " + lvlType + " " + lvlLabel + flipSuffix
                        int lblX = labelSide == "Right" ? bar_index + profileOffset + profileWidth + 5 : bar_index - lineLeftExt
                        array.push(gexLabels, label.new(lblX, cv, dLabel, color=lvlColor, style=label.style_label_left, textcolor=color.white, size=size.small, tooltip=finalTT))

    // ── price action dall'OHLC del grafico ──────────────────────────────────
    if showStructureLevels
        float[]  paPrices = array.from(dPrevH, dPrevL, wPrevH, wPrevL)
        string[] paCodes  = array.from("PDH", "PDL", "PWH", "PWL")
        string[] paNames  = array.from("Prior Day High", "Prior Day Low", "Prior Week High", "Prior Week Low")
        for pi = 0 to 3
            float paPrice = array.get(paPrices, pi)
            if not na(paPrice)
                array.push(gexLines, line.new(bar_index - lineLeftExt, paPrice, bar_index + profileOffset, paPrice, color=colorStructure, style=line.style_dotted, width=lineWidth, extend=extend.both))
                int paLblX = labelSide == "Right" ? bar_index + profileOffset + profileWidth + 5 : bar_index - lineLeftExt
                array.push(gexLabels, label.new(paLblX, paPrice, str.tostring(paPrice, format.mintick) + " " + array.get(paCodes, pi) + " " + array.get(paNames, pi), color=colorStructure, style=label.style_label_left, textcolor=color.white, size=size.small))

    // ── livelli esterni ─────────────────────────────────────────────────────
    if extShowLines
        float[]  exP = array.from(ext1w > 0 ? ext1s : na, ext2w > 0 ? ext2s : na, ext3w > 0 ? ext3s : na, ext4w > 0 ? ext4s : na, ext5w > 0 ? ext5s : na, ext6w > 0 ? ext6s : na)
        string[] exN = array.from(ext1n, ext2n, ext3n, ext4n, ext5n, ext6n)
        for ei = 0 to 5
            float exv = array.get(exP, ei)
            if not na(exv)
                array.push(gexLines, line.new(bar_index - lineLeftExt, exv, bar_index + profileOffset, exv, color=extColor, style=line.style_dashed, width=lineWidth, extend=extend.both))
                int exX = labelSide == "Right" ? bar_index + profileOffset + profileWidth + 5 : bar_index - lineLeftExt
                array.push(gexLabels, label.new(exX, exv, str.tostring(exv, format.mintick) + "  " + array.get(exN, ei), color=extColor, style=label.style_label_left, textcolor=color.white, size=size.small))

    // ── profilo ─────────────────────────────────────────────────────────────
    if showProfile and profileData != ""
        string[] forzaPairs = str.split(str.replace_all(profileData, "\n", ""), ";")
        float maxAbsForza = 10.0
        float boxH = barThickness * syminfo.mintick
        int xZero = bar_index + profileOffset
        for pair in forzaPairs
            string[] parts = str.split(pair, ",")
            if array.size(parts) == 3
                float esStrike = str.tonumber(array.get(parts, 0))
                float forza = str.tonumber(array.get(parts, 1))
                float sign = str.tonumber(array.get(parts, 2))
                if not na(esStrike) and not na(forza)
                    float cvStrike = f_convertPrice(esStrike)
                    int barLen = int((forza / maxAbsForza) * profileWidth)
                    float intensity = math.abs(forza) / maxAbsForza
                    int fillT = int(80 - intensity * 50)
                    color barCall = barColorStyle == "Greyscale" ? #a0a0a0 : colorNeg
                    color barPut = barColorStyle == "Greyscale" ? #505050 : colorPos
                    color baseC = sign >= 0 ? barCall : barPut
                    array.push(gexBoxes, box.new(xZero, cvStrike + boxH / 2, xZero + barLen, cvStrike - boxH / 2, border_color=color.new(baseC, 0), border_width=1, bgcolor=color.new(baseC, fillT)))

    // ═══════════════════════════════════════════════════════════════════════
    //  CONFLUENCE ENGINE v2
    //  score = somma sulle famiglie di (pesi ordinati x decay^rango).
    //  Fra famiglie i pesi si sommano pieni (fonti indipendenti); dentro una
    //  famiglia decadono, perche' sono misure correlate della stessa cosa.
    // ═══════════════════════════════════════════════════════════════════════
    for b in confluenceBoxes
        box.delete(b)
    array.clear(confluenceBoxes)
    for lbl in confluenceLabels
        label.delete(lbl)
    array.clear(confluenceLabels)

    if showConfluence
        float band = confBandPts / 2.0

        // Il drift e' l'errore sistematico fra livelli GEX e livelli nativi del
        // grafico: e' esattamente cio' che falsa le confluenze cross-family.
        if (confFixBasis or spaceNDX) and (gexDriftBad or math.abs(gexDrift) > band)
            string dTxt = na(dRaw) ? "BASIS NON MISURABILE: strike NDX su grafico NQ senza basis. Imposta 'Basis manuale'." : gexDriftBad and spaceNDX ? "BASIS IMPLAUSIBILE " + str.tostring(dRaw, "#.#") + " pt: il carry NQ-NDX e' positivo di qualche decina di punti. Stai misurando un artefatto (feed in ritardo o mercato chiuso)." : gexDriftBad ? "BASIS DRIFT " + str.tostring(dRaw, "#.#") + " pt - FUORI SOGLIA: dato vecchio o roll in corso" : "basis applicato " + str.tostring(gexDrift, "+#.#") + " pt"
            array.push(confluenceLabels, label.new(bar_index + profileOffset, close, dTxt, color=color.new(gexDriftBad ? color.red : color.orange, 15), textcolor=color.white, style=label.style_label_left, size=size.small))

        array<float>  cPx  = array.new<float>()
        array<float>  cW   = array.new<float>()
        array<int>    cFam = array.new<int>()   // 0 libro opzioni · 1 PriceAction · 2 BOS · 3 VWAP · 4 Esterni · 5 Volume flow
        array<string> cNm  = array.new<string>()

        if levelsData != "" and not qqqNoRatio
            array<string> lp = str.split(levelsData, ";")
            float magRef = 0.0
            for one in lp
                array<string> pm = str.split(one, ",")
                if array.size(pm) >= 5
                    float m = str.tonumber(array.get(pm, 4))
                    if not na(m)
                        magRef := math.max(magRef, m)
            for one in lp
                array<string> pp2 = str.split(one, ",")
                if array.size(pp2) >= 3
                    float s = str.tonumber(array.get(pp2, 0))
                    string t = array.get(pp2, 1)
                    if not na(s)
                        float mag = array.size(pp2) >= 5 ? nz(str.tonumber(array.get(pp2, 4))) : 0.0
                        // un muro da 190M non e' un muro da 12M: 0.5x - 2.0x
                        float wMul = magRef > 0 and mag > 0 ? 0.5 + 1.5 * math.min(mag / magRef, 1.0) : 1.0
                        bool tOI  = t == "OC" or t == "OP" or t == "OA"
                        bool tDEX = t == "DP" or t == "DN"
                        bool tVOL = t == "VC" or t == "VP"
                        float w = t == "ZG" ? wZG : t == "MP" ? wMP : t == "EH" or t == "EL" ? wEM : t == "VH" or t == "VL" ? wVB : t == "CM" or t == "DF" ? wCMDF : t == "AG" ? wAG : tDEX ? wDEX : tOI ? wOI : tVOL ? wVOL : t == "CW" or t == "PW" ? wWall * wMul : 0.0
                        // AbsGEX, DEX e OI restano nella famiglia del libro opzioni:
                        // condividono il fattore OI con il net GEX, quindi sono misure
                        // correlate e il decadimento intra-famiglia le tratta come tali.
                        // Il volume di sessione e' l'unico strato indipendente: guarda a
                        // oggi, non all'OI di ieri.
                        int famT = tVOL ? 5 : 0
                        if t == "ZG"
                            zgLevel := f_convertPrice(s)
                        if w > 0
                            string nm = t + " " + str.tostring(math.round(s)) + (mag > 0 ? "  " + str.tostring(mag, "#.#") + "M" : "")
                            f_pushLvl(cPx, cW, cFam, cNm, f_convertPrice(s), w, famT, nm)

        if showStructureLevels
            f_pushLvl(cPx, cW, cFam, cNm, dPrevH, wPDay, 1, "PDH")
            f_pushLvl(cPx, cW, cFam, cNm, dPrevL, wPDay, 1, "PDL")
            f_pushLvl(cPx, cW, cFam, cNm, wPrevH, wPWk,  1, "PWH")
            f_pushLvl(cPx, cW, cFam, cNm, wPrevL, wPWk,  1, "PWL")

        if array.size(bosLevels) > 0
            for bi = 0 to array.size(bosLevels) - 1
                string tf = array.size(bosTF) > bi ? array.get(bosTF, bi) : ""
                float wb = tf == "M" ? wBosM : tf == "W" ? wBosW : tf == "D" ? wBosD : wBosI
                f_pushLvl(cPx, cW, cFam, cNm, array.get(bosLevels, bi), wb, 2, "BOS " + tf)

        // Esterni: gia' in scala grafico (li plotta un indicatore sullo stesso
        // chart), quindi nessuna conversione e nessun drift da applicare.
        int extFam = extFamilyMode == "Famiglia indipendente" ? 4 : 0
        f_pushLvl(cPx, cW, cFam, cNm, ext1w > 0 ? ext1s : na, ext1w, extFam, ext1n)
        f_pushLvl(cPx, cW, cFam, cNm, ext2w > 0 ? ext2s : na, ext2w, extFam, ext2n)
        f_pushLvl(cPx, cW, cFam, cNm, ext3w > 0 ? ext3s : na, ext3w, extFam, ext3n)
        f_pushLvl(cPx, cW, cFam, cNm, ext4w > 0 ? ext4s : na, ext4w, extFam, ext4n)
        f_pushLvl(cPx, cW, cFam, cNm, ext5w > 0 ? ext5s : na, ext5w, extFam, ext5n)
        f_pushLvl(cPx, cW, cFam, cNm, ext6w > 0 ? ext6s : na, ext6w, extFam, ext6n)

        f_pushLvl(cPx, cW, cFam, cNm, pUS,   wVwUS, 3, "VWAP US")
        f_pushLvl(cPx, cW, cFam, cNm, pPD,   wVwUS, 3, "VWAP US PD")
        f_pushLvl(cPx, cW, cFam, cNm, pEU,   wVwEA, 3, "VWAP EU")
        f_pushLvl(cPx, cW, cFam, cNm, pAsia, wVwEA, 3, "VWAP Asia")

        // De-duplica intra-famiglia. Strike QQQ arrotondati a 10 punti e strike
        // NDX su griglia 25 creano quasi-coincidenze che sono aritmetica di
        // griglia, non informazione. Le coppie cross-family non si collassano
        // mai: sono il segnale.
        if confQuantum > 0
            int di = array.size(cPx) - 1
            while di > 0
                bool drop = false
                int dj = 0
                while dj < di and not drop
                    if array.get(cFam, dj) == array.get(cFam, di) and math.abs(array.get(cPx, dj) - array.get(cPx, di)) < confQuantum
                        if array.get(cW, di) > array.get(cW, dj)
                            array.set(cW,  dj, array.get(cW,  di))
                            array.set(cPx, dj, array.get(cPx, di))
                            array.set(cNm, dj, array.get(cNm, di))
                        drop := true
                    dj += 1
                if drop
                    array.remove(cPx, di)
                    array.remove(cW, di)
                    array.remove(cFam, di)
                    array.remove(cNm, di)
                di -= 1

        int nL = array.size(cPx)

        array<float> zScore = array.new<float>()
        array<float> zCen   = array.new<float>()
        array<float> zLo    = array.new<float>()
        array<float> zHi    = array.new<float>()
        array<int>   zFams  = array.new<int>()

        if nL > 0
            for i = 0 to nL - 1
                float ctr = array.get(cPx, i)
                float wsum = 0.0
                float pwsum = 0.0
                float lo = na
                float hi = na
                int famMask = 0
                float total = 0.0
                for f = 0 to 5
                    array<float> fw = array.new<float>()
                    for j = 0 to nL - 1
                        if array.get(cFam, j) == f and math.abs(array.get(cPx, j) - ctr) <= band
                            array.push(fw, array.get(cW, j))
                            float pj = array.get(cPx, j)
                            wsum  += array.get(cW, j)
                            pwsum += array.get(cW, j) * pj
                            lo := na(lo) ? pj : math.min(lo, pj)
                            hi := na(hi) ? pj : math.max(hi, pj)
                    if array.size(fw) > 0
                        famMask += int(math.pow(2, f))
                        total += f_famScore(fw, confDecay)
                array.push(zScore, total)
                array.push(zCen, wsum > 0 ? pwsum / wsum : ctr)
                array.push(zLo, na(lo) ? ctr : lo)
                array.push(zHi, na(hi) ? ctr : hi)
                array.push(zFams, famMask)

        // Non-max suppression: zone ordinate per score, mai sovrapposte.
        // Sostituisce il walk greedy, il cui esito dipendeva da dove iniziava.
        array<float> work = array.copy(zScore)
        array<float> accCen = array.new<float>()
        int drawn = 0
        int guard = 0
        while drawn < confMaxZones and guard < nL
            guard += 1
            int best = -1
            float bestS = -1000000.0
            for i = 0 to nL - 1
                if array.get(work, i) > bestS
                    bestS := array.get(work, i)
                    best := i
            if best < 0 or bestS < confMinScore
                break
            array.set(work, best, -1000000.0)
            int fm = array.get(zFams, best)
            int b0 = fm % 2
            int b1 = int(math.floor(fm / 2)) % 2
            int b2 = int(math.floor(fm / 4)) % 2
            int b3 = int(math.floor(fm / 8)) % 2
            int b4 = int(math.floor(fm / 16)) % 2
            int b5 = int(math.floor(fm / 32)) % 2
            int famCount = b0 + b1 + b2 + b3 + b4 + b5
            bool okCross = not confCrossOnly or famCount >= 2
            float cen = array.get(zCen, best)
            bool okSep = true
            if array.size(accCen) > 0
                for a = 0 to array.size(accCen) - 1
                    if math.abs(array.get(accCen, a) - cen) < confSepMult * confBandPts
                        okSep := false
            if okCross and okSep
                array.push(accCen, cen)
                drawn += 1
                float lo = array.get(zLo, best)
                float hi = array.get(zHi, best)
                if hi - lo < confBandPts * 0.25
                    lo := cen - confBandPts * 0.125
                    hi := cen + confBandPts * 0.125
                float scv = array.get(zScore, best)
                color zc = scv >= confMinScore * 2.4 ? colorConfluence5 : scv >= confMinScore * 1.6 ? colorConfluence4 : colorConfluence3
                array.push(confluenceBoxes, box.new(bar_index - lineLeftExt, hi, bar_index + profileOffset, lo, border_color=color.new(zc, 40), border_width=1, bgcolor=zc))
                string fams = (b0 == 1 ? "G" : "") + (b1 == 1 ? "P" : "") + (b2 == 1 ? "B" : "") + (b3 == 1 ? "V" : "") + (b4 == 1 ? "E" : "") + (b5 == 1 ? "F" : "")
                string tip = "Score " + str.tostring(scv, "#.##") + "   famiglie: " + fams + "\nDistanza: " + str.tostring(cen - close, "+#.#") + " pt\n"
                for j = 0 to nL - 1
                    if math.abs(array.get(cPx, j) - cen) <= band
                        tip += "\n" + array.get(cNm, j) + "   w " + str.tostring(array.get(cW, j), "#.##")
                array.push(confluenceLabels, label.new(bar_index + profileOffset, cen, str.tostring(scv, "#.#") + " " + fams, color=color.new(zc, 15), textcolor=color.white, style=label.style_label_left, size=size.small, tooltip=tip))

        zonesDrawn := drawn

    prevState := stateKey

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  PANNELLO DI STATO                                                           ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
//
// Tre fatti operativi in un posto solo: in che regime di gamma sei, quanto sono
// vecchi i dati, e se la geometria dei livelli e' affidabile. Sono le tre cose
// che invalidano tutto il resto quando vanno storte.

f_parseStamp(string st) =>
    float t = na
    if str.length(st) >= 16
        int y  = int(str.tonumber(str.substring(st, 0, 4)))
        int mo = int(str.tonumber(str.substring(st, 5, 7)))
        int d  = int(str.tonumber(str.substring(st, 8, 10)))
        int hh = int(str.tonumber(str.substring(st, 11, 13)))
        int mi = int(str.tonumber(str.substring(st, 14, 16)))
        if not na(y) and not na(mo) and not na(d) and not na(hh) and not na(mi)
            t := timestamp(syminfo.timezone, y, mo, d, hh, mi, 0)
    t

var table statusTbl = table.new(position.top_right, 2, 6, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50), border_color = color.new(color.gray, 70))

f_stCell(int r, int c, string txt, color col) =>
    table.cell(statusTbl, c, r, txt, text_color = col, text_size = size.small, text_halign = c == 0 ? text.align_left : text.align_right, bgcolor = color.new(#131722, 8))

if barstate.islast and showStatus
    // Regime: sopra lo Zero Gamma i dealer sono long gamma (hedging contro-trend,
    // vol compressa); sotto, short gamma (hedging pro-trend, vol espansa).
    // NON e' una direzione: e' un regime di volatilita'.
    bool haveZg = not na(zgLevel)
    bool longG  = haveZg and close > zgLevel
    color regCol = not haveZg ? color.gray : longG ? colorPos : colorNeg

    table.cell(statusTbl, 0, 0, "GEX STATUS", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#1e222d, 0))
    table.cell(statusTbl, 1, 0, not haveZg ? "n/d" : longG ? "LONG GAMMA" : "SHORT GAMMA", text_color=regCol, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(#1e222d, 0))

    f_stCell(1, 0, "Regime", color.new(color.gray, 10))
    f_stCell(1, 1, not haveZg ? "ZG assente" : (longG ? "vol compressa / range" : "vol espansa / trend"), regCol)

    f_stCell(2, 0, "Zero Gamma", color.new(color.gray, 10))
    f_stCell(2, 1, haveZg ? str.tostring(zgLevel, format.mintick) + "   " + str.tostring(close - zgLevel, "+#.#") + " pt" : "n/d", color.new(color.gray, 0))

    // Eta' del dato: l'OI si aggiorna a fine sessione, un profilo vecchio
    // descrive un book che non esiste piu'.
    float stampT = f_parseStamp(dataStamp)
    string ageTxt = "non impostata"
    color  ageCol = color.new(color.orange, 0)
    if not na(stampT)
        float ageH = (timenow - stampT) / 3600000.0
        if ageH < 0
            ageTxt := "data futura?"
        else
            ageTxt := str.tostring(math.floor(ageH), "#") + "h " + str.tostring(math.round((ageH - math.floor(ageH)) * 60), "#") + "m"
            ageCol := ageH > dataMaxAgeH ? colorNeg : ageH > dataMaxAgeH * 0.6 ? color.new(color.orange, 0) : colorPos
            if ageH > dataMaxAgeH
                ageTxt += "  RIGENERA"
    f_stCell(3, 0, "Eta' dati", color.new(color.gray, 10))
    f_stCell(3, 1, ageTxt, ageCol)

    f_stCell(4, 0, "Basis / zone", color.new(color.gray, 10))
    // Cosa e' attivo su questo timeframe e cosa no: meglio saperlo che dedurlo
    // dall'assenza di disegni.
    string tfTxt = (flipOnChart ? "flip su chart" : "flip su " + wallFlipTF) + (sessOK ? "" : "  sessioni OFF") + "  |  strike " + strikeSpaceMode
    f_stCell(5, 0, "Timeframe", color.new(color.gray, 10))
    f_stCell(5, 1, tfTxt, sessOK ? color.new(color.gray, 0) : color.new(color.orange, 0))

    string bsrc = confBasisManual != 0.0 ? " man" : ""
    f_stCell(4, 1, (gexDriftBad ? "ROLL!" : str.tostring(gexDrift, "+#.#") + " pt" + bsrc) + "   " + str.tostring(zonesDrawn, "#") + " zone", gexDriftBad ? colorNeg : color.new(color.gray, 0))

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ALERTS                                                                      ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

if enableAlerts and array.size(bosLevels) > 0
    for i = 0 to array.size(bosLevels) - 1
        float price = array.get(bosLevels, i)
        string tf = array.get(bosTF, i)
        bool touched = high >= price and low <= price
        bool crossUp = touched and close >= price and (open < price or low < price)
        bool crossDown = touched and close <= price and (open > price or high > price)
        if crossUp or crossDown
            string dir = crossUp ? "UP" : "DOWN"
            alert("TLADe BOS " + tf + " " + dir + " " + str.tostring(price, format.mintick), alert.freq_once_per_bar)
