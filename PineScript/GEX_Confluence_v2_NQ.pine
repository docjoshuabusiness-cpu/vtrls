//@version=6
// GEX Levels + Breakout Structure + Session AVWAP — NQ/NDX/QQQ
// Confluence Engine v2: livelli pesati, de-duplicati e cross-family,
// con correzione live del drift di basis sui livelli GEX.
// Vedi PineScript/README_Confluence_v2.md per il modello.
indicator("GEX Levels + BOS + AVWAP + Confluence v2 — NQ/NDX/QQQ", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  INPUTS                                                                      ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

groupTicker = "Ticker Settings"
tickerChoice = input.string("NQ", "Display Ticker", options=["NQ", "NDX", "QQQ"], group=groupTicker)
var float nqNdxSpread = 40.0
var float ndxQqqRatio = 40.0
var bool  ndxQqqRatioLoaded = false
// Correzione live del basis: gli strike arrivano in spazio NQ con il basis
// congelato al momento dello snapshot (campo S:). Applicata a TUTTI i livelli
// GEX, cosi' linee, profilo e zone di confluenza restano allineati fra loro.
var float zgLevel     = na    // Zero Gamma in scala grafico: pivot di regime
var int   zonesDrawn  = 0
var float gexDrift    = 0.0
var float gexBasisUse = 40.0
var bool  gexDriftBad = false

groupGex = "GEX Data"
string WEEKLY_DATA = input.text_area("S:178.00|R:41.094|L:28932,ZG,ZERO GAMMA,Zero Gamma~Key pivot where dealer gamma flips~Price magnet,0;29068,MP,MAX PAIN,Max Pain~Strike with maximum option pain~Expiry target,0;29018,EH,EM HIGH,Expected Move HIGH~1-sigma upper boundary~Statistical resistance,0;28546,EL,EM LOW,Expected Move LOW~1-sigma lower boundary~Statistical support,0;29049,VH,VOL HIGH,Vol Band HIGH~Volatility-based resistance~ZG + 25% EM,0;28814,VL,VOL LOW,Vol Band LOW~Volatility-based support~ZG - 25% EM,0;29268,CW,Call Wall,Strike: 29268~From Spot: +0.30%~Tot GEX: 189.75M~C/P Ratio: 61.6~Hold: 80% | Break: 20%,189.8;29568,CW,Call Wall,Strike: 29568~From Spot: +1.33%~Tot GEX: 124.51M~Hold: 80% | Break: 20%,124.5;29428,CW,Call Wall,Strike: 29428~From Spot: +0.85%~Tot GEX: 73.46M~C/P Ratio: 6.1~Hold: 80% | Break: 20%,73.5;29578,CW,Call Wall,Strike: 29578~From Spot: +1.37%~Tot GEX: 53.78M~C/P Ratio: 4.6~Hold: 80% | Break: 20%,53.8;29378,CW,Call Wall,Strike: 29378~From Spot: +0.68%~Tot GEX: 42.90M~C/P Ratio: 1.5~Hold: 80% | Break: 20%,42.9;29278,CW,Call Wall,Strike: 29278~From Spot: +0.34%~Tot GEX: 31.77M~C/P Ratio: 3.2~Hold: 80% | Break: 20%,31.8;29478,CW,Call Wall,Strike: 29478~From Spot: +1.02%~Tot GEX: 29.04M~C/P Ratio: 7.1~Hold: 66% | Break: 34%,29.0;29228,CW,Call Wall,Strike: 29228~From Spot: +0.17%~Tot GEX: 27.22M~C/P Ratio: 1.6~Hold: 73% | Break: 27%,27.2;29448,CW,Call Wall,Strike: 29448~From Spot: +0.92%~Tot GEX: 26.93M~Hold: 66% | Break: 34%,26.9;29328,CW,Call Wall,Strike: 29328~From Spot: +0.51%~Tot GEX: 25.91M~C/P Ratio: 2.3~Hold: 71% | Break: 29%,25.9;29518,CW,Call Wall,Strike: 29518~From Spot: +1.16%~Tot GEX: 23.58M~C/P Ratio: 4.0~Hold: 66% | Break: 34%,23.6;29248,CW,Call Wall,Strike: 29248~From Spot: +0.24%~Tot GEX: 23.05M~C/P Ratio: 2.8~Hold: 59% | Break: 41%,23.1;29438,CW,Call Wall,Strike: 29438~From Spot: +0.89%~Tot GEX: 21.11M~C/P Ratio: 27.7~Hold: 51% | Break: 49%,21.1;29608,CW,Call Wall,Strike: 29608~From Spot: +1.47%~Tot GEX: 20.59M~Hold: 4