     options=["Candele della sezione","Barre del grafico"], group=g7)
preAuto = input.bool(true, "   finestra minima automatica (2 candele della sezione)", group=g7)
pre1 = input.bool(false, "S1", inline="p1", group=g7)
preL1= input.int(12, "mem", minval=1, maxval=5000, inline="p1", group=g7)
preT1= input.float(100, "|CCI|", minval=5, maxval=600, step=5, inline="p1", group=g7)
