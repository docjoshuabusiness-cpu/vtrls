//@version=5
// =============================================================================
// ASM v2.1 - Adaptive Statistical Momentum
// Riscrittura di "ASM - Signals + Trend (Clean)".
// Correzioni v2 rispetto alla v1:
//   1. Z-score con varianza stimata su finestra lunga e scalata con sqrt(n)
//      -> niente piu' stima di sigma su finestre sovrapposte.
//   2. Regime trend/range via Variance Ratio (Lo-MacKinlay) con z-stat, al posto
//      di slope-vs-stdev-dei-prezzi (che si auto-sopprimeva in trend).
//   3. Normalizzazione singola (log-return / sigma), scala robusta opzionale MAD.
//   4. Nessun repaint: emissione solo su barra confermata.
//   5. Accelerazione normalizzata per ATR e DISATTIVABILE (switch di ablation).
//   6. Ri-standardizzazione dopo lo smoothing -> soglia in sigma reali.
//   7. Segnali di trend edge-triggered (evento, non stato).
//   8. Debounce unico e simmetrico su long/short.
// Aggiunte v2.1 (uso su timeframe molto bassi, es. NQ 5s):
//   9. FUNNEL DIAGNOSTICO: conta dove muoiono i segnali, gate per gate.
//  10. Variance Ratio con intervallo base configurabile -> neutralizza il
//      bid-ask bounce che a 5s distorce sistematicamente VR verso il basso.
//  11. Floor sulla sigma (in tick) -> niente z esplosivi nelle fasi morte.
//  12. Modalita' di ingresso: "anticipato" (primo tick di rientro) o
//      "confermato" (cross della soglia).
// =============================================================================
indicator("ASM v2.1 - Adaptive Statistical Momentum", overlay = true, max_labels_count = 500)

// ============================ INPUT: MOMENTUM ================================
gM = "1 - Momentum / Z-Score"
baseLen     = input.int (14,   "Orizzonte base (barre)",              minval = 2,  group = gM)
useVolClock = input.bool(true, "Orizzonte adattivo (vol clock)",                   group = gM)
lenMin      = input.int (5,    "Orizzonte minimo",                    minval = 2,  group = gM)
lenMax      = input.int (40,   "Orizzonte massimo",                   minval = 3,  group = gM)
atrLen      = input.int (14,   "ATR length",                          minval = 2,  group = gM)
volLen      = input.int (250,  "Finestra stima volatilita' (barre)",  minval = 50, group = gM)
robustVol   = input.bool(true, "Scala robusta (MAD) invece di stdev",              group = gM)
sigFloorK   = input.float(0.5, "Floor sigma (x tick/prezzo)", minval = 0, step = 0.1, group = gM)
smoothLen   = input.int (3,    "Smoothing z (EMA, 1 = off)",          minval = 1,  group = gM)
reStd       = input.bool(true, "Ri-standardizza dopo smoothing",                   group = gM)

// ============================ INPUT: SOGLIE ==================================
gT = "2 - Soglie"
thrMode  = input.string("Percentile adattivo", "Modalita' soglia", options = ["Sigma fisso", "Percentile adattivo"], group = gT)
thrFixed = input.float (2.0, "Soglia in sigma",           minval = 0.5, step = 0.1, group = gT)
thrPct   = input.float (85,  "Percentile |z| (%)",        minval = 50, maxval = 99.5, step = 0.5, group = gT)
pctLen   = input.int   (300, "Finestra percentile",       minval = 100, group = gT)
trendZ   = input.float (1.0, "Soglia z per ingresso trend", step = 0.1, group = gT)

// ============================ INPUT: REGIME ==================================
gR = "3 - Regime (Variance Ratio)"
vrBase = input.int  (1,   "Intervallo base b (barre)",  minval = 1,  group = gR, tooltip = "Su TF molto bassi alzalo (es. 6 su 5s = 30s) per togliere il bid-ask bounce")
vrQ    = input.int  (5,   "Orizzonte q del VR",         minval = 2,  group = gR)
vrLen  = input.int  (120, "Finestra N del VR",          minval = 30, group = gR)
vrThr  = input.float(1.00,"Soglia |z| del VR (1.0=68%, 1.65=90%, 1.96=95%)", step = 0.05, group = gR)

// ============================ INPUT: FILTRI ==================================
gF = "4 - Filtri (ablation)"
useAccel    = input.bool(false, "Usa filtro accelerazione",           group = gF)
accSmooth   = input.int (3,     "Smoothing accelerazione", minval = 1, group = gF)
useTrendSig = input.bool(true,  "Mostra segnali di trend",            group = gF)
useMrSig    = input.bool(true,  "Mostra segnali mean-reversion",      group = gF)

// ============================ INPUT: ESECUZIONE ==============================
gE = "5 - Esecuzione"
entryMode   = input.string("Anticipato", "Modalita' ingresso MR", options = ["Anticipato", "Confermato"], group = gE, tooltip = "Anticipato: primo tick di rientro mentre z e' ancora estremo. Confermato: z riattraversa la soglia.")
confirmOnly = input.bool(true, "Solo barre confermate (no repaint)",  group = gE)
minGap      = input.int (10,   "Barre minime tra segnali", minval = 0, group = gE)
tintRegime  = input.bool(true, "Colora sfondo per regime",           group = gE)

// ============================ INPUT: DIAGNOSTICA =============================
gD = "6 - Diagnostica"
showTable = input.bool(true, "Pannello stato",   group = gD)
showDiag  = input.bool(true, "Funnel diagnostico (dove muoiono i segnali)", group = gD)

// =============================================================================
// 1. SCALA DELLA VOLATILITA' (stimata una sola volta, su finestra lunga)
// =============================================================================
r = math.log(close / nz(close[1], close))

muR   = ta.sma(r, volLen)
sdStd = ta.stdev(r, volLen)
medR  = ta.median(r, volLen)
sdMad = 1.4826 * ta.median(math.abs(r - medR), volLen)

// Floor: nelle fasi morte (molti close identici) MAD -> 0 e lo z esplode.
sigFloor = sigFloorK * syminfo.mintick / close
sigma1   = math.max(robustVol ? sdMad : sdStd, sigFloor)
centerR  = robustVol ? medR : muR

// =============================================================================
// 2. ORIZZONTE ADATTIVO (vol clock: alta vol -> finestra corta)
// =============================================================================
atr    = ta.atr(atrLen)
atrAvg = ta.sma(atr, volLen)
ratio  = atr > 0 ? atrAvg / atr : 1.0
nRaw   = useVolClock ? baseLen * ratio : baseLen
nClamp = math.max(lenMin, math.min(lenMax, nRaw))
n      = bar_index < volLen ? baseLen : int(math.round(nClamp))

// =============================================================================
// 3. Z-SCORE
//    mom_n = log(P_t / P_{t-n});  sotto random walk: mom_n ~ N(n*mu, n*sigma^2)
//    => z = (mom_n - n*mu) / (sigma * sqrt(n))   -> unita' di sigma vere
// =============================================================================
mom   = math.log(close / nz(close[n], close))
denom = sigma1 * math.sqrt(n)
zRaw  = denom > 0 ? (mom - centerR * n) / denom : 0.0

zSm = smoothLen > 1 ? ta.ema(zRaw, smoothLen) : zRaw
sdZ = ta.stdev(zSm, volLen)
z   = reStd and sdZ > 0 ? zSm / sdZ : zSm   // lo smoothing comprime la varianza: la si riporta a 1

thrAdaptive = ta.percentile_linear_interpolation(math.abs(z), pctLen, thrPct)
thr         = thrMode == "Sigma fisso" ? thrFixed : nz(thrAdaptive, thrFixed)

// =============================================================================
// 4. REGIME: VARIANCE RATIO generalizzato su intervallo base b
//    VR(q) = Var(r_{q*b}) / (q * Var(r_b)).  VR>1 trend, VR<1 mean reversion.
//    Con b>1 si scavalca il bid-ask bounce, che a 5s rende VR(1) negativo
//    per pura microstruttura e non per vera mean reversion.
//    SE asintotico (RW omoschedastico, stimatore overlapping):
//      Var[VR-1] = 2*(2q-1)*(q-1) / (3*q*N)
// =============================================================================
rb   = math.log(close / nz(close[vrBase],       close))
rqb  = math.log(close / nz(close[vrQ * vrBase], close))
vb   = ta.variance(rb,  vrLen)
vqb  = ta.variance(rqb, vrLen)
vr   = vb > 0 ? vqb / (vrQ * vb) : 1.0
seVR = math.sqrt(2.0 * (2.0 * vrQ - 1.0) * (vrQ - 1.0) / (3.0 * vrQ * vrLen))
zVR  = seVR > 0 ? (vr - 1.0) / seVR : 0.0

warmup    = bar_index > math.max(math.max(volLen, vrLen), vrQ * vrBase) + 10
isTrend   = warmup and zVR >  vrThr
isMeanRev = warmup and zVR < -vrThr
isNoise   = warmup and not isTrend and not isMeanRev

// =============================================================================
// 5. FILTRO ACCELERAZIONE (normalizzato, opzionale)
// =============================================================================
accRaw = atr > 0 ? (close - 2 * nz(close[1], close) + nz(close[2], close)) / atr : 0.0
acc    = accSmooth > 1 ? ta.ema(accRaw, accSmooth) : accRaw
accLongOK  = not useAccel or acc > 0
accShortOK = not useAccel or acc < 0

// =============================================================================
// 6. SEGNALI
// =============================================================================
mrLongCore  = entryMode == "Confermato" ? ta.crossover (z, -thr) : (z < -thr and z > z[1])
mrShortCore = entryMode == "Confermato" ? ta.crossunder(z,  thr) : (z >  thr and z < z[1])

mrLongRaw  = useMrSig and isMeanRev and mrLongCore  and accLongOK
mrShortRaw = useMrSig and isMeanRev and mrShortCore and accShortOK

// Trend: EVENTO di ingresso in stato (edge-triggered), non lo stato stesso
trUpState  = isTrend and z >  trendZ
trDnState  = isTrend and z < -trendZ
trLongRaw  = useTrendSig and trUpState and not trUpState[1]
trShortRaw = useTrendSig and trDnState and not trDnState[1]

longRaw  = mrLongRaw  or trLongRaw
shortRaw = mrShortRaw or trShortRaw

// Debounce unico e simmetrico (blocca anche il segnale opposto)
var int lastSigBar = na
gapOK = na(lastSigBar) or (bar_index - lastSigBar >= minGap)
barOK = not confirmOnly or barstate.isconfirmed

longSig  = longRaw  and gapOK and barOK
shortSig = shortRaw and gapOK and barOK and not longSig

if longSig or shortSig
    lastSigBar := bar_index

// =============================================================================
// 7. HALF-LIFE (AR(1) su z) -> orizzonte di holding stimato, non inventato
//    z_t = phi * z_{t-1}  =>  HL = ln(0.5) / ln(phi)
// =============================================================================
phi      = ta.correlation(z, z[1], volLen)
halfLife = phi > 0 and phi < 1 ? math.log(0.5) / math.log(phi) : na

// =============================================================================
// 8. FUNNEL DIAGNOSTICO
//    Conta, gate per gate, quante barre passano. Se i segnali sono pochi,
//    qui si vede QUALE condizione li sta uccidendo.
// =============================================================================
var int cBars  = 0
var int cTrend = 0
var int cMR    = 0
var int cExt   = 0
var int cCore  = 0
var int cRaw   = 0
var int cSig   = 0

if warmup and barstate.isconfirmed
    cBars  += 1
    cTrend += isTrend   ? 1 : 0
    cMR    += isMeanRev ? 1 : 0
    cExt   += math.abs(z) > thr ? 1 : 0
    cCore  += (mrLongCore or mrShortCore) ? 1 : 0
    cRaw   += (longRaw or shortRaw) ? 1 : 0
    cSig   += (longSig or shortSig) ? 1 : 0

pct(x) => cBars > 0 ? 100.0 * x / cBars : 0.0

// =============================================================================
// 9. OUTPUT
// =============================================================================
plotshape(longSig  and mrLongRaw,  title = "Long MR",     location = location.belowbar, color = color.new(color.green,  0), style = shape.triangleup,   size = size.small)
plotshape(shortSig and mrShortRaw, title = "Short MR",    location = location.abovebar, color = color.new(color.red,    0), style = shape.triangledown, size = size.small)
plotshape(longSig  and trLongRaw,  title = "Long Trend",  location = location.belowbar, color = color.new(color.lime,   0), style = shape.labelup,      size = size.tiny)
plotshape(shortSig and trShortRaw, title = "Short Trend", location = location.abovebar, color = color.new(color.maroon, 0), style = shape.labeldown,    size = size.tiny)

bgcolor(tintRegime and isTrend ? color.new(color.blue, 93) : tintRegime and isMeanRev ? color.new(color.orange, 93) : na, title = "Regime")

// -- Pannello stato
var table tb = table.new(position.top_right, 2, 6, border_width = 1)
if showTable and barstate.islast
    regimeTxt = isTrend ? "TREND" : isMeanRev ? "MEAN REV" : "NEUTRO"
    table.cell(tb, 0, 0, "Regime",      text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 0, regimeTxt,     text_color = isTrend ? color.blue : isMeanRev ? color.orange : color.gray, text_size = size.small)
    table.cell(tb, 0, 1, "z(VR)",       text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(zVR, "#.00"), text_size = size.small)
    table.cell(tb, 0, 2, "z",           text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(z, "#.00"),   text_size = size.small)
    table.cell(tb, 0, 3, "soglia",      text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(thr, "#.00"), text_size = size.small)
    table.cell(tb, 0, 4, "orizzonte n", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(n), text_size = size.small)
    table.cell(tb, 0, 5, "half-life",   text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 5, na(halfLife) ? "n/d" : str.tostring(halfLife, "#.0") + " bar", text_size = size.small)

// -- Funnel: dove muoiono i segnali
var table td = table.new(position.bottom_right, 3, 8, border_width = 1)
if showDiag and barstate.islast
    table.cell(td, 0, 0, "FUNNEL",  text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.small)
    table.cell(td, 1, 0, "n",       text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.small)
    table.cell(td, 2, 0, "%",       text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.small)

    table.cell(td, 0, 1, "barre valide", text_size = size.small, text_color = color.gray)
    table.cell(td, 1, 1, str.tostring(cBars), text_size = size.small)
    table.cell(td, 2, 1, "100", text_size = size.small)

    table.cell(td, 0, 2, "regime TREND",  text_size = size.small, text_color = color.gray)
    table.cell(td, 1, 2, str.tostring(cTrend), text_size = size.small)
    table.cell(td, 2, 2, str.tostring(pct(cTrend), "#.0"), text_size = size.small)

    table.cell(td, 0, 3, "regime MEAN REV", text_size = size.small, text_color = color.gray)
    table.cell(td, 1, 3, str.tostring(cMR), text_size = size.small)
    table.cell(td, 2, 3, str.tostring(pct(cMR), "#.0"), text_size = size.small)

    table.cell(td, 0, 4, "|z| > soglia",  text_size = size.small, text_color = color.gray)
    table.cell(td, 1, 4, str.tostring(cExt), text_size = size.small)
    table.cell(td, 2, 4, str.tostring(pct(cExt), "#.0"), text_size = size.small)

    table.cell(td, 0, 5, "trigger MR grezzo", text_size = size.small, text_color = color.gray)
    table.cell(td, 1, 5, str.tostring(cCore), text_size = size.small)
    table.cell(td, 2, 5, str.tostring(pct(cCore), "#.0"), text_size = size.small)

    table.cell(td, 0, 6, "segnali pre-debounce", text_size = size.small, text_color = color.gray)
    table.cell(td, 1, 6, str.tostring(cRaw), text_size = size.small)
    table.cell(td, 2, 6, str.tostring(pct(cRaw), "#.00"), text_size = size.small)

    table.cell(td, 0, 7, "SEGNALI EMESSI", text_size = size.small, text_color = color.white, bgcolor = color.new(color.teal, 60))
    table.cell(td, 1, 7, str.tostring(cSig), text_size = size.small, text_color = color.white, bgcolor = color.new(color.teal, 60))
    table.cell(td, 2, 7, str.tostring(pct(cSig), "#.00"), text_size = size.small, text_color = color.white, bgcolor = color.new(color.teal, 60))

alertcondition(longSig,  title = "ASM Long",  message = "ASM v2.1 LONG {{ticker}} {{interval}}")
alertcondition(shortSig, title = "ASM Short", message = "ASM v2.1 SHORT {{ticker}} {{interval}}")
